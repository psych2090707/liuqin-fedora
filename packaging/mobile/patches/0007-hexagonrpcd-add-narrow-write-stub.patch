+		fprintf(stderr, "stub: closing write-only fd %u (discarded)\n",
+			*first_in);
+		return 0;
+	}
+
 	ret = hexagonfs_close(ctx->fds, *first_in);
 	if (ret) {
 		fprintf(stderr, "Could not close: %s\n", strerror(-ret));
@@ -101,6 +115,12 @@ static uint32_t apps_std_fread(void *data,
 	} *first_out = outbufs[0].p;
 	ssize_t ret;
 
+	if (first_in->fd == APPS_STD_STUB_FD) {
+		first_out->written = 0;
+		first_out->is_eof = 1;
+		return 0;
+	}
+
 	ret = hexagonfs_read(ctx->fds, first_in->fd,
 			     first_in->buf_size, outbufs[1].p);
 	if (ret < 0) {
@@ -120,6 +140,96 @@ static uint32_t apps_std_fread(void *data,
 	return 0;
 }
 
+/*
+ * Stub write: accept and discard the DSP's registry temp data.  The DSP only
+ * needs the call to succeed during initialization; the host-side registry is
+ * deliberately left untouched.
+ */
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+
+	if (first_in->fd != APPS_STD_STUB_FD) {
+		fprintf(stderr, "stub: refusing write to fd %u\n", first_in->fd);
+		return AEE_EFAILED;
+	}
+
+	fprintf(stderr, "stub: accepting %u bytes for write-only fd %u (discarded)\n",
+		first_in->buf_size, first_in->fd);
+	first_out->written = first_in->buf_size;
+	first_out->is_eof = 0;
+
+	return 0;
+}
+
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	const char *path = inbufs[1].p;
+
+	if (inbufs[1].s == 0 || path[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	fprintf(stderr, "stub: accepting remove of %s (ignored)\n", path);
+	return 0;
+}
+
+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	const char *oldpath = inbufs[1].p;
+	const char *newpath = inbufs[2].p;
+
+	if (inbufs[1].s == 0 || oldpath[inbufs[1].s - 1] != 0
+	 || inbufs[2].s == 0 || newpath[inbufs[2].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	fprintf(stderr, "stub: accepting rename %s -> %s (ignored)\n",
+		oldpath, newpath);
+	return 0;
+}
+
+static uint32_t apps_std_fclose_fd(void *data,
+				   const struct fastrpc_io_buffer *inbufs,
+				   struct fastrpc_io_buffer *outbufs)
+{
+	return 0;
+}
+
+static uint32_t apps_std_fopen_with_env_fd(void *data,
+					   const struct fastrpc_io_buffer *inbufs,
+					   struct fastrpc_io_buffer *outbufs)
+{
+	struct {
+		uint32_t fd;
+		uint32_t len;
+	} *first_out = outbufs[0].p;
+
+	if (inbufs[1].s == 0 || ((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
+	 || inbufs[2].s == 0 || ((const char *) inbufs[2].p)[inbufs[2].s - 1] != 0
+	 || inbufs[3].s == 0 || ((const char *) inbufs[3].p)[inbufs[3].s - 1] != 0
+	 || inbufs[4].s == 0 || ((const char *) inbufs[4].p)[inbufs[4].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	fprintf(stderr, "stub: fopen_with_env_fd %s -> fake fd %d\n",
+		(const char *) inbufs[3].p, APPS_STD_STUB_FD);
+	first_out->fd = APPS_STD_STUB_FD;
+	first_out->len = 42;
+
+	return 0;
+}
+
 static uint32_t apps_std_fseek(void *data,
 			       const struct fastrpc_io_buffer *inbufs,
 			       struct fastrpc_io_buffer *outbufs)
@@ -133,6 +243,9 @@ static uint32_t apps_std_fseek(void *data,
 	int ret;
