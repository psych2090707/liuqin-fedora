+/*
+ * Minimal write stub for the liuqin sensors DSP.  The DSP opens registry
+ * temp files for writing during initialization.  The real HexagonFS is
+ * read-only, so answer those writes with a single in-memory/discard fd and
+ * report success; no file is created or modified on the host.
+ */
+#define APPS_STD_STUB_FD 99
+
 static const int apps_std_whence_table[] = {
 	SEEK_SET,
 	SEEK_CUR,
@@ -73,6 +81,12 @@ static uint32_t apps_std_fclose(void *data,
