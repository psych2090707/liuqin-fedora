+/* liuqin: the kernel switches VTs around system suspend, so for a moment
+ * after resume logind reports the local seat session, and the user, as
+ * "online" instead of "active". polkit's allow_active verify policy denies
+ * requests that arrive in that window, and the KDE lock screen then disables
+ * its fingerprint authenticator until it is restarted. For the verify action
+ * only, while the caller's display session is reported online (or for a
+ * short settle time once active), ask polkit again for a bounded time. The
+ * policy and the final polkit answer are unchanged. */
+#define LIUQIN_TRANSIENT_WAIT_MS 5000
+#define LIUQIN_TRANSIENT_STEP_MS 100
+#define LIUQIN_TRANSIENT_SETTLE_MS 1000
+
+static gboolean
+liuqin_caller_uid (GDBusMethodInvocation *invocation,
+                   guint32               *uid)
+{
+  g_autoptr(GVariant) ret = NULL;
+
+  ret = g_dbus_connection_call_sync (g_dbus_method_invocation_get_connection (invocation),
+                                     "org.freedesktop.DBus",
+                                     "/org/freedesktop/DBus",
+                                     "org.freedesktop.DBus",
+                                     "GetConnectionUnixUser",
+                                     g_variant_new ("(s)", g_dbus_method_invocation_get_sender (invocation)),
+                                     G_VARIANT_TYPE ("(u)"),
+                                     G_DBUS_CALL_FLAGS_NONE, 1000, NULL, NULL);
+  if (ret == NULL)
+    return FALSE;
+
+  g_variant_get (ret, "(u)", uid);
+  return TRUE;
+}
+
+typedef enum {
+  LIUQIN_DISPLAY_NONE,
+  LIUQIN_DISPLAY_ONLINE,
+  LIUQIN_DISPLAY_ACTIVE,
+} LiuqinDisplayState;
+
+static LiuqinDisplayState
+liuqin_display_session_state (GDBusConnection *connection,
+                              guint32          uid)
+{
+  g_autoptr(GVariant) user = NULL;
+  g_autoptr(GVariant) props = NULL;
+  g_autoptr(GVariant) dict = NULL;
+  g_autoptr(GVariant) display = NULL;
+  const char *path = NULL;
+  const char *state = NULL;
+  const char *display_path = NULL;
+
+  user = g_dbus_connection_call_sync (connection,
+                                      "org.freedesktop.login1",
+                                      "/org/freedesktop/login1",
+                                      "org.freedesktop.login1.Manager",
+                                      "GetUser",
+                                      g_variant_new ("(u)", uid),
+                                      G_VARIANT_TYPE ("(o)"),
+                                      G_DBUS_CALL_FLAGS_NONE, 1000, NULL, NULL);
+  if (user == NULL)
+    return LIUQIN_DISPLAY_NONE;
+  g_variant_get (user, "(&o)", &path);
+
+  props = g_dbus_connection_call_sync (connection,
+                                       "org.freedesktop.login1",
+                                       path,
+                                       "org.freedesktop.DBus.Properties",
+                                       "GetAll",
+                                       g_variant_new ("(s)", "org.freedesktop.login1.User"),
+                                       G_VARIANT_TYPE ("(a{sv})"),
+                                       G_DBUS_CALL_FLAGS_NONE, 1000, NULL, NULL);
+  if (props == NULL)
+    return LIUQIN_DISPLAY_NONE;
+  dict = g_variant_get_child_value (props, 0);
+
+  display = g_variant_lookup_value (dict, "Display", G_VARIANT_TYPE ("(so)"));
+  if (display == NULL)
+    return LIUQIN_DISPLAY_NONE;
+  g_variant_get (display, "(&s&o)", NULL, &display_path);
+  if (display_path == NULL || g_strcmp0 (display_path, "/") == 0)
+    return LIUQIN_DISPLAY_NONE;
+
+  if (!g_variant_lookup (dict, "State", "&s", &state))
+    return LIUQIN_DISPLAY_NONE;
+  if (g_strcmp0 (state, "online") == 0)
+    return LIUQIN_DISPLAY_ONLINE;
+  if (g_strcmp0 (state, "active") == 0)
+    return LIUQIN_DISPLAY_ACTIVE;
+  return LIUQIN_DISPLAY_NONE;
+}
