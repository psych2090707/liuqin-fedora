[Unit]
Description=Passive daily-use sample for liuqin
ConditionPathExists=/etc/liuqin-slpi-disabled

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /usr/libexec/liuqin/daily-log.py
TimeoutStartSec=10s
UMask=0077
StateDirectory=liuqin-daily-log
StateDirectoryMode=0700
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
StandardOutput=null
StandardError=journal
