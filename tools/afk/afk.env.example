# AFK channel — local configuration for tools/afk/*.
#
# Copy to tools/afk/afk.env (git-ignored) and edit.  Everything here can also be
# passed as an AFK_* environment variable.

# Device address on the USB NCM link (the initramfs gadget uses 192.168.7.2/24).
AFK_DEV_HOST=192.168.7.2
# Host address on the same link.
AFK_HOST_IP=192.168.7.10

# Device login.  Prefer the dedicated SSH key below; if password sudo is still
# needed, set your own value here.  There is no shared default password.
AFK_DEV_USER=user
AFK_DEV_PASS=

# USB interface name.  Empty/absent = auto-detect by the gadget's host MAC
# (02:00:00:00:07:01), falling back to whichever interface has 192.168.7.x.
# AFK_IFACE=enp0s20f0u2

# Local HTTP repo port (tools/afk/serve-repo.sh).
AFK_REPO_PORT=8080

# SSH key path (generated by tools/afk/keys/gen-keys.sh).
# AFK_SSH_KEY="$HOME/path/to/repo/tools/afk/keys/id_ed25519_afk"
