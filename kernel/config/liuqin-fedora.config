# kernel/config/liuqin-fedora.config
# SPDX-License-Identifier: MIT
#
# Fedora 发行版层 kconfig 补充片段（在 10 个上游产品 fragment 之后追加）。
#
# 背景：upstream/xiaomipad-6pro-mainline/device/configs/ 的 10 个 fragment 面向
# Ubuntu 26.04 + GNOME（含 snap/AppArmor 栈）。Fedora 默认使用 SELinux enforcing，
# 而上游基线内核没有启用 SELinux，LSM 顺序里也没有 selinux——直接拿上游 config
# 做 Fedora 内核会以 SELinux disabled 启动。
#
# 用法（不修改上游文件）:
#   scripts/build-kernel.sh --extra-fragment kernel/config/liuqin-fedora.config
#
# 审计证据（2026-10-20, GCC 16.2）：
#   out/kernel/config-audit.tsv 中 class=fedora 的各项在基线配置下为 MISSING；
#   追加本片段后全部 OK，device 类符号保持不变（见 docs/maintenance/kernel-build.md）。
#
# 注意：
#   - 片段注释里不要写 "CONFIG_XXX" 形式的符号名（merge_config.sh 的 grep -w
#     会把注释行当成该符号的取值，产生多行 New value 并污染合并结果）。
#   - 本片段只解决 Fedora 发行版必需的 LSM 组合，不改变 liuqin 设备驱动选择。

# --- 网络安全钩子与 path 钩子 ---
# AppArmor 在基线配置中 select 了这两个开关；Fedora 关闭 AppArmor 后必须显式
# 打开，否则 SELinux 的依赖（SECURITY_NETWORK）不满足而被 olddefconfig 丢弃。
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y

# --- SELinux（Fedora 默认策略） ---
CONFIG_SECURITY_SELINUX=y
# 允许通过内核命令行 selinux= 控制；Fedora 安装器/升级路径依赖该接口。
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
# 开发/排障模式：允许运行期切换 permissive；与 Fedora 官方内核行为一致。
CONFIG_SECURITY_SELINUX_DEVELOP=y

# 上游 snap fragment 把 AppArmor 设为主 LSM；Fedora 不用 AppArmor，
# 这里显式关闭以缩小内核并避免两套 LSM 策略语义混淆。
# CONFIG_SECURITY_APPARMOR is not set

# LSM 顺序采用 Fedora 官方内核写法：CONFIG_LSM 决定实际初始化顺序，
# 已废弃的 DEFAULT_SECURITY_* choice 在 CONFIG_LSM 存在时被忽略，这里同步设置
# 以保持人工审阅一致。
CONFIG_LSM="lockdown,yama,integrity,selinux,bpf"
CONFIG_DEFAULT_SECURITY_SELINUX=y
