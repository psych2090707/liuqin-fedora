# kernel/config/liuqin-zram.config
# SPDX-License-Identifier: MIT
#
# Compressed RAM swap. Fedora's default swap is a zram device created by
# zram-generator; the upstream product config has no zram and no swap at all,
# so every anonymous page stays resident and memory pressure turns into page
# cache thrashing (TN0068). Built as modules; the userspace side is the stock
# zram-generator package plus a drop-in.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
