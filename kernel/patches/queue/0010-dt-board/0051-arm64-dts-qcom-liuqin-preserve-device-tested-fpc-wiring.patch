From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Wed, 7 Oct 2026 11:27:42 +0800
Subject: [PATCH] arm64: dts: qcom: liuqin: preserve device-tested FPC wiring


diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
index 3be362d74..f552a29aa 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
@@ -606,6 +606,14 @@
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
+		/* FPC1264 VDD: retain the validated 2960000-3008000 uV HPM range. */
+		pm8350c_l9: ldo9 {
+			regulator-name = "pm8350c_l9";
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <3008000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		pm8350c_l10: ldo10 {
 			regulator-name = "pm8350c_l10";
 			regulator-min-microvolt = <1200000>;
@@ -1358,10 +1366,49 @@
 	};
 };
 
+/*
+ * Fingerprint sensor FPC1264 on chip select 0 of QUPv3 wrapper 1's
+ * third serial engine (spi10 / spi@a88000).
+ * Interrupt line is GPIO 40, reset line is GPIO 41, and power is fed from
+ * pm8350c_l9 (LDO9, strictly locked to 3.0 V, 2960000-3008000 uV).
+ */
+&spi10 {
+	status = "okay";
+	pinctrl-0 = <&qup_spi10_data_clk>, <&qup_spi10_cs>;
+	pinctrl-names = "default";
+
+	fingerprint@0 {
+		compatible = "fpc,fpc1020";
+		reg = <0>;
+		spi-max-frequency = <8000000>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <40 IRQ_TYPE_EDGE_RISING>;
+		reset-gpios = <&tlmm 41 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&pm8350c_l9>;
+		pinctrl-0 = <&fingerprint_irq>, <&fingerprint_rst>;
+		pinctrl-names = "default";
+	};
+};
+
 &tlmm {
-	gpio-reserved-ranges = <28 4>, <36 4>;
+	gpio-reserved-ranges = <28 4>;
 	status = "okay";
 
+	fingerprint_irq: fingerprint-irq-state {
+		pins = "gpio40";
+		function = "gpio";
+		bias-pull-down;
+		input-enable;
+	};
+
+	fingerprint_rst: fingerprint-rst-state {
+		pins = "gpio41";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+
 	cam_sensor_mclk2_active: cam-sensor-mclk2-active-state {
 		pins = "gpio102";
 		function = "cam_mclk";
