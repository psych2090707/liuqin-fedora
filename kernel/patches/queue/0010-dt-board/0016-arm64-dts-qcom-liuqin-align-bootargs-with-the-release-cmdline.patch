From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Tue, 15 Sep 2026 08:52:22 +0800
Subject: [PATCH] arm64: dts: qcom: liuqin: align bootargs with the release
 cmdline

Match device/native-bootargs.txt of the companion tooling repository:
panic=0 and qcom_q6v5_pas.slpi_auto_boot=0 (SLPI startup is owned by
the userspace sensor stack).

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
index 894f3b9c0..c86891a57 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
@@ -65,7 +65,7 @@
 		 * stdout-path is not used by either console -- it names the GENI debug
 		 * UART, which is not brought out on a retail unit.
 		 */
-		bootargs = "earlycon=simplefb keep_bootcon console=drm_log console=tty0 initcall_blacklist=simplefb_driver_init initcall_debug ignore_loglevel clk_ignore_unused pd_ignore_unused rootwait mtdoops.dump_oops=1 hung_task_panic=1 softlockup_panic=1 panic=15";
+		bootargs = "earlycon=simplefb keep_bootcon console=drm_log console=tty0 initcall_blacklist=simplefb_driver_init initcall_debug ignore_loglevel clk_ignore_unused pd_ignore_unused rootwait mtdoops.dump_oops=1 hung_task_panic=1 softlockup_panic=1 panic=0 qcom_q6v5_pas.slpi_auto_boot=0";
 
 		framebuffer: framebuffer@b8000000 {
 			compatible = "simple-framebuffer";
@@ -1539,7 +1539,6 @@
 &usb_1_dwc3 {
 	dr_mode = "otg";
 	usb-role-switch;
-	maximum-speed = "super-speed";
 	phys = <&usb_1_hsphy>, <&usb_1_qmpphy QMP_USB43DP_USB3_PHY>;
 	phy-names = "usb2-phy", "usb3-phy";
 };
@@ -1557,6 +1556,7 @@
 };
 
 &usb_1_qmpphy {
+	compatible = "qcom,sm8475-qmp-usb3-dp-phy", "qcom,sm8450-qmp-usb3-dp-phy";
 	status = "okay";
 
 	vdda-phy-supply = <&pm8350c_l10>;
