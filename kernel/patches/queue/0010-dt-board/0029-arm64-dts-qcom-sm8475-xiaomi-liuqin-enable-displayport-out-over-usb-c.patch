From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yp <yp@e5debian>
Date: Fri, 25 Sep 2026 00:27:44 +0800
Subject: [PATCH] arm64: dts: qcom: sm8475-xiaomi-liuqin: enable DisplayPort
 out over USB-C

The pad's USB-C port carries a QMP USB3+DP PHY, but the DPU's
displayport-controller (mdss_dp0) was left disabled and no USB-C mux
was described, so the in-tree msm DP driver had nothing to bind to and
no DP connector ever appeared.

Enable mdss_dp0 on two lanes (it shares usb_1_qmpphy, already enabled
for USB3) and describe the FSA4480 mux on i2c5 (vendor: fsa4480@42)
with mode/orientation switching wired to the pmic-glink connector.
pmic_glink_altmode then flips the port into DP Alt Mode and the
FSA4480 routes the SBU/AUX lanes, so an HDMI/DP dock enumerates and
trains like it does on the stock ROM.

Co-Authored-By: claude-sonnet-4-6 <noreply@anthropic.com>

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
index 3be362d74..8546a5724 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-liuqin.dts
@@ -271,6 +271,14 @@
 						remote-endpoint = <&usb_1_qmpphy_out>;
 					};
 				};
+
+				port@2 {
+					reg = <2>;
+
+					pmic_glink_sbu: endpoint {
+						remote-endpoint = <&fsa4480_sbu_mux>;
+					};
+				};
 			};
 		};
 	};
@@ -714,6 +722,26 @@
 	clock-frequency = <100000>;
 	status = "okay";
 
+	/*
+	 * USB-C mux (FSA4480) that routes the SBU/AUX lanes between USB data
+	 * and DisplayPort. In DP Alt Mode pmic_glink_altmode flips this to DP
+	 * so an HDMI/DP dock gets a live AUX link. Sits next to the USB2
+	 * repeater on the same bus (vendor: fsa4480@42 on i2c@994000).
+	 */
+	typec-mux@42 {
+		compatible = "fcs,fsa4480";
+		reg = <0x42>;
+
+		mode-switch;
+		orientation-switch;
+
+		port {
+			fsa4480_sbu_mux: endpoint {
+				remote-endpoint = <&pmic_glink_sbu>;
+			};
+		};
+	};
+
 	nxp_eusb2_repeater: eusb2-repeater@4f {
 		compatible = "nxp,eusb2-repeater";
 		reg = <0x4f>;
@@ -1198,6 +1226,21 @@
 	status = "okay";
 };
 
+/*
+ * DisplayPort out over USB-C (DP Alt Mode). mdss_dp0 is the DPU's DP
+ * controller and drives the same shared QMP USB3+DP PHY (usb_1_qmpphy) as
+ * the USB3 port. The FSA4480 mux on i2c5 routes the SBU/AUX lanes to DP and
+ * pmic_glink_altmode takes the port out of USB mode, which is what lights an
+ * HDMI/DP dock up.
+ */
+&mdss_dp0 {
+	status = "okay";
+};
+
+&mdss_dp0_out {
+	data-lanes = <0 1>;
+};
+
 /*
  * QCA6490 WLAN on PCIe RC0. The wifi child exists before enumeration so
  * pci-pwrctrl-pwrseq can claim the WCN6855 PMU's "wlan" target, raise gpio80
