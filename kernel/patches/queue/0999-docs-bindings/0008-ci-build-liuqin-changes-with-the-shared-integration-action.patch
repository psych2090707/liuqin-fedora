From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Sun, 13 Sep 2026 06:48:49 +0800
Subject: [PATCH] ci: build liuqin changes with the shared integration action


diff --git a/.github/workflows/liuqin.yml b/.github/workflows/liuqin.yml
new file mode 100644
index 000000000..c1179f5cb
--- /dev/null
+++ b/.github/workflows/liuqin.yml
@@ -0,0 +1,27 @@
+name: Liuqin kernel
+on:
+  push:
+    branches: [liuqin-6.17]
+  pull_request:
+    branches: [liuqin-6.17]
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: liuqin-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  build:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 180
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          repository: ${{ github.repository_owner }}/xiaomipad-6pro-mainline
+          ref: main
+          path: project
+          persist-credentials: false
+      - uses: ./project/.github/actions/kernel
+        with:
+          kernel-repository: ${{ github.repository }}
+          revision: ${{ github.sha }}
