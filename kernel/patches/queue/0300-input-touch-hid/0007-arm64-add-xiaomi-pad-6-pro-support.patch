+&i2c17 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	cs35l41_br: speaker-amp@40 {
+		compatible = "cirrus,cs35l41";
+		reg = <0x40>;
+		#sound-dai-cells = <1>;
