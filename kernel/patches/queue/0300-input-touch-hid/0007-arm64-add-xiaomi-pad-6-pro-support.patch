+/*
+ * The backlight is a Kinetic KTZ8866 at address 0x11 on QUPv3 wrapper 0's
+ * second serial engine -- the vendor's i2c@984000 (abl-final-fdt.dts:12657),
+ * which is what sm8450.dtsi:1364 calls i2c1. Address, enable line and the
+ * ENP/ENN rails all come from the vendor's ktz8866@11 (:12674-12681).
+ *
+ * No clock-frequency: sm8450.dtsi does not set one, so i2c-qcom-geni falls
+ * back to 100 kHz, which is what yudi runs this same chip on this same bus at.
+ * The vendor node does not specify one either.
+ */
+&i2c1 {
+	status = "okay";
+
+	/*
+	 * "kinetic,ktz8866", not ktz8866a. The fork's driver keys a two-chip
+	 * interlock off the compatible: ktz8866a is driver_data 1 and
+	 * ktz8866_probe() returns -EPROBE_DEFER for as long as no ktz8866b has
+	 * registered (drivers/video/backlight/ktz8866.c:147). That pairing is a
+	 * 14" yudi thing -- it carries two of these, on i2c1 and i2c5. This
+	 * unit has exactly one (abl-final-fdt.dts:12674), so anything but the
+	 * plain compatible would defer forever, and the panel, which waits on
+	 * this device through drm_panel_of_backlight(), would defer with it.
+	 *
+	 * current-num-sinks = 5 follows sm8250-xiaomi-pipa.dts:519 and
+	 * sm8250-xiaomi-elish-common.dtsi:585 rather than yudi: the vendor tree
+	 * specifies no sink count at all, and pipa is the same 11" panel
+	 * generation. Enabling a sink with no string on it is what the driver
+	 * would do by default (all six, ktz8866.c:110-113).
+	 */
+	backlight: backlight@11 {
+		compatible = "kinetic,ktz8866";
+		reg = <0x11>;
+
+		vddpos-supply = <&backlight_gpio_regulator_vsp>;
+		vddneg-supply = <&backlight_gpio_regulator_vsn>;
+
+		enable-gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
+
+		current-num-sinks = <5>;
+		kinetic,current-ramp-delay-ms = <128>;
+		kinetic,led-enable-ramp-delay-ms = <1>;
+		kinetic,enable-lcd-bias;
+	};
+};
