+	0x26, 0x80, 0x03,	/*   Logical Maximum (896)		*/
+	0x19, 0x00,		/*   Usage Minimum (0)			*/
+	0x2a, 0x80, 0x03,	/*   Usage Maximum (896)		*/
+	0x75, 0x10,		/*   Report Size (16)			*/
