From: liuqin Fedora maintainers <liuqin@localhost>
Subject: [PATCH] soc: qcom: propagate Type-C source state to battery clients

Source: liuqin v0.7.0 79ad9ad28f3865a4f9fc873748843ceb26dbd122
Adaptation: retain 7.3 UCSI and local sleep notification deferral; serialize state before replay.

---
diff --git a/drivers/soc/qcom/pmic_glink.c b/drivers/soc/qcom/pmic_glink.c
--- a/drivers/soc/qcom/pmic_glink.c
+++ b/drivers/soc/qcom/pmic_glink.c
@@ -47,6 +47,7 @@
 	/* serializing client_state and pdr_state updates */
 	struct mutex state_lock;
 	unsigned int client_state;
+	unsigned long source_ports;
 	unsigned int pdr_state;
 	bool pdr_available;
 
@@ -74,6 +75,7 @@
 
 	void (*cb)(const void *data, size_t len, void *priv);
 	void (*pdr_notify)(void *priv, int state);
+	void (*source_changed)(void *priv, unsigned long ports);
 	void *priv;
 };
 
@@ -120,16 +122,45 @@
 }
 EXPORT_SYMBOL_GPL(devm_pmic_glink_client_alloc);
 
-void pmic_glink_client_register(struct pmic_glink_client *client)
+void pmic_glink_client_watch_source_ports(struct pmic_glink_client *client,
+					  void (*changed)(void *, unsigned long))
+{
+	client->source_changed = changed;
+}
+EXPORT_SYMBOL_GPL(pmic_glink_client_watch_source_ports);
+
+void pmic_glink_set_port_source(struct pmic_glink_client *client, unsigned int port, bool source)
 {
 	struct pmic_glink *pg = client->pg;
 	unsigned long flags;
 
+	if (WARN_ON_ONCE(port >= BITS_PER_LONG))
+		return;
+
+	spin_lock_irqsave(&pg->client_lock, flags);
+	if (pg->client_state == SERVREG_SERVICE_STATE_UP &&
+	    test_bit(port, &pg->source_ports) != source) {
+		__assign_bit(port, &pg->source_ports, source);
+		list_for_each_entry(client, &pg->clients, node)
+			if (client->source_changed)
+				client->source_changed(client->priv, pg->source_ports);
+	}
+	spin_unlock_irqrestore(&pg->client_lock, flags);
+}
+EXPORT_SYMBOL_GPL(pmic_glink_set_port_source);
+
+void pmic_glink_client_register(struct pmic_glink_client *client)
+{
+	struct pmic_glink *pg = client->pg;
+	unsigned long flags;
+
 	guard(mutex)(&pg->state_lock);
 	spin_lock_irqsave(&pg->client_lock, flags);
 
 	list_add(&client->node, &pg->clients);
 	client->pdr_notify(client->priv, pg->client_state);
+	if (client->source_changed)
+		client->source_changed(client->priv, pg->source_ports);
 
 	spin_unlock_irqrestore(&pg->client_lock, flags);
 }
@@ -328,10 +359,12 @@
 
 	if (new_state != pg->client_state) {
 		spin_lock_irqsave(&pg->client_lock, flags);
+		if (new_state != SERVREG_SERVICE_STATE_UP)
+			pg->source_ports = 0;
+		pg->client_state = new_state;
 		list_for_each_entry(client, &pg->clients, node)
 			client->pdr_notify(client->priv, new_state);
 		spin_unlock_irqrestore(&pg->client_lock, flags);
-		pg->client_state = new_state;
 	}
 }
 
diff --git a/include/linux/soc/qcom/pmic_glink.h b/include/linux/soc/qcom/pmic_glink.h
--- a/include/linux/soc/qcom/pmic_glink.h
+++ b/include/linux/soc/qcom/pmic_glink.h
@@ -30,4 +30,9 @@
 						       void *priv);
 void pmic_glink_client_register(struct pmic_glink_client *client);
 
+void pmic_glink_client_watch_source_ports(struct pmic_glink_client *client,
+					  void (*changed)(void *, unsigned long));
+void pmic_glink_set_port_source(struct pmic_glink_client *client, unsigned int port, bool source);
+void pmic_glink_client_register(struct pmic_glink_client *client);
+
 #endif
diff --git a/drivers/usb/typec/ucsi/ucsi_glink.c b/drivers/usb/typec/ucsi/ucsi_glink.c
--- a/drivers/usb/typec/ucsi/ucsi_glink.c
+++ b/drivers/usb/typec/ucsi/ucsi_glink.c
@@ -208,6 +208,11 @@
 {
 	struct pmic_glink_ucsi *ucsi = ucsi_get_drvdata(con->ucsi);
 	int orientation;
+
+	if (con->num && con->num <= PMIC_GLINK_MAX_PORTS)
+		pmic_glink_set_port_source(ucsi->client, con->num - 1,
+					   UCSI_CONSTAT(con, CONNECTED) &&
+					   UCSI_CONSTAT(con, PWR_DIR) == TYPEC_SOURCE);
 
 	if (!UCSI_CONSTAT(con, CONNECTED)) {
 		typec_set_orientation(con->port, TYPEC_ORIENTATION_NONE);
@@ -476,6 +481,7 @@
 static void pmic_glink_ucsi_remove(struct auxiliary_device *adev)
 {
 	struct pmic_glink_ucsi *ucsi = dev_get_drvdata(&adev->dev);
+	unsigned int port;
 
 	/* Callbacks can queue work until devres releases the client */
 	disable_work_sync(&ucsi->notify_work);
@@ -486,6 +492,8 @@
 		ucsi->ucsi_registered = false;
 		ucsi_unregister(ucsi->ucsi);
 	}
+	for (port = 0; port < PMIC_GLINK_MAX_PORTS; port++)
+		pmic_glink_set_port_source(ucsi->client, port, false);
 }
 
 static const struct auxiliary_device_id pmic_glink_ucsi_id_table[] = {
