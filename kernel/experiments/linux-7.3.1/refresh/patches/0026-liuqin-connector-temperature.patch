 }
 
+/* Sample only while powered, on a freezable queue; ADC absence cannot block battery probe. */
+static void qcom_battmgr_connector_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *b = container_of(to_delayed_work(work),
+					      struct qcom_battmgr, connector_work);
+	int temp, ret;
+
+	if (!IS_REACHABLE(CONFIG_IIO) || !READ_ONCE(b->service_up))
+		return;
+	guard(mutex)(&b->lock);
+	if (!READ_ONCE(b->connector_active))
+		return;
+	if (!b->connector) {
+		struct iio_channel *chan = iio_channel_get(b->dev, "connector-temp");
+
+		if (IS_ERR(chan)) {
+			ret = PTR_ERR(chan);
+			if (ret == -EPROBE_DEFER)
+				goto rearm;
+			dev_err(b->dev, "connector temperature unavailable: %pe\n", chan);
+			WRITE_ONCE(b->connector_enabled, false);
+			return;
+		}
+		b->connector = chan;
+	}
+	ret = iio_read_channel_processed(b->connector, &temp);
+	if (ret < 0)
+		goto rearm;
+	/* IIO reports milli-Celsius; firmware expects tenths of a degree. */
+	temp = DIV_ROUND_CLOSEST(temp, 100);
+	ret = qcom_battmgr_xm_m1_set_value_locked(b, XM_CONNECTOR_TEMP, temp);
+rearm:
+	if (ret < 0 && ret != -EPROBE_DEFER)
+		dev_warn_ratelimited(b->dev, "connector temperature update failed: %d\n", ret);
+	scoped_guard(spinlock_irqsave, &b->connector_lock) {
+		if (b->connector_active)
+			queue_delayed_work(system_freezable_wq, &b->connector_work, HZ);
+	}
+}
+
 /* Stop every GLINK consumer before the managed client is released. */
 static void qcom_battmgr_stop_workers(void *data)
 {
 	struct qcom_battmgr *battmgr = data;
 
+	disable_work_sync(&battmgr->online_work);
 	disable_work_sync(&battmgr->enable_work);
+	disable_delayed_work_sync(&battmgr->connector_work);
+	if (IS_REACHABLE(CONFIG_IIO) && battmgr->connector)
+		iio_channel_release(battmgr->connector);
 #if IS_ENABLED(CONFIG_TYPEC)
 	disable_work_sync(&battmgr->cc_orientation_work);
 #endif
@@ -2561,6 +2707,8 @@
 	mutex_unlock(&battmgr->lock);
 	if (ret)
 		dev_err(battmgr->dev, "failed to request power notifications\n");
+	qcom_battmgr_queue_online(battmgr, ONLINE_USB);
+	qcom_battmgr_queue_online(battmgr, ONLINE_WIRELESS);
 }
 
 static void qcom_battmgr_pdr_notify(void *priv, int state)
@@ -2568,13 +2716,17 @@
 	struct qcom_battmgr *battmgr = priv;
 
 	if (state == SERVREG_SERVICE_STATE_UP) {
-		battmgr->service_up = true;
+		WRITE_ONCE(battmgr->service_up, true);
 		schedule_work(&battmgr->enable_work);
 		qcom_battmgr_schedule_cc_orientation(battmgr);
 		if (READ_ONCE(battmgr->pen_work_ready))
 			mod_delayed_work(system_wq, &battmgr->pen_work, 0);
 	} else {
-		battmgr->service_up = false;
+		WRITE_ONCE(battmgr->service_up, false);
+		battmgr->online_valid = 0;
+		battmgr->online_mask = 0;
+		battmgr->connector_source = false;
+		qcom_battmgr_connector_gate(battmgr);
 	}
 }
 
@@ -2878,6 +3030,22 @@
 					     "failed to register wireless charing power supply\n");
 	}
 
+	ret = devm_device_init_wakeup(dev);
+	if (ret)
+		return ret;
+	ret = devm_work_autocancel(dev, &battmgr->online_work, qcom_battmgr_check_online);
+	if (ret)
+		return ret;
+	spin_lock_init(&battmgr->connector_lock);
+	ret = devm_delayed_work_autocancel(dev, &battmgr->connector_work,
+					   qcom_battmgr_connector_worker);
+	if (ret)
+		return ret;
+	if (battmgr->variant == QCOM_BATTMGR_SM8475)
+		battmgr->connector_enabled = IS_REACHABLE(CONFIG_IIO) &&
+			device_property_match_string(dev, "io-channel-names",
+					     "connector-temp") >= 0;
+
 	ret = devm_work_autocancel(dev, &battmgr->enable_work,
 				   qcom_battmgr_enable_worker);
 	if (ret)
@@ -2918,6 +3086,8 @@
