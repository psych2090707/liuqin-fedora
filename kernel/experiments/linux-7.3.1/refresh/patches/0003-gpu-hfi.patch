From: liuqin Fedora adaptation <liuqin@localhost>
Subject: [PATCH] liuqin 7.3.1: gpu-hfi

b9e43fbe, cb8be68e; ARMADA PR662 bounded devcoredump wait.
Original-Author: Armada <noreply@armada.local>
Upstream-commit: https://github.com/yzddmr6/linux-sm8450-liuqin/commit/b9e43fbe6b2392c41fe810554bdd8ac2bd0be562
Link: https://github.com/armada-os/armada/pull/662
Original-Author: gennro <gennro2004@gmail.com>
Upstream-commit: https://github.com/yzddmr6/linux-sm8450-liuqin/commit/cb8be68ec106ba759c13eba32cef225c5273e89e
Link: https://github.com/armada-os/armada/pull/662
Source: https://github.com/armada-os/armada/pull/662
Original-Author: gennro <gennro2004@gmail.com>
Linux-derived code retains original GPL notices. Offline port; no hardware claim.
---
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -64,7 +64,13 @@
 	struct a6xx_gmu *gmu = data;
 	u32 status;
 
-	status = gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO);
+	/*
+	 * Only clear what this handler deals with: the HFI response (MSGQ) and
+	 * OOB ack bits are polled for, and clearing them here loses the GMU's
+	 * answer to whoever is waiting for it.
+	 */
+	status = gmu_read(gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO) &
+		 A6XX_GMU_GMU2HOST_INTR_INFO_CM3_FAULT;
 	gmu_write(gmu, REG_A6XX_GMU_GMU2HOST_INTR_CLR, status);
 
 	if (status & A6XX_GMU_GMU2HOST_INTR_INFO_CM3_FAULT) {
@@ -439,7 +445,10 @@
 		 * pending faults from the GPU and we are taking a devcoredump.
 		 * Wait until the MMU is resumed and try again.
 		 */
-		wait_for_completion(&a6xx_gpu->base.fault_coredump_done);
+		/* Recovery may hold gpu->lock, needed by the fault dump worker. */
+		if (!wait_for_completion_timeout(&a6xx_gpu->base.fault_coredump_done,
+						 msecs_to_jiffies(2000)))
+			break;
 	} while (true);
 
 	if (ret)
@@ -1341,6 +1350,9 @@
 	/* Set the bus quota to a reasonable value for boot */
 	a6xx_gmu_set_initial_bw(gpu, gmu);
 
+	/* The mask resets to 0 with the GMU: keep HFI replies off the irq line */
+	gmu_write(gmu, REG_A6XX_GMU_GMU2HOST_INTR_MASK, ~0);
+
 	/* Enable the GMU interrupt */
 	gmu_write(gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_CLR, ~0);
 	gmu_write(gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_MASK, ~A6XX_GMU_IRQ_MASK);
--- a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
@@ -129,7 +129,10 @@
 		 * pending faults from the GPU and we are taking a devcoredump.
 		 * Wait until the MMU is resumed and try again.
 		 */
-		wait_for_completion(&a6xx_gpu->base.fault_coredump_done);
+		/* Recovery may hold gpu->lock, needed by the fault dump worker. */
+		if (!wait_for_completion_timeout(&a6xx_gpu->base.fault_coredump_done,
+						 msecs_to_jiffies(2000)))
+			break;
 	} while (true);
 
 	if (ret) {
