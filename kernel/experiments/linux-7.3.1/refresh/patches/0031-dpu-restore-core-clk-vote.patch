From: liuqin Fedora maintainers <liuqin@localhost>
Subject: [PATCH] drm/msm/dpu: restore the core clock OPP vote before enabling clocks

Source: upstream 3a56ea9421bb1, carried by liuqin v0.7.0 8ec7416f90
Rationale: disabling the last CRTC drops the core clock performance vote,
but the clock keeps its rate. Re-vote for the current rate (capped at the
highest OPP) before enabling the clocks on resume, mirroring the DSI host.
The resume from dpu_kms_hw_init() runs before perf limits are known and is
skipped; genpd restores that vote afterwards.
Note: the companion removal of dev_pm_opp_set_rate(dev, 0) from
dpu_runtime_suspend (8c24799522) is not needed here because 7.3.1 does not
contain that call.
Validation and rollback: tasks/upstream-refresh/RESULT.md.

---
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -1446,6 +1446,44 @@
 	return 0;
 }
 
+/*
+ * Disabling the last CRTC drops the core clock's performance vote through
+ * dev_pm_opp_set_rate(dev, 0), and the power domain restores exactly that
+ * on runtime resume. The clock keeps its rate though, and runs at it as
+ * soon as it is enabled below, well before the first CRTC update votes
+ * again. Put the vote for that rate back before the clock is enabled.
+ */
+static int dpu_kms_restore_core_clk_vote(struct dpu_kms *dpu_kms)
+{
+	struct clk *core_clk;
+	unsigned long rate;
+	int ret;
+
+	/*
+	 * The resume in dpu_kms_hw_init() comes before the perf limits are
+	 * known, but after dpu_kms_init() voted for the highest OPP.
+	 */
+	if (!dpu_kms->perf.max_core_clk_rate)
+		return 0;
+
+	core_clk = msm_clk_bulk_get_clock(dpu_kms->clocks, dpu_kms->num_clocks,
+					  "core");
+	if (!core_clk)
+		return 0;
+
+	rate = clk_get_rate(core_clk);
+	if (!rate)
+		return 0;
+
+	rate = min_t(unsigned long, rate, dpu_kms->perf.max_core_clk_rate);
+	ret = dev_pm_opp_set_rate(&dpu_kms->pdev->dev, rate);
+	if (ret)
+		DPU_ERROR("failed to vote for core clock rate %lu: %d\n",
+			  rate, ret);
+
+	return ret;
+}
+
 static int __maybe_unused dpu_runtime_resume(struct device *dev)
 {
 	int rc = -1;
@@ -1457,6 +1495,10 @@
 
 	ddev = dpu_kms->dev;
 
+	rc = dpu_kms_restore_core_clk_vote(dpu_kms);
+	if (rc)
+		return rc;
+
 	rc = clk_bulk_prepare_enable(dpu_kms->num_clocks, dpu_kms->clocks);
 	if (rc) {
 		DPU_ERROR("clock enable failed rc:%d\n", rc);
