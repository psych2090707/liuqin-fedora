From: liuqin Fedora adaptation <liuqin@localhost>
Subject: [PATCH] liuqin 7.3.1: gpu-terminal-recovery

018982b5; preserve 7.3 VM and perf-counter handling; recover before fence advance.
Original-Author: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Upstream-commit: https://github.com/yzddmr6/linux-sm8450-liuqin/commit/018982b5e1ac830617c6aed9cacb6cc68f4eae1a
Co-Authored-By: gpt-6-astra <noreply@openai.com>
Linux-derived code retains original GPL notices. Offline port; no hardware claim.
---
--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
@@ -1566,12 +1566,38 @@
 	adreno_dump(gpu);
 }
 
+/* Drop and restore recovery references without accidentally waking the GPU. */
+static int a6xx_recover_suspend(struct msm_gpu *gpu, int active_submits)
+{
+	struct a6xx_gmu *gmu = &to_a6xx_gpu(to_adreno_gpu(gpu))->gmu;
+	struct device *dev = &gpu->pdev->dev;
+	int ret;
+
+	reinit_completion(&gmu->pd_gate);
+	ret = dev_pm_genpd_add_notifier(gmu->cxpd, &gmu->pd_nb);
+	if (ret)
+		return ret;
+	dev_pm_genpd_synced_poweroff(gmu->cxpd);
+	if (active_submits)
+		pm_runtime_put_noidle(dev);
+	ret = pm_runtime_put_sync_suspend(dev);
+	if (ret >= 0 &&
+	    !wait_for_completion_timeout(&gmu->pd_gate, msecs_to_jiffies(1000)))
+		ret = -ETIMEDOUT;
+	dev_pm_genpd_remove_notifier(gmu->cxpd);
+	if (active_submits)
+		pm_runtime_get_noresume(dev);
+	pm_runtime_get_noresume(dev);
+	return ret < 0 ? ret : 0;
+}
+
 static void a6xx_recover(struct msm_gpu *gpu)
 {
 	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
 	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
 	struct a6xx_gmu *gmu = &a6xx_gpu->gmu;
-	int active_submits;
+	int active_submits, ret;
+	bool quiesced = false;
 
 	adreno_dump_info(gpu);
 
@@ -1612,34 +1638,41 @@
 		a6xx_gpu_sw_reset(gpu, false);
 	}
 
-	reinit_completion(&gmu->pd_gate);
-	dev_pm_genpd_add_notifier(gmu->cxpd, &gmu->pd_nb);
-	dev_pm_genpd_synced_poweroff(gmu->cxpd);
-
-	/* Drop the rpm refcount from active submits */
-	if (active_submits)
-		pm_runtime_put(&gpu->pdev->dev);
-
-	/* And the final one from recover worker */
-	pm_runtime_put_sync(&gpu->pdev->dev);
-
-	if (!wait_for_completion_timeout(&gmu->pd_gate, msecs_to_jiffies(1000)))
-		DRM_DEV_ERROR(&gpu->pdev->dev, "cx gdsc didn't collapse\n");
-
-	dev_pm_genpd_remove_notifier(gmu->cxpd);
-
-	pm_runtime_use_autosuspend(&gpu->pdev->dev);
-
-	if (active_submits)
-		pm_runtime_get(&gpu->pdev->dev);
-
-	pm_runtime_get_sync(&gpu->pdev->dev);
-
+	ret = a6xx_recover_suspend(gpu, active_submits);
+	if (ret)
+		goto failed;
+
+	/* No submitted commands can survive a confirmed CX power collapse. */
+	quiesced = true;
+	ret = pm_runtime_resume(&gpu->pdev->dev);
+	if (ret < 0)
+		goto failed;
+
+	quiesced = false;
+	ret = msm_gpu_hw_init(gpu);
+	if (ret) {
+		/* hw_init may have started the CP; stop it before ending fences. */
+		gmu->hung = true;
+		quiesced = !a6xx_recover_suspend(gpu, active_submits);
+		goto failed;
+	}
+
+	a6xx_gpu->hung = false;
+	goto out;
+
+failed:
+	WRITE_ONCE(gpu->wedged, true);
+	timer_delete_sync(&gpu->hangcheck_timer);
+	DRM_DEV_ERROR(&gpu->pdev->dev, "GPU recovery failed: %d; device wedged\n", ret);
+	if (quiesced)
+		msm_gpu_fail_submits(gpu);
+	else
+		DRM_DEV_ERROR(&gpu->pdev->dev,
+			      "GPU not quiescent; retaining pending fences and buffers\n");
+out:
 	gpu->active_submits = active_submits;
 	mutex_unlock(&gpu->active_lock);
-
-	msm_gpu_hw_init(gpu);
-	a6xx_gpu->hung = false;
+	pm_runtime_use_autosuspend(&gpu->pdev->dev);
 }
 
