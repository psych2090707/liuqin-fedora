From: liuqin Fedora adaptation <liuqin@localhost>
Subject: [PATCH] liuqin 7.3.1: dsi-errors

9bc411d0; propagate errors and balance successful PM acquisitions.
Original-Author: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Upstream-commit: https://github.com/yzddmr6/linux-sm8450-liuqin/commit/9bc411d03020c9db63b445a3985b92f5988b4d41
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Linux-derived code retains original GPL notices. Offline port; no hardware claim.
---
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -438,12 +438,16 @@
 	 * cannot use assigned-clock-parents.
 	 */
 	ret = clk_set_parent(msm_host->byte_src_clk, msm_host->dsi_pll_byte_clk);
-	if (ret)
+	if (ret) {
 		dev_err(dev, "Failed to parent byte_src -> dsi_pll_byte: %d\n", ret);
+		return ret;
+	}
 
 	ret = clk_set_parent(msm_host->pixel_src_clk, msm_host->dsi_pll_pixel_clk);
-	if (ret)
+	if (ret) {
 		dev_err(dev, "Failed to parent pixel_src -> dsi_pll_pixel: %d\n", ret);
+		return ret;
+	}
 
 	return dsi_link_clk_set_rate_6g(msm_host);
 }
@@ -1572,7 +1576,7 @@
 		container_of(work, struct msm_dsi_host, err_work);
 	u32 status = msm_host->err_work_state;
 
-	pr_err_ratelimited("%s: status=%x\n", __func__, status);
+	dev_err_ratelimited(&msm_host->pdev->dev, "%s: status=%x\n", __func__, status);
 	if (status & DSI_ERR_STATE_MDP_FIFO_UNDERFLOW)
 		dsi_sw_reset(msm_host);
 
@@ -2167,6 +2171,7 @@
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
+	int ret;
 
 	/* TODO: make sure dsi_cmd_mdp is idle.
 	 * Since DSI6G v1.2.0, we can set DSI_TRIG_CTRL.BLOCK_DMA_WITHIN_FRAME
@@ -2178,9 +2183,17 @@
 	 * mdss interrupt is generated in mdp core clock domain
 	 * mdp clock need to be enabled to receive dsi interrupt
 	 */
-	pm_runtime_get_sync(&msm_host->pdev->dev);
-	cfg_hnd->ops->link_clk_set_rate(msm_host);
-	cfg_hnd->ops->link_clk_enable(msm_host);
+	ret = pm_runtime_resume_and_get(&msm_host->pdev->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cfg_hnd->ops->link_clk_set_rate(msm_host);
+	if (ret)
+		goto err_put_pm;
+
+	ret = cfg_hnd->ops->link_clk_enable(msm_host);
+	if (ret)
+		goto err_put_pm;
 
 	/* TODO: vote for bus bandwidth */
 
@@ -2195,6 +2208,10 @@
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_CMD_DMA_DONE, 1);
 
 	return 0;
+
+err_put_pm:
+	pm_runtime_put(&msm_host->pdev->dev);
+	return ret;
 }
 
 void msm_dsi_host_xfer_restore(struct mipi_dsi_host *host,
@@ -2511,14 +2528,17 @@
 		goto unlock_ret;
 	}
 
-	pm_runtime_get_sync(&msm_host->pdev->dev);
+	ret = pm_runtime_resume_and_get(&msm_host->pdev->dev);
+	if (ret < 0)
+		goto fail_disable_reg;
+
 	ret = cfg_hnd->ops->link_clk_set_rate(msm_host);
 	if (!ret)
 		ret = cfg_hnd->ops->link_clk_enable(msm_host);
 	if (ret) {
 		pr_err("%s: failed to enable link clocks. ret=%d\n",
 		       __func__, ret);
-		goto fail_disable_reg;
+		goto fail_put_pm;
 	}
 
 	ret = pinctrl_pm_select_default_state(&msm_host->pdev->dev);
@@ -2539,6 +2559,7 @@
 
 fail_disable_clk:
 	cfg_hnd->ops->link_clk_disable(msm_host);
+fail_put_pm:
 	pm_runtime_put(&msm_host->pdev->dev);
 fail_disable_reg:
 	regulator_bulk_disable(msm_host->cfg_hnd->cfg->num_regulators,
