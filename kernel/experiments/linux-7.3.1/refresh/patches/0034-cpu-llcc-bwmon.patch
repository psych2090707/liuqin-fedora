From: liuqin Fedora maintainers <liuqin@localhost>
Subject: [PATCH] arm64: dts: qcom: sm8475: describe CPU and LLCC bandwidth monitors

Source: liuqin v0.7.0 309060c799a73da6b090ef1084dc8c41357e46a0
Adaptation: 7.3.1 already lists qcom,sm8475-cpu-bwmon in the binding, so
only the missing llcc compatible is added; the two Cape BWMON nodes apply
as-is. The icc-bwmon driver matches the sc7280-llcc / sdm845 fallbacks.
Rationale: give the interconnect framework real CPU and LLCC bandwidth
votes instead of leaving the zones unmonitored.
Validation and rollback: tasks/upstream-refresh/RESULT.md.

---
--- a/Documentation/devicetree/bindings/interconnect/qcom,msm8998-bwmon.yaml
+++ b/Documentation/devicetree/bindings/interconnect/qcom,msm8998-bwmon.yaml
@@ -41,6 +41,7 @@
               - qcom,sm6115-cpu-bwmon
               - qcom,sm6350-llcc-bwmon
               - qcom,sm8250-cpu-bwmon
+              - qcom,sm8475-cpu-bwmon
               - qcom,sm8550-cpu-bwmon
               - qcom,sm8650-cpu-bwmon
               - qcom,sm8750-cpu-bwmon
@@ -58,6 +59,7 @@
               - qcom,shikra-cpu-bwmon
               - qcom,sm6350-cpu-bwmon
               - qcom,sm8250-llcc-bwmon
+              - qcom,sm8475-llcc-bwmon
               - qcom,sm8550-llcc-bwmon
               - qcom,sm8650-llcc-bwmon
               - qcom,x1e80100-llcc-bwmon
--- a/arch/arm64/boot/dts/qcom/sm8475.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8475.dtsi
@@ -14,6 +14,84 @@
 
 
 &soc {
+	pmu@19091000 {
+		compatible = "qcom,sm8475-llcc-bwmon", "qcom,sc7280-llcc-bwmon";
+		reg = <0 0x19091000 0 0x1000>;
+		interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
+		interconnects = <&mc_virt MASTER_LLCC QCOM_ICC_TAG_ACTIVE_ONLY
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ACTIVE_ONLY>;
+		operating-points-v2 = <&llcc_bwmon_opp_table>;
+
+		llcc_bwmon_opp_table: opp-table {
+			compatible = "operating-points-v2";
+
+			opp-0 {
+				opp-peak-kBps = <1720000>;
+			};
+
+			opp-1 {
+				opp-peak-kBps = <2086000>;
+			};
+
+			opp-2 {
+				opp-peak-kBps = <2929000>;
+			};
+
+			opp-3 {
+				opp-peak-kBps = <3879000>;
+			};
+
+			opp-4 {
+				opp-peak-kBps = <6515000>;
+			};
+
+			opp-5 {
+				opp-peak-kBps = <7980000>;
+			};
+
+			opp-6 {
+				opp-peak-kBps = <12191000>;
+			};
+		};
+	};
+
+	pmu@190b6400 {
+		compatible = "qcom,sm8475-cpu-bwmon", "qcom,sdm845-bwmon";
+		reg = <0 0x190b6400 0 0x300>;
+		interrupts = <GIC_SPI 581 IRQ_TYPE_LEVEL_HIGH>;
+		interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+				 &gem_noc SLAVE_LLCC QCOM_ICC_TAG_ACTIVE_ONLY>;
+		operating-points-v2 = <&cpu_bwmon_opp_table>;
+
+		cpu_bwmon_opp_table: opp-table {
+			compatible = "operating-points-v2";
+
+			opp-0 {
+				opp-peak-kBps = <4577000>;
+			};
+
+			opp-1 {
+				opp-peak-kBps = <7110000>;
+			};
+
+			opp-2 {
+				opp-peak-kBps = <9155000>;
+			};
+
+			opp-3 {
+				opp-peak-kBps = <12298000>;
+			};
+
+			opp-4 {
+				opp-peak-kBps = <14236000>;
+			};
+
+			opp-5 {
+				opp-peak-kBps = <15258000>;
+			};
+		};
+	};
+
 	usb_1_hsphy: phy@88e3000 {
 		compatible = "qcom,sm8475-snps-eusb2-phy",
 			     "qcom,sm8550-snps-eusb2-phy";
