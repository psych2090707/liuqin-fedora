# Independent module namespace for RAM experiments; preserve the daily B seed.
CONFIG_LOCALVERSION="-liuqin-exp1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_SENSORS_FPC1020_SPI=m
# CONFIG_SENSORS_FPC1020 is not set
CONFIG_PM_CLK=y
# QCE is marked BROKEN in 7.3 (secure-world races); retain the upstream gate.
# CONFIG_CRYPTO_DEV_QCE is not set
# The former crypto RNG driver moved to the hwrng subsystem.
CONFIG_HW_RANDOM_QCOM=m
# These former tristates are booleans in 7.3.
CONFIG_IPV6=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_CRYPTO_LIB_CURVE25519_GENERIC=y
# Avoid the observed drm_log restore framebuffer lifetime warning.
# fbdev also supplies the community OFF/ON recovery interface before GDM.
# CONFIG_DRM_CLIENT_LOG is not set
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
# CONFIG_DRM_CLIENT_DEFAULT_LOG is not set
CONFIG_DRM_CLIENT_DEFAULT="fbdev"
