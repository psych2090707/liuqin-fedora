+/*
+ * The touchscreen is a Novatek NT36532 on chip select 0 of QUPv3 wrapper 0's
+ * fifth serial engine. Frequency, chip select and interrupt line are taken from
+ * the device tree the vendor bootloader hands the vendor kernel on this exact
+ * unit, captured during the E4 boot:
+ * abl-final-fdt.dts:12799-12835, node spi@990000/touchscreen@0.
+ *
+ * No supply here on purpose: the vendor node has none either. The controller is
+ * fed from the panel's rails, which is also why it can be brought up before the
+ * display is.
+ */
+&spi4 {
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "novatek,NVT-ts-spi";
+		reg = <0>;
+
+		spi-max-frequency = <9600000>;
+
+		/*
+		 * The trigger type is fixed in the driver (INT_TRIGGER_TYPE),
+		 * which requests the interrupt from gpio_to_irq() rather than
+		 * from this specifier, so this cell is documentation.
+		 */
+		novatek,irq-gpio = <&tlmm 21 IRQ_TYPE_EDGE_RISING>;
+
+		/*
+		 * Software reset register of the NT36532. The vendor tree does
+		 * not carry this property -- its driver has the address
+		 * compiled in -- but nvt_parse_dt() treats it as mandatory and
+		 * fails probe without it. The value is the one the mainline
+		 * driver's own NT36532 register table holds, and matches yudi,
+		 * which has the same touch controller.
+		 */
+		novatek,swrst-n8-addr = <0x1fb43e>;
+
+		novatek,pen-support;
+
+		firmware-name = "novatek/liuqin/novatek_nt36532_m81_fw_csot.bin";
+
+		/*
+		 * The NT36532 is a TDDI die shared with the display. The DRM
+		 * panel prepare sequence resets it and discards the RAM-loaded
+		 * touch firmware, so the touch driver must follow the panel and
+		 * download the firmware again after every prepare (E22 finding:
+		 * touch worked in E12/E13 only because no display driver
+		 * existed yet to reset the die).
+		 */
+		panel = <&panel>;
+	};
+};
+
+&tlmm {
+	gpio-reserved-ranges = <28 4>;
+	status = "okay";
+
+	/* Vendor configuration: gpio40 pull-down input, gpio41 released high. */
+	fingerprint_irq: fingerprint-irq-state {
+		pins = "gpio40";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	fingerprint_rst: fingerprint-rst-state {
+		pins = "gpio41";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+
+	/*
+	 * The QCA6490 enable lines come up deasserted and are raised by the
+	 * power sequencer when a radio is actually claimed. Levels, direction
+	 * and bias match the vendor's own deasserted states -- bt_en_sleep
+	 * (abl-final-fdt.dts:2570) and cnss_wlan_en_sleep (:4426) -- which is
+	 * what the vendor's Bluetooth node uses as its default. The drive
+	 * strength is 16 rather than the 2 those two states carry, because
+	 * that is what the vendor selects in cnss_wlan_en_active (:4410) for
+	 * the moment the line is actually driven, and it matches
+	 * sm8450-hdk.dts, the mainline reference for this PMU.
+	 */
+	bt_en_state: bt-en-state {
+		pins = "gpio81";
+		function = "gpio";
+		drive-strength = <16>;
+		output-low;
+		bias-pull-down;
+	};
+
+	/* Vendor xiaomi_hall_default: input, pull-up, drive 2. */
+	hall_default: hall-default-state {
+		pins = "gpio10", "gpio23";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	/*
+	 * The rest of the vendor's nanosic_keyboard_mcu group
+	 * (abl-final-fdt.dts:5284-5331), split by function because the pins
+	 * belong to two different consumers here -- gpio62 to the regulator,
+	 * the other three to the bridge node. Drive strength and bias are the
+	 * vendor's: xiaomi_keyboard_default puts gpio46, gpio83 and gpio62
+	 * together at drive 2 with bias disabled, xiaomi_keyboard_sleep_default
+	 * gives gpio42 a pull-down.
+	 *
+	 * gpio10 and gpio23 came out of that same vendor group and are
+	 * described above as hall_default, owned by gpio-keys. They are not
+	 * part of this set.
+	 */
+	kb_vdd_default: kb-vdd-default-state {
+		pins = "gpio62";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	kb_reset_default: kb-reset-default-state {
+		pins = "gpio83";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	kb_wake_default: kb-wake-default-state {
+		pins = "gpio42";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	/* The vendor group leaves this an output-capable pin; it is an input. */
+	kb_wakeup_irq_default: kb-wakeup-irq-default-state {
+		pins = "gpio46";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	/*
+	 * The vendor tree configures no pin state at all for gpio50 and relies
+	 * on its driver calling gpio_direction_input(). This one is ours. The
+	 * bridge drives the line push-pull, so it needs no bias.
+	 */
+	kb_data_irq_default: kb-data-irq-default-state {
+		pins = "gpio50";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	/*
+	 * CS35L41 reset and INTB pins. Drive 16 / bias-disable / output-high
+	 * on reset and drive 2 / input-enable / pull-up on IRQ are the vendor
+	 * cirrus_reset_default_* and cirrus_irq_default_* states at
+	 * abl-final-fdt.dts:5185-5281.
+	 */
+	/* WCD9385 reset is active-low; hold it asserted until the codec probes. */
+	wcd_reset_default: wcd-reset-default-state {
+		pins = "gpio43";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-low;
+	};
+
+	cirrus_reset_tl: cirrus-reset-tl {
+		pins = "gpio1";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	cirrus_irq_tl: cirrus-irq-tl {
+		pins = "gpio88";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	cirrus_reset_tr: cirrus-reset-tr {
+		pins = "gpio3";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	cirrus_irq_tr: cirrus-irq-tr {
+		pins = "gpio63";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	cirrus_reset_br: cirrus-reset-br {
+		pins = "gpio92";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	cirrus_irq_br: cirrus-irq-br {
+		pins = "gpio89";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	cirrus_reset_bl: cirrus-reset-bl {
+		pins = "gpio87";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	cirrus_irq_bl: cirrus-irq-bl {
+		pins = "gpio90";
+		function = "gpio";
+		drive-strength = <2>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	/*
+	 * Tertiary TDM to the CS35L41s. Function, pins and drive come from
+	 * abl-final-fdt.dts:1795-1928; sleep states are gpio + pull-down.
+	 */
+	tert_tdm_clk_active: tert-tdm-clk-active {
+		pins = "gpio121";
+		function = "mi2s2_sck";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	tert_tdm_clk_sleep: tert-tdm-clk-sleep {
+		pins = "gpio121";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	tert_tdm_ws_active: tert-tdm-ws-active {
+		pins = "gpio123";
+		function = "mi2s2_ws";
+		drive-strength = <8>;
+		bias-disable;
+		output-high;
+	};
+
+	tert_tdm_ws_sleep: tert-tdm-ws-sleep {
+		pins = "gpio123";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	tert_tdm_din_active: tert-tdm-din-active {
+		pins = "gpio122";
+		function = "mi2s2_data0";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	tert_tdm_din_sleep: tert-tdm-din-sleep {
+		pins = "gpio122";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	tert_tdm_dout_active: tert-tdm-dout-active {
+		pins = "gpio124";
+		function = "mi2s2_data1";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	tert_tdm_dout_sleep: tert-tdm-dout-sleep {
+		pins = "gpio124";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	/*
+	 * The panel reset line. Function, drive strength and bias are the
+	 * vendor's own sde_dsi_active (abl-final-fdt.dts:5527-5539); its
+	 * counterpart sde_dsi_suspend, which pulls gpio0 down at drive strength
+	 * 2, is not described because nothing here ever selects a suspend
+	 * state for the panel.
+	 */
+	sde_dsi_active: sde-dsi-active-state {
+		pins = "gpio0";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	wlan_en_state: wlan-en-state {
+		pins = "gpio80";
+		function = "gpio";
+		drive-strength = <16>;
+		output-low;
+		bias-pull-down;
+	};
+
+	/*
+	 * The vendor tree names gpio204 as qcom,xo-clk-gpio in both QCA6490
+	 * nodes but configures no pin state for it, so this one follows
+	 * sm8450-hdk.dts to give it a defined level before the sequencer
+	 * pulses it.
+	 */
+	xo_clk_state: xo-clk-state {
+		pins = "gpio204";
+		function = "gpio";
+		drive-strength = <16>;
+		output-low;
+		bias-pull-down;
+	};
+};
+
+&uart7 {
+	status = "okay";
+};
+
+/*
+ * Bluetooth. The QCA6490's HCI transport is a 4-wire UART on QUPv3
+ * wrapper 2's sixth serial engine, which the vendor tree describes at
+ * abl-final-fdt.dts:13795 as qcom,qup_uart@894000 -- the same 0x894000
+ * that sm8450.dtsi calls uart20. Pins are inherited from that .dtsi's
+ * qup_uart20_default, whose cts/rts/tx/rx are gpio76/77/78/79, matching
+ * the vendor's qupv3_se20_4uart_pins (:4148) pin for pin; that node's
+ * wakeup interrupt on gpio79 independently confirms which end is rx.
+ * Do not copy sm8450-hdk.dts's uart20_default override here: it labels
