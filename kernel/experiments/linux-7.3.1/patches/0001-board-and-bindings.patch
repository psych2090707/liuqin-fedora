+/*
+ * Power to the magnetic keyboard's pogo pins, gated by the vendor's vdd_pin
+ * (abl-final-fdt.dts:13288). Nothing describes its voltage: the vendor tree
+ * carries a bare GPIO with no rail behind it, and the bridge chip's supply is
+ * generated on the folio side. startup-delay-us preserves the vendor's 2 ms
+ * rail-to-reset delay.
+ *
+ * Keep the provider under the real simple-bus. ABL applies the vendor dtbo
+ * after the boot image DTB and has already been observed rewriting or dropping
+ * root-level additions, while children of /soc@0 survive in the live FDT.
+ */
+&soc {
+	/*
+	 * Xiaomi ABL consumes the Android restart reason at IMEM + 0x65c.
+	 * The vendor FDT exposes the same 4-byte window below its msm-imem
+	 * container; a direct /soc@0 child survives ABL's later overlay while
+	 * root-level additions do not.
+	 */
+	liuqin_restart_reason: restart-reason@146aa65c {
+		compatible = "qcom,msm-imem-restart_reason";
+		reg = <0x0 0x146aa65c 0x0 0x4>;
+	};
+
+	keyboard_vdd_regulator: regulator-keyboard-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "keyboard_vdd";
+
+		gpio = <&tlmm 62 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <2000>;
+
+		pinctrl-0 = <&kb_vdd_default>;
+		pinctrl-names = "default";
+	};
+
+	/* WCD9385 is the RX/TX SoundWire codec used by the built-in mics. */
+	wcd938x: audio-codec {
+		compatible = "qcom,wcd9385-codec";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wcd_reset_default>;
+
+		qcom,micbias1-microvolt = <2750000>;
+		qcom,micbias2-microvolt = <2750000>;
+		qcom,micbias3-microvolt = <2750000>;
+		qcom,micbias4-microvolt = <2750000>;
+		qcom,mbhc-buttons-vthreshold-microvolt =
+			<75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+		reset-gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&pm8350_s10>;
+		vdd-rxtx-supply = <&pm8350_s10>;
+		vdd-io-supply = <&pm8350_s10>;
+		vdd-mic-bias-supply = <&pm8350c_bob>;
+
+		#sound-dai-cells = <1>;
+	};
+};
+
+&apps_rsc {
+	regulators-0 {
+		compatible = "qcom,pm8350-rpmh-regulators";
+		qcom,pmic-id = "b";
+
+		/* 0.912 V combo-PHY PLL rail (vendor qcom,vdd-voltage-level =
+		 * 0xdea80).  The regulator core applies the constraint minimum,
+		 * so min must be 912000 or the SS PLL runs at 832 mV and the
+		 * SuperSpeed link never comes up. */
+		pm8350_l1: ldo1 {
+			regulator-name = "pm8350_l1";
+			regulator-min-microvolt = <912000>;
+			regulator-max-microvolt = <920000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_s10: smps10 {
+			regulator-name = "pm8350_s10";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		/*
+		 * The WCN6855's Bluetooth and WLAN RF domains are supplied
+		 * from these rails.  The stock DTB sets qcom,init-voltage to
+		 * 952/1256/1880 mV (pm8350_s11, pm8350_s12 and pm8350c_s1);
+		 * this kernel has no qcom,init-voltage support and the
+		 * regulator core programs the low end of the DT range, so
+		 * without the minimums below the chip's PMU sits at 384 mV
+		 * instead of 952 mV and both radios lose ~15 dB of range.
+		 */
+		pm8350_s11: smps11 {
+			regulator-name = "pm8350_s11";
+			regulator-min-microvolt = <952000>;
+			regulator-max-microvolt = <1170000>;
+		};
+
+		pm8350_s12: smps12 {
+			regulator-name = "pm8350_s12";
+			regulator-min-microvolt = <1256000>;
+			regulator-max-microvolt = <2040000>;
+		};
+
+		pm8350_l2: ldo2 {
+			regulator-name = "pm8350_l2";
+			regulator-min-microvolt = <2700000>;
+			regulator-max-microvolt = <3300000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_l5: ldo5 {
+			regulator-name = "pm8350_l5";
+			/* Vendor: HS PHY vdd (qcom,vdd-voltage-level = 0xd6d80)
+			 * and the DP node's vdda_usb-0p9 both run at 880 mV; the
+			 * M31 eUSB2 driver only enables the rail without setting a
+			 * voltage, so the constraint minimum is what the SS/DP
+			 * analog actually gets (720 mV was too low: DP link
+			 * training needed maximum swing and still failed). */
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <958000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_l7: ldo7 {
+			regulator-name = "pm8350_l7";
+			regulator-min-microvolt = <2400000>;
+			regulator-max-microvolt = <3544000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350_l9: ldo9 {
+			regulator-name = "pm8350_l9";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	regulators-1 {
+		compatible = "qcom,pm8350c-rpmh-regulators";
+		qcom,pmic-id = "c";
+		vdd-bob-supply = <&vph_pwr>;
+
+		pm8350c_l1: ldo1 {
+			regulator-name = "pm8350c_l1";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_s1: smps1 {
+			regulator-name = "pm8350c_s1";
+			regulator-min-microvolt = <1880000>;
+			regulator-max-microvolt = <2024000>;
+			regulator-always-on;
+		};
+
+		/* WCD9385 mic-bias rail; the vendor DT uses pm8350c BOB. */
+		pm8350c_bob: bob {
+			regulator-name = "pm8350c_bob";
+			regulator-min-microvolt = <3008000>;
+			regulator-max-microvolt = <3960000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+		};
+
+		/*
+		 * The panel's iovdd. Range copied from the vendor's own
+		 * regulator-pm8350c-l2 (abl-final-fdt.dts:6179-6187,
+		 * phandle 0x301), which qcom,dsi-display-primary names as
+		 * iovdd-supply at :32975.
+		 */
+		pm8350c_l2: ldo2 {
+			regulator-name = "pm8350c_l2";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1980000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/*
+		 * The depth camera's I/O rail.  The vendor's own l4 range is
+		 * 1.62-3.3 V with a 1.8 V default (phandle 0x305); 1.8 V is
+		 * pinned here because nothing else on this board uses l4.
+		 */
+		pm8350c_l4: ldo4 {
+			regulator-name = "pm8350c_l4";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/*
+		 * The wide camera's autofocus rail (the dw9768's vdd/vin).
+		 * Kept always on: the VCM only answers while the sensor
+		 * module is powered anyway (the sensor driver owns the
+		 * module supplies), so gating this rail too would add a
+		 * second power state without buying anything.  The cost is
+		 * the actuator's quiescent draw while the system runs.
+		 *
+		 * Stays at its 3.0 V default: nothing writes the vendor's
+		 * 3.1 V any more, and focus works at 3.0 V.
+		 */
+		pm8350c_l7: ldo7 {
+			regulator-name = "pm8350c_l7";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3544000>;
+			regulator-always-on;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/*
+		 * FPC1264 supply.  Keep the boot/default voltage at 2.96 V
+		 * (the vendor PMIC boot value).  The PLDO table steps by 8 mV,
+		 * so the fingerprint driver requests 3.3-3.304 V only when
+		 * the sensor opens, rather than forcing the higher voltage
+		 * while the kernel establishes boot-time constraints.
+		 */
+		pm8350c_l9: ldo9 {
+			regulator-name = "pm8350c_l9";
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <3304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		pm8350c_l10: ldo10 {
+			regulator-name = "pm8350c_l10";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		ldo12 {
+			regulator-name = "pm8350c_l12";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+
+		ldo13 {
+			regulator-name = "pm8350c_l13";
+			regulator-min-microvolt = <3304000>;
+			regulator-max-microvolt = <3304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-boot-on;
+			regulator-always-on;
+		};
+	};
+
+	regulators-2 {
+		compatible = "qcom,pmr735a-rpmh-regulators";
+		qcom,pmic-id = "e";
+
+		pmr735a_s2: smps2 {
+			regulator-name = "pmr735a_s2";
+			regulator-min-microvolt = <500000>;
+			regulator-max-microvolt = <1040000>;
+			regulator-always-on;
+		};
+	};
+};
+
+/*
+ * CPU capacity and energy model: the four A510s, three A710s and the X2 are
+ * three different cores at three different maximum frequencies (2.016 /
+ * 2.7456 / 3.1872 GHz, the EPSS LUT table qcom-cpufreq-hw reads), and none of
+ * the upstream device trees says so.  arch_topology's fallback is cpu_capacity
+ * 1024 everywhere, SD_ASYM_CPUCAPACITY is then never set (no misfit handling,
+ * no capacity-aware placement) and EAS stays off twice over, because
+ * cpufreq_register_em_with_opp() also wants dynamic-power-coefficient before
+ * it will build a perf domain.
+ *
+ * The numbers are the vendor's own, from the stock runtime device tree's
+ * qcom,kryo nodes (liuqin-audit/evidence/final-runtime.dts): per-MHz DMIPS
+ * ratings and capacitance coefficients.  arch_topology multiplies
+ * capacity-dmips-mhz by each policy's cpuinfo.max_freq, so these values yield
+ * cpu_capacity 278 / 833 / 1024 - the same relative performance the vendor
+ * kernel schedules with.
+ */
+&cpu0 {
+	capacity-dmips-mhz = <1024>;
+	dynamic-power-coefficient = <100>;
+};
+
+&cpu1 {
+	capacity-dmips-mhz = <1024>;
+	dynamic-power-coefficient = <100>;
+};
+
+&cpu2 {
+	capacity-dmips-mhz = <1024>;
+	dynamic-power-coefficient = <100>;
+};
+
+&cpu3 {
+	capacity-dmips-mhz = <1024>;
+	dynamic-power-coefficient = <100>;
+};
+
+&cpu4 {
+	capacity-dmips-mhz = <2253>;
+	dynamic-power-coefficient = <257>;
+};
+
+&cpu5 {
+	capacity-dmips-mhz = <2253>;
+	dynamic-power-coefficient = <257>;
+};
+
+&cpu6 {
+	capacity-dmips-mhz = <2253>;
+	dynamic-power-coefficient = <257>;
+};
+
+&cpu7 {
+	capacity-dmips-mhz = <2386>;
+	dynamic-power-coefficient = <509>;
