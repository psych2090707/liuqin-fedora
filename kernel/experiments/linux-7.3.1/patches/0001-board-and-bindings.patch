diff --git a/Documentation/devicetree/bindings/input/fpc,fpc1020.yaml b/Documentation/devicetree/bindings/input/fpc,fpc1020.yaml
new file mode 100644
index 000000000..6efd584a1
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/fpc,fpc1020.yaml
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+__omp_magic("YAML", "1.2")
+---
+$id: http://devicetree.org/schemas/input/fpc,fpc1020.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: FPC1020-compatible fingerprint sensor control interface
+
+maintainers:
+  - liuqin mainline port <noreply@localhost>
+
+description:
+  Power, reset and interrupt control for an FPC1020-compatible fingerprint
+  sensor.  On the Xiaomi Pad 6 Pro the sensor's SPI bus belongs to the secure
+  world (the OEM trusted application drives it over QSEE's SPI service), so
+  the normal world only controls the supply, the reset line and the finger
+  interrupt; the Linux driver performs no SPI transfers.
+
+properties:
+  compatible:
+    const: fpc,fpc1020
+
+  interrupts:
+    maxItems: 1
+
+  irq-gpios:
+    maxItems: 1
+    description: Active-high finger interrupt line, read for its current level.
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low sensor reset line.
+
+  fp_vdd_vreg-supply:
+    description: Sensor supply (PM8350C LDO9 on the Xiaomi Pad 6 Pro).
+
+  pinctrl-0: true
+  pinctrl-names: true
+
+required:
+  - compatible
+  - interrupts
+  - irq-gpios
+  - reset-gpios
+  - fp_vdd_vreg-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    fingerprint {
+        compatible = "fpc,fpc1020";
+        interrupt-parent = <&tlmm>;
+        interrupts = <40 IRQ_TYPE_EDGE_RISING>;
+        irq-gpios = <&tlmm 40 GPIO_ACTIVE_HIGH>;
+        reset-gpios = <&tlmm 41 GPIO_ACTIVE_LOW>;
+        fp_vdd_vreg-supply = <&pm8350c_l9>;
+    };
+...
diff --git a/Documentation/devicetree/bindings/input/nanosic,wn8030.yaml b/Documentation/devicetree/bindings/input/nanosic,wn8030.yaml
new file mode 100644
index 000000000..04c023193
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/nanosic,wn8030.yaml
@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/nanosic,wn8030.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Nanosic WN8030 detachable keyboard bridge
+
+maintainers:
+  - Erwin <yzddmr7@gmail.com>
+
+description:
+  The Nanosic WN8030 is an I2C bridge chip that connects a detachable magnetic
+  keyboard folio to its host tablet. It is not an HID-over-I2C device; it wraps
+  standard HID input reports for the folio's keyboard, media keys, mouse and
+  touchpad in a private framing, and provides no report descriptors of its own.
+
+properties:
+  compatible:
+    oneOf:
+      - items:
+          - const: xiaomi,liuqin-keyboard
+          - const: nanosic,wn8030
+      - const: nanosic,wn8030
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    minItems: 2
+    maxItems: 2
+
+  interrupt-names:
+    minItems: 2
+    items:
+      - const: data
+      - const: wakeup
+    description: >
+      The data interrupt is asserted when the bridge has HID reports to hand
+      over. The wakeup interrupt is the bridge's status line, asserted to wake
+      the host while the screen is off.
+
+  reset-gpios:
+    maxItems: 1
+    description: Reset line, asserted low.
+
+  wake-gpios:
+    maxItems: 1
+    description:
+      Driven high to keep the bridge running and low to let it sleep. The
+      bridge wakes itself when the keyboard has data, so this line only
+      controls whether the host may talk to it.
+
+  vdd-supply:
+    description: Supply feeding the connector's pogo pins.
+
+  wakeup-source: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-names
+  - reset-gpios
+  - wake-gpios
+  - vdd-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        keyboard@4c {
+            compatible = "xiaomi,liuqin-keyboard", "nanosic,wn8030";
+            reg = <0x4c>;
+
+            interrupts-extended = <&tlmm 50 IRQ_TYPE_EDGE_RISING>,
+                                  <&tlmm 46 IRQ_TYPE_EDGE_RISING>;
+            interrupt-names = "data", "wakeup";
+
+            vdd-supply = <&keyboard_vdd_regulator>;
+            reset-gpios = <&tlmm 83 GPIO_ACTIVE_LOW>;
+            wake-gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
+
+            wakeup-source;
+        };
+    };
