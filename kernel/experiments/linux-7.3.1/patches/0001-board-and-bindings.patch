+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * The charger PD runs on ADSP and publishes PMIC_RTR_ADSP_APPS, exactly
+	 * as the vendor FDT describes. Keep USB role wiring out of this first
+	 * step: battmgr and UCSI may report state, while the already-validated
+	 * DWC3 peripheral gadget remains the only control/data path.
+	 */
+	pmic-glink {
+		compatible = "qcom,sm8475-pmic-glink",
+			     "qcom,sm8450-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+				port@0 {
+					reg = <0>;
+					pmic_glink_hs_in: endpoint { remote-endpoint = <&usb_1_dwc3_hs>; };
+				};
+				port@1 {
+					reg = <1>;
+					pmic_glink_ss_in: endpoint { remote-endpoint = <&usb_1_qmpphy_out>; };
+				};
+				port@2 {
+					reg = <2>;
+					pmic_glink_sbu: endpoint { remote-endpoint = <&fsa4480_sbu_mux>; };
+				};
+			};
+		};
+	};
+
+	reserved-memory {
+		xbl_ramdump_mem: memory@a6b80000 {
+			reg = <0x0 0xa6b80000 0x0 0x280000>;
+			no-map;
+		};
+
+		xbl_sc_mem: memory@a6e00000 {
+			reg = <0x0 0xa6e00000 0x0 0x40000>;
+			no-map;
+		};
+
+		adsp_mem: memory@9fd00000 {
+			reg = <0x0 0x9fd00000 0x0 0x3100000>;
+			no-map;
+		};
+
+		/*
+		 * Zone sizes deliberately match the vendor firmware's own ramoops
+		 * node, so the console zone lands at the same physical address and
+		 * length in both kernels. That makes a failed boot here readable
+		 * from the stock kernel's /sys/fs/pstore afterwards, which is the
+		 * only post-mortem channel this board has: the debug UART is not
+		 * accessible on a retail unit. pstore allocates dmesg, console then
+		 * pmsg in that order, so any extra dmesg record zone would shift
+		 * the console zone and break that compatibility.
+		 */
+		ramoops@a7000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xa7000000 0x0 0x400000>;
+			console-size = <0x200000>;
+			pmsg-size = <0x200000>;
+			no-map;
+		};
+
+		rmtfs_mem: memory@f8700000 {
+			compatible = "qcom,rmtfs-mem";
+			reg = <0x0 0xf8700000 0x0 0x280000>;
+			no-map;
+
+			qcom,client-id = <1>;
+			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
+		};
+
+		/*
+		 * Name this reserved-memory node linux_splash, not splash_region.
+		 * ABL's UpdateSplashMemInfo() then calls DisableDisplay() before
+		 * Linux cold-initializes the panel. With splash_region, ABL keeps
+		 * a live display and 7.3 cannot take it over reliably on a normal
+		 * slot boot; fastboot/RAM boot only worked around it with an
+		 * extra GDM-time OFF/ON.
+		 */
+		linux_splash@b8000000 {
+			reg = <0x0 0xb8000000 0x0 0x2b00000>;
+			no-map;
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * The four CS35L41 speaker amps have no VA-supply / VP-supply in the
+	 * vendor tree the bootloader hands over (abl-final-fdt.dts:13410-13620).
+	 * The rails are hard-wired. Mainline cs35l41_probe() still does a
+	 * regulator_bulk_get() for "VA" and "VP" and will not probe without
+	 * them; these always-on placeholders exist only to satisfy that API.
+	 * They have no GPIO and do not gate hardware. Voltages are the
+	 * datasheet-typical analog / battery rails, not a measured PMIC LDO.
+	 */
+	cs35l41_va: cs35l41-va-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cs35l41_va";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	cs35l41_vp: cs35l41-vp-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cs35l41_vp";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * Power sequencer for the QCA6490 combo chip. It owns the enable
+	 * lines and the shared rails for both radios, so it has to exist
+	 * before either the Bluetooth UART child below or a future WLAN
+	 * endpoint on PCIe RC0 can be powered.
+	 *
+	 * GPIOs and supplies follow the stock device tree supplied by the
+	 * bootloader to the vendor kernel.
+	 * The vendor splits the same hardware across two nodes -- bt_qca6490
+	 * at :1310 and qcom,cnss-qca6490 at :12525 -- which agree on every
+	 * line: wlan-en gpio80 (0x50), bt-en gpio81 (0x51), sw-ctrl gpio82
+	 * (0x52) and xo-clk gpio204 (0xcc), all against phandle 0x3c, which
+	 * is pinctrl@f000000, i.e. TLMM (:1367).
+	 */
+	wcn6855-pmu {
+		compatible = "qcom,wcn6855-pmu";
+
+		pinctrl-0 = <&bt_en_state>, <&wlan_en_state>, <&xo_clk_state>;
+		pinctrl-names = "default";
+
+		wlan-enable-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 81 GPIO_ACTIVE_HIGH>;
+		swctrl-gpios = <&tlmm 82 GPIO_ACTIVE_HIGH>;
+		xo-clk-gpios = <&tlmm 204 GPIO_ACTIVE_HIGH>;
+
+		vddio-supply = <&pm8350_s10>;
+		vddaon-supply = <&pmr735a_s2>;
+		vddpmu-supply = <&pm8350_s11>;
+		vddpmumx-supply = <&pmr735a_s2>;
+		vddpmucx-supply = <&pm8350_s11>;
+		vddrfa0p95-supply = <&pm8350_s11>;
+		vddrfa1p3-supply = <&pm8350_s12>;
+		vddrfa1p9-supply = <&pm8350c_s1>;
+		vddpcie1p3-supply = <&pm8350_s12>;
+		vddpcie1p9-supply = <&pm8350c_s1>;
+
+		regulators {
+			vreg_pmu_rfa_cmn_0p8: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn_0p8";
+			};
+
+			vreg_pmu_aon_0p8: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p8";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p8: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p8";
+			};
+
+			vreg_pmu_btcmx_0p8: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p8";
+			};
+
+			vreg_pmu_pcie_1p8: ldo5 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo6 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_rfa_0p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo8 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p7: ldo9 {
+				regulator-name = "vreg_pmu_rfa_1p7";
+			};
+		};
+	};
+};
