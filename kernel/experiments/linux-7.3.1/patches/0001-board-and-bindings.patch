+/*
+ * Speaker backend only. Vendor waipio-asoc-snd has qcom,wsa-max-devs = <0>
+ * and disables the WSA SoundWire pin states (abl-final-fdt.dts:32346,
+ * :32385-32404); tert_tdm_pinctrl is ok and tert_mi2s_pinctrl is disabled
+ * (:32365-32383). Playback is four CS35L41s on tertiary TDM, not WSA883x.
+ * Pins gpio121/122/123/124 as mi2s2_sck/data0/ws/data1 match that FDT
+ * (:1795-1928) and cupid's TDM pinmux. Do not add WCD, WSA, or firmware-name.
+ *
+ * This is a DPCM backend: q6apm consumes the matching AudioReach topology
+ * qcom/sm8450/Xiaomi-Pad-6-Pro-tplg.bin. The topology and the standard TDM
+ * slot properties below form one atomic dependency; omitting either makes the
+ * PCM unusable. DAPM must not reach DSP1 Preloader: the image has no wmfw.
+ */
+&sound {
+	compatible = "qcom,sm8450-sndcard";
+	model = "Xiaomi-Pad-6-Pro";
+
+	/* Routes for the WCD9385 analog microphone widgets. */
+	audio-routing =
+		"AMIC1", "Analog Mic1",
+		"AMIC1", "MIC BIAS1",
+		"AMIC2", "Analog Mic2",
+		"AMIC2", "MIC BIAS2",
+		"AMIC3", "Analog Mic3",
+		"AMIC3", "MIC BIAS3",
+		"AMIC4", "Analog Mic4",
+		"AMIC4", "MIC BIAS3",
+		"AMIC5", "Analog Mic5",
+		"AMIC5", "MIC BIAS4",
+		"TX SWR_INPUT0", "ADC1_OUTPUT",
+		"TX SWR_INPUT1", "ADC2_OUTPUT",
+		"TX SWR_INPUT0", "ADC3_OUTPUT",
+		"TX SWR_INPUT1", "ADC4_OUTPUT";
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&tert_tdm_clk_active>, <&tert_tdm_ws_active>,
+		    <&tert_tdm_din_active>, <&tert_tdm_dout_active>;
+	pinctrl-1 = <&tert_tdm_clk_sleep>, <&tert_tdm_ws_sleep>,
+		    <&tert_tdm_din_sleep>, <&tert_tdm_dout_sleep>;
+
+	speaker-playback-dai-link {
+		link-name = "Primary Spkr Playback";
+
+		cpu {
+			sound-dai = <&q6apmbedai TERTIARY_TDM_RX_0>;
+			/*
+			 * The liuqin vendor speaker group is 48 kHz, four-channel,
+			 * 24-bit with slots 0..3 active (backend_conf.xml and the
+			 * cape resource manager both say mask 0xf).  S24_LE has a
+			 * 32-bit physical container, and q6apm accepts 16 or 32-bit
+			 * serial slots only, hence four 32-bit TDM slots.
+			 */
+			dai-tdm-slot-num = <4>;
+			dai-tdm-slot-width = <32>;
+			dai-tdm-slot-rx-mask = <1 1 1 1>;
+		};
+
+		platform {
+			sound-dai = <&q6apm>;
+		};
+
+		codec {
+			sound-dai = <&cs35l41_tl 0>, <&cs35l41_tr 0>,
+				    <&cs35l41_br 0>, <&cs35l41_bl 0>;
+		};
+	};
+
+	wcd-playback-dai-link {
+		link-name = "WCD Playback";
+
+		cpu {
+			sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
+		};
+
+		codec {
+			sound-dai = <&wcd938x 0>, <&swr1 0>, <&rxmacro 0>;
+		};
+
+		platform {
+			sound-dai = <&q6apm>;
+		};
+	};
+
+	wcd-capture-dai-link {
+		link-name = "WCD Capture";
+
+		cpu {
+			sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
+		};
+
+		codec {
+			sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>;
+		};
+
+		platform {
+			sound-dai = <&q6apm>;
+		};
+	};
+
+};
+
+&rxmacro {
+	status = "okay";
+};
+
+&txmacro {
+	status = "okay";
+};
+
+&vamacro {
+	vdd-micb-supply = <&pm8350_s10>;
+	qcom,dmic-sample-rate = <600000>;
+	status = "okay";
+};
+
+&swr1 {
+	status = "okay";
+
+	wcd_rx: codec@0,4 {
+		compatible = "sdw20217010d00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+
+	wcd_tx: codec@0,3 {
+		compatible = "sdw20217010d00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <1 1 2 3>;
