+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&vol_up_n>, <&hall_default>;
+		pinctrl-names = "default";
+
+		/*
+		 * One hall switch, a plain TLMM GPIO (vendor hall_key,
+		 * abl-final-fdt.dts gpio_keys): gpio10 closes with the folio lid.
+		 * SW_LID lets logind blank on close.  The second hall (vendor
+		 * hall_key1, gpio23, the folio-folded line) belongs to keyboard@4c
+		 * instead: that bridge driver owns the line and reports
+		 * SW_TABLET_MODE from it plus the bridge's presence, which a plain
+		 * switch node here cannot express - the line reads the same with
+		 * the keyboard deployed and with the folio removed.
+		 */
+		event-hall-lid {
+			label = "Hall Lid";
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			gpios = <&tlmm 10 GPIO_ACTIVE_LOW>;
+			debounce-interval = <150>;
+			wakeup-source;
+		};
