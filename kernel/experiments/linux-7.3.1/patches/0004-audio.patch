@@ -8,6 +8,7 @@
 #include <sound/soc-dapm.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
+#include <sound/cs35l41.h>
 #include <linux/soundwire/sdw.h>
 #include <sound/jack.h>
 #include <linux/input-event-codes.h>
@@ -115,6 +116,9 @@ static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
 	struct snd_soc_dai *codec_dai;
 	struct qcom_snd_tdm_slot_cfg cpu_cfg;
 	struct qcom_snd_tdm_slot_cfg codec_cfg;
+	bool liuqin_speakers = !strcmp(rtd->card->name, "Xiaomi-Pad-6-Pro") &&
+			       cpu_dai->id == TERTIARY_TDM_RX_0;
+	unsigned int codec_fmt = data->priv->codec_dai_fmt;
 	int bclk_freq;
 	int ret;
 	int i;
@@ -130,10 +134,15 @@ static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
 	if (ret && ret != -ENOTSUPP)
 		return ret;
 
-	if (data->priv->codec_dai_fmt) {
+	/* Keep the daily liuqin CS35L41 DSP_A speaker wire format. */
+	if (liuqin_speakers)
+		codec_fmt = SND_SOC_DAIFMT_BC_FC | SND_SOC_DAIFMT_NB_NF |
+			    SND_SOC_DAIFMT_DSP_A;
+
+	if (codec_fmt) {
 		for_each_rtd_codec_dais(rtd, i, codec_dai) {
 			ret = snd_soc_dai_set_fmt(codec_dai,
-						  data->priv->codec_dai_fmt);
+						  codec_fmt);
 			if (ret && ret != -ENOTSUPP)
 				return ret;
 		}
@@ -157,6 +166,16 @@ static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
 		}
 	}
 
+	if (liuqin_speakers) {
+		for_each_rtd_codec_dais(rtd, i, codec_dai) {
+			ret = snd_soc_component_set_sysclk(codec_dai->component,
+						   CS35L41_CLKID_SCLK, 0,
+						   bclk_freq, SND_SOC_CLOCK_IN);
+			if (ret)
+				return ret;
+		}
+	}
+
 	if (data->priv->codec_sysclk_set) {
 		for_each_rtd_codec_dais(rtd, i, codec_dai) {
 			ret = snd_soc_dai_set_sysclk(codec_dai, 0, bclk_freq,
@@ -226,18 +245,34 @@ static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
 
 	rate->min = rate->max = 48000;
-	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
 	channels->min = 2;
 	channels->max = 2;
-	switch (cpu_dai->id) {
-	case TX_CODEC_DMA_TX_0:
-	case TX_CODEC_DMA_TX_1:
-	case TX_CODEC_DMA_TX_2:
-	case TX_CODEC_DMA_TX_3:
-		channels->min = 1;
-		break;
-	default:
-		break;
+	if (of_device_is_compatible(rtd->card->dev->of_node,
+				    "qcom,sm8450-sndcard") &&
+	    cpu_dai->id == TERTIARY_TDM_RX_0) {
+		/*
+		 * liuqin's four CS35L41 speakers use the vendor's 48 kHz,
+		 * 4-channel S24_LE tertiary-TDM group.  Keep the generic
+		 * SC8280XP restrictions for every other TDM backend.
+		 */
+		channels->min = 4;
+		channels->max = 4;
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S24_LE);
+	} else {
+		switch (cpu_dai->id) {
+		case PRIMARY_TDM_RX_0 ... QUINARY_TDM_TX_7:
+			snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+			break;
+		case TX_CODEC_DMA_TX_0:
+		case TX_CODEC_DMA_TX_1:
+		case TX_CODEC_DMA_TX_2:
+		case TX_CODEC_DMA_TX_3:
+			channels->min = 1;
+			break;
+		default:
+			snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+			break;
+		}
 	}
 
 
