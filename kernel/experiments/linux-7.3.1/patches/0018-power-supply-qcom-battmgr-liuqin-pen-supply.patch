+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = qcom_battmgr_pen_props,
+	.num_properties = ARRAY_SIZE(qcom_battmgr_pen_props),
+	.get_property = qcom_battmgr_pen_get_property,
+};
