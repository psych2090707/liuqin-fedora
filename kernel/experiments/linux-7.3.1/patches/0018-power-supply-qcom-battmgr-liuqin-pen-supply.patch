+static int qcom_battmgr_pen_register(struct qcom_battmgr *battmgr)
+{
+	struct power_supply_config cfg = {
+		.drv_data = battmgr,
+		.fwnode = dev_fwnode(battmgr->dev),
+	};
+
+	if (battmgr->pen_psy)
+		return 0;
+
+	battmgr->pen_psy = power_supply_register(battmgr->dev,
+						 &qcom_battmgr_pen_desc, &cfg);
+	if (IS_ERR(battmgr->pen_psy)) {
+		int ret = PTR_ERR(battmgr->pen_psy);
+
+		battmgr->pen_psy = NULL;
+		return ret;
+	}
+
+	return 0;
+}
+
+static void qcom_battmgr_pen_unregister(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	if (battmgr->pen_psy) {
+		power_supply_unregister(battmgr->pen_psy);
+		battmgr->pen_psy = NULL;
+	}
+}
