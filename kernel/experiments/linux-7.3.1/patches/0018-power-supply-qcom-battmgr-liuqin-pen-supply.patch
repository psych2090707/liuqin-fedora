+static void qcom_battmgr_pen_work(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr,
+						    pen_work.work);
+	struct qcom_battmgr_pen pen = {};
+	bool changed;
+	int ret;
+
+	if (!battmgr->service_up)
+		return;
+
+	ret = qcom_battmgr_pen_read(battmgr, &pen);
+	if (!ret) {
+		if (pen.present && !battmgr->pen_psy) {
+			int reg = qcom_battmgr_pen_register(battmgr);
+
+			if (reg)
+				dev_err_once(battmgr->dev,
+					     "failed to register pen power supply: %d\n",
+					     reg);
+		}
+		changed = !battmgr->pen.valid ||
+			  battmgr->pen.present != pen.present ||
+			  battmgr->pen.charging != pen.charging ||
+			  battmgr->pen.soc != pen.soc;
+		battmgr->pen = pen;
+		if (changed && battmgr->pen_psy)
+			power_supply_changed(battmgr->pen_psy);
+	}
+
+	/*
+	 * The vendor firmware sends NOTIF_XM_PROPERTY on hall/charging changes,
+	 * so the normal path is event driven.  Keep a slow fallback (60 s while
+	 * the pen is present, 5 min otherwise) so a missed notification cannot
+	 * hide the pen forever.  This is far cheaper than a permanent 10 s poll
+	 * and does not create a suspend wakeup source.
+	 */
+	schedule_delayed_work(&battmgr->pen_work,
+			      msecs_to_jiffies((battmgr->pen.present ||
+						battmgr->pen.charging) ?
+					       60000 : 300000));
+}
+
+static int qcom_battmgr_pen_get_property(struct power_supply *psy,
+					 enum power_supply_property psp,
+					 union power_supply_propval *val)
+{
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+	struct qcom_battmgr_pen *pen = &battmgr->pen;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = pen->present;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		/*
+		 * pen_soc keeps its last value after the pen is removed or placed
+		 * wrong.  Only expose it when the firmware identifies the pen
+		 * (MAC retained) or power transfer is actually active.
+		 */
+		if (!pen->valid || pen->soc > 100 ||
+		    (!pen->charging && !pen->mac_l && !pen->mac_h))
+			return -ENODATA;
+		val->intval = pen->soc;
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		if (pen->charging)
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else if (pen->present && pen->soc >= 100 &&
+			 (pen->mac_l || pen->mac_h))
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+		else if (pen->present)
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "Xiaomi Smart Pen";
+		break;
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = "Xiaomi";
+		break;
+	case POWER_SUPPLY_PROP_SCOPE:
+		val->intval = POWER_SUPPLY_SCOPE_DEVICE;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
