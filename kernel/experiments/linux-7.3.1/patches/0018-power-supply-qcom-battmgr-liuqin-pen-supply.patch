+static int qcom_battmgr_pen_read(struct qcom_battmgr *battmgr,
+				 struct qcom_battmgr_pen *pen)
+{
+	u32 mac_l, mac_h, hall3, hall4, soc, iout, state;
+	int ret;
+
+	if (!battmgr->service_up)
+		return -EAGAIN;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_xm_get_value_locked(battmgr, XM_PEN_MAC_L, &mac_l);
+	if (!ret)
+		ret = qcom_battmgr_xm_get_value_locked(battmgr, XM_PEN_MAC_H, &mac_h);
+	if (!ret)
+		ret = qcom_battmgr_xm_get_value_locked(battmgr, XM_PEN_HALL3, &hall3);
+	if (!ret)
+		ret = qcom_battmgr_xm_get_value_locked(battmgr, XM_PEN_HALL4, &hall4);
+	if (!ret)
+		ret = qcom_battmgr_xm_get_value_locked(battmgr, XM_PEN_SOC, &soc);
+	if (!ret)
+		ret = qcom_battmgr_xm_get_value_locked(battmgr, XM_PEN_TX_IOUT, &iout);
+	if (!ret)
+		ret = qcom_battmgr_xm_get_value_locked(battmgr, XM_REVERSE_CHG_STATE, &state);
+	mutex_unlock(&battmgr->lock);
+
+	if (ret)
+		return ret;
+
+	pen->mac_l = mac_l;
+	pen->mac_h = mac_h;
+	pen->hall3 = hall3;
+	pen->hall4 = hall4;
+	pen->soc = soc;
+	pen->iout = iout;
+	pen->state = state;
+	/*
+	 * The two hall sensors only prove that a magnet is nearby.  A reversed
+	 * or sideways pen can trigger them without any power transfer, so the
+	 * charging decision must come from the reverse-charging state and TX
+	 * current.  The MAC is retained by the firmware while the pen is docked
+	 * (including a full pen that has stopped charging) and clears when the
+	 * pen is removed or placed wrong.
+	 */
+	pen->present = mac_l || mac_h || hall3 == 0 || hall4 == 0;
+	pen->charging = state == 4 && iout > 0;
+	pen->valid = true;
+
+	return 0;
+}
