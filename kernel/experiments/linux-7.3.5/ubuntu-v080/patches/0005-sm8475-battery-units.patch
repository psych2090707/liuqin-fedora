From: seeker <gmx472@qq.com>
Subject: [PATCH] fix(power): correct SM8475 battery telemetry units

Select charge-domain properties for SM8475 without depending on BAT_INFO,
convert its remaining-charge counter from mAh to uAh with overflow checking,
and expose charge_now. Preserve full and design charge, already in uAh.

Omit the firmware power placeholder and unverified time estimates so
userspace can derive estimates from measured charge, current and voltage.

Link: https://github.com/Seeker0472/liuqin-nixos/commit/1944c8474de8e78c5f10b9e9b8af05e08f7fbcfd
[ported to the 6.17 driver: only the qcom_battmgr.c hunks of the merged
 pkgs/kernel/patches/0005 patch. 6.17 has no STATE_OF_HEALTH or
 INTERNAL_RESISTANCE battery property, so the SM8475 list is the SM8350
 list without POWER_NOW and the two time estimates, plus CHARGE_NOW. The
 flake check is replaced by the KUnit suite later in this series]
Liuqin-upstream: https://github.com/yzddmr6/linux-sm8450-liuqin/commit/787d0f7bf9669ab3a40e07cbb38e809e33e9d7c6

Liuqin Fedora port: preserve other SoC variants and the resistance/health fields available in 7.3.
---
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -11,6 +11,7 @@
 #include <linux/mutex.h>
 #include <linux/nvmem-consumer.h>
 #include <linux/of_device.h>
+#include <linux/overflow.h>
 #include <linux/workqueue.h>
 #include <linux/pm.h>
 #include <linux/power_supply.h>
@@ -1174,6 +1175,7 @@
 	[POWER_SUPPLY_PROP_TEMP] = BATT_TEMP,
 	[POWER_SUPPLY_PROP_TECHNOLOGY] = BATT_TECHNOLOGY,
 	[POWER_SUPPLY_PROP_CHARGE_COUNTER] =  BATT_CHG_COUNTER,
+	[POWER_SUPPLY_PROP_CHARGE_NOW] = BATT_CHG_COUNTER,
 	[POWER_SUPPLY_PROP_CYCLE_COUNT] = BATT_CYCLE_COUNT,
 	[POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN] =  BATT_CHG_FULL_DESIGN,
 	[POWER_SUPPLY_PROP_CHARGE_FULL] = BATT_CHG_FULL,
@@ -1264,6 +1266,20 @@
 	return ret;
 }
 
+static int qcom_battmgr_bat_charge_counter(struct qcom_battmgr *battmgr,
+					   union power_supply_propval *val)
+{
+	s32 counter = battmgr->info.charge_count;
+
+	/* The M81 counter is in mAh; its full and design charge are in uAh. */
+	if (battmgr->variant == QCOM_BATTMGR_SM8475 &&
+	    check_mul_overflow(counter, MILLI, &counter))
+		return -ERANGE;
+
+	val->intval = counter;
+	return 0;
+}
+
 static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 					 enum power_supply_property psp,
 					 union power_supply_propval *val)
@@ -1274,6 +1290,15 @@
 
 	if (!battmgr->service_up)
 		return -EAGAIN;
+
+	if (battmgr->variant == QCOM_BATTMGR_SM8475) {
+		/* No BAT_INFO reply sets the units for this variant. */
+		unit = QCOM_BATTMGR_UNIT_mAh;
+		if (psp == POWER_SUPPLY_PROP_POWER_NOW ||
+		    psp == POWER_SUPPLY_PROP_TIME_TO_EMPTY_AVG ||
+		    psp == POWER_SUPPLY_PROP_TIME_TO_FULL_AVG)
+			return -ENODATA;
+	}
 
 	if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
 	    battmgr->variant == QCOM_BATTMGR_X1E80100)
@@ -1341,11 +1366,12 @@
 	case POWER_SUPPLY_PROP_CHARGE_NOW:
 		if (unit != QCOM_BATTMGR_UNIT_mAh)
 			return -ENODATA;
+		if (battmgr->variant == QCOM_BATTMGR_SM8475)
+			return qcom_battmgr_bat_charge_counter(battmgr, val);
 		val->intval = battmgr->status.capacity;
 		break;
 	case POWER_SUPPLY_PROP_CHARGE_COUNTER:
-		val->intval = battmgr->info.charge_count;
-		break;
+		return qcom_battmgr_bat_charge_counter(battmgr, val);
 	case POWER_SUPPLY_PROP_ENERGY_FULL_DESIGN:
 		if (unit != QCOM_BATTMGR_UNIT_mWh)
 			return -ENODATA;
@@ -1650,6 +1676,37 @@
 	.type = POWER_SUPPLY_TYPE_BATTERY,
 	.properties = sm8350_bat_props,
 	.num_properties = ARRAY_SIZE(sm8350_bat_props),
+	.get_property = qcom_battmgr_bat_get_property,
+};
+
+/* Report measured charge instead of unverified power and time estimates. */
+static const enum power_supply_property sm8475_bat_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_CHARGE_COUNTER,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_CYCLE_COUNT,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+	POWER_SUPPLY_PROP_INTERNAL_RESISTANCE,
+	POWER_SUPPLY_PROP_STATE_OF_HEALTH,
+};
+
+static const struct power_supply_desc sm8475_bat_psy_desc = {
+	.name = "qcom-battmgr-bat",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = sm8475_bat_props,
+	.num_properties = ARRAY_SIZE(sm8475_bat_props),
 	.get_property = qcom_battmgr_bat_get_property,
 };
 
@@ -3113,6 +3170,8 @@
 	} else {
 		if (battmgr->variant == QCOM_BATTMGR_SM8550)
 			psy_desc = &sm8550_bat_psy_desc;
+		else if (battmgr->variant == QCOM_BATTMGR_SM8475)
+			psy_desc = &sm8475_bat_psy_desc;
 		else
 			psy_desc = &sm8350_bat_psy_desc;
 
