class Lock:
    def __init__(self, path: Path, wait_ms: int = 0):
        self.path = path
        self.wait_ms = wait_ms
        self.handle = None

    def __enter__(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.handle = self.path.open("a+")
        deadline = time.monotonic() + self.wait_ms / 1000.0
        while True:
            try:
                fcntl.flock(self.handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError as error:
                if error.errno in (errno.EAGAIN, errno.EACCES):
                    if time.monotonic() >= deadline:
                        self.handle.close()
                        self.handle = None
                        raise BusyError(f"another apply/rollback holds {self.path}")
                    time.sleep(0.05)
                else:
                    self.handle.close()
                    self.handle = None
                    raise
        self.handle.seek(0)
        self.handle.truncate()
        self.handle.write(f"{os.getpid()} {now()}\n")
        self.handle.flush()
        os.fsync(self.handle.fileno())
        hold = env_int("LIUQIN_APPLY_TEST_HOLD_LOCK_MS")
        if hold > 0:
            time.sleep(hold / 1000.0)
        return self

    def __exit__(self, *exc):
        if self.handle is not None:
            try:
                fcntl.flock(self.handle.fileno(), fcntl.LOCK_UN)
            finally:
                self.handle.close()
                self.handle = None


def journal_path(staging_dir: Path) -> Path:
    return staging_dir / "apply-state.json"


def read_journal(staging_dir: Path) -> dict:
    data = read_json(journal_path(staging_dir))
    return data if isinstance(data, dict) else {}


def write_journal(staging_dir: Path, **fields) -> dict:
    state = read_journal(staging_dir)
    state.update(fields)
    state.setdefault("schema", 1)
    state["updated_at"] = now()
    atomic_write_json(journal_path(staging_dir), state)
    return state


def make_backup(device: Path, backup_dir: Path, original_sha: str,
                prefix: str = "boot_a") -> Path:
    backup_dir.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    final = backup_dir / f"{prefix}-{stamp}-{original_sha[:12]}.img"
    tmp = final.with_name(final.name + ".tmp")
    digest = hashlib.sha256()
    total = 0
    with device.open("rb", buffering=0) as source, tmp.open("wb") as target:
        while True:
            chunk = source.read(CHUNK)
            if not chunk:
                break
            total += len(chunk)
            digest.update(chunk)
            target.write(chunk)
        target.flush()
        os.fsync(target.fileno())
    if total != PARTITION_BYTES:
        tmp.unlink(missing_ok=True)
        raise WriteFailed(f"backup read {total} bytes from {device}, expected {PARTITION_BYTES}")
    if digest.hexdigest() != original_sha:
        tmp.unlink(missing_ok=True)
        raise WriteFailed("boot_a changed while it was being backed up (sha256 mismatch)")
    os.replace(tmp, final)
    fsync_path(backup_dir)
    if sha256_file(final) != original_sha:
        raise WriteFailed(f"backup read-back verification failed: {final}")
    return final


def prune_backups(backup_dir: Path, prefix: str = "boot_a") -> list:
    backups = sorted(backup_dir.glob(f"{prefix}-*.img"), key=lambda path: path.name)
    removed = []
    for path in backups[:-BACKUP_RETENTION]:
        removed.append(str(path))
        path.unlink(missing_ok=True)
    return removed


def write_padded_image(image: BootImage, work_dir: Path) -> Path:
    work_dir.mkdir(parents=True, exist_ok=True)
    target = work_dir / "boot-padded.img"
    with image.path.open("rb") as source, target.open("wb") as out:
        while True:
            chunk = source.read(CHUNK)
            if not chunk:
                break
            out.write(chunk)
        remaining = PARTITION_BYTES - image.file_bytes
        zeros = bytes(CHUNK)
        while remaining > 0:
            block = min(CHUNK, remaining)
            out.write(zeros[:block])
            remaining -= block
        out.flush()
        os.fsync(out.fileno())
    fsync_path(work_dir)
    return target


