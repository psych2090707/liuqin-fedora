def check_devices(device_a: Path, device_b: Path, *, journal: dict,
                  allow_missing_boot_b: bool,
                  allow_differing_boot_b: bool) -> dict:
    """Validate boot_a and the bootloader fallback copy in boot_b.

    Upstream liuqin semantics (device/gnome-overlay/usr/local/sbin/liuqin-switch,
    tools/install-liuqin.py): only boot_a is ever written after install; boot_b
    keeps a copy of the boot image the bootloader falls back to when boot_a
    does not load.  install-liuqin.py writes the same project image to boot_a
    and boot_b.  Therefore after the FIRST explicit update boot_a != boot_b is
    the normal state — requiring equality forever made continuous updates
    unusable.  A differing boot_b is accepted when it is (a) byte-identical to
    boot_a, or (b) byte-identical to the fallback recorded by a previous
    apply/confirm AND still a parseable liuqin boot image.  An unknown boot_b
    is refused unless the operator explicitly overrides (--allow-differing-boot-b)
    or re-establishes it with `liuqin-apply-boot confirm` after a successful
    boot.  Nothing here writes boot_b.
    """
    require_test_regular_file(device_a)
    if device_kind(device_a) not in ("block", "regular"):
        raise Refused(f"boot_a device not found: {device_a}")
    size_a = device_size(device_a)
    if size_a != PARTITION_BYTES:
        raise Refused(f"unexpected boot_a partition size: {size_a} (expected {PARTITION_BYTES})")
    result = {"device_a": str(device_a), "size_a": size_a, "sha256_a": None,
              "device_b": str(device_b), "size_b": None, "sha256_b": None,
              "boot_b_state": None, "boot_b_is_image": False,
              "fallback_sha256": None, "warnings": []}
    sha_a = sha256_device(device_a)
    result["sha256_a"] = sha_a
    if device_kind(device_b) not in ("block", "regular"):
        if not allow_missing_boot_b:
            raise Refused(
                f"boot_b device not found: {device_b}; it is the bootloader fallback. "
                f"Refusing to write without a fallback (override: --allow-missing-boot-b)")
        result["boot_b_state"] = "missing (explicitly allowed)"
        result["warnings"].append("boot_b is missing; no bootloader fallback exists")
        return result
    require_test_regular_file(device_b)
    size_b = device_size(device_b)
    if size_b != PARTITION_BYTES:
        raise Refused(f"unexpected boot_b partition size: {size_b} (expected {PARTITION_BYTES})")
    result["size_b"] = size_b
    sha_b = sha256_device(device_b)
    result["sha256_b"] = sha_b
    fallback_sections = payload_sections(device_b)
    result["boot_b_is_image"] = fallback_sections is not None
    recorded = {journal.get("fallback_sha256"), journal.get("boot_b_sha256")}
    recorded.discard(None)
    if sha_a == sha_b:
        result["boot_b_state"] = "identical to boot_a (install-time fallback invariant)"
        result["fallback_sha256"] = sha_b
        if fallback_sections is None:
            result["warnings"].append(
                "boot_b is identical to boot_a but is not a parseable v2 boot image")
        return result
    if fallback_sections is not None and sha_b in recorded:
        result["boot_b_state"] = (
            "differs from boot_a but is the recorded known-good fallback "
            "(normal state after an explicit update)")
        result["fallback_sha256"] = sha_b
        return result
    detail = ("a recorded fallback" if sha_b in recorded else "not a recorded fallback")
    result["boot_b_state"] = (
        f"differs from boot_a and is {detail} "
        f"(parseable boot image: {'yes' if fallback_sections is not None else 'no'})")
    if allow_differing_boot_b:
        result["boot_b_state"] += " (explicit override)"
        result["warnings"].append(
            "boot_b differs from boot_a and is not a recorded known-good fallback; "
            "explicit override accepted")
        result["fallback_sha256"] = sha_b if fallback_sections is not None else None
        return result
    raise Refused(
        "boot_b differs from boot_a and is not the fallback recorded by a previous "
        "apply/confirm, so the bootloader fallback copy cannot be trusted. This is "
        "NOT the normal state after an update (a recorded known-good fallback is "
        "accepted automatically). Options: (1) after the currently running image has "
        "booted successfully, run `liuqin-apply-boot confirm --yes-write` to re-sync "
        "boot_b from boot_a; (2) inspect boot_b and pass --allow-differing-boot-b if "
        "you know what it contains")


def write_device(device: Path, source: Path) -> None:
    abort_after = env_int("LIUQIN_APPLY_TEST_ABORT_WRITE_AFTER")
    written = 0
    with device.open("r+b", buffering=0) as target, source.open("rb") as stream:
        while True:
            chunk = stream.read(CHUNK)
            if not chunk:
                break
            if abort_after and written + len(chunk) > abort_after:
                partial = chunk[:abort_after - written]
                target.write(partial)
                written += len(partial)
                raise PowerLossSimulated(
                    f"test hook: simulated power loss after {written} bytes")
            target.write(chunk)
            written += len(chunk)
        if written != PARTITION_BYTES:
            raise WriteFailed(f"wrote {written} bytes, expected {PARTITION_BYTES}")
        os.fsync(target.fileno())


def readback_matches(device: Path, expected_sha: str) -> tuple:
    corrupt = os.environ.get("LIUQIN_APPLY_TEST_READBACK_CORRUPT", "")
    actual = sha256_device(device)
    if corrupt in ("always", "after-write"):
        if corrupt == "after-write":
            os.environ.pop("LIUQIN_APPLY_TEST_READBACK_CORRUPT", None)
        log("test hook: simulating a corrupted read-back")
        actual = "0" * 64
    return actual == expected_sha, actual


def restore_backup(device: Path, backup: Path, backup_sha: str) -> tuple:
    log(f"restoring the original boot_a from {backup}")
    try:
        with backup.open("rb") as stream, device.open("r+b", buffering=0) as target:
            while True:
                chunk = stream.read(CHUNK)
                if not chunk:
                    break
                target.write(chunk)
            os.fsync(target.fileno())
        actual = sha256_device(device)
        return actual == backup_sha, actual
    except OSError as error:
        log(f"automatic restore failed: {error}")
        return False, ""


def recovery_commands(device: Path, backup, backup_sha) -> list:
    commands = [
        f"{TOOL} status --json",
        f"{TOOL} recover --yes-write   # restore the last verified backup",
    ]
    if backup is not None:
        commands.append(
            f"dd if={backup} of={device} bs=1M conv=fsync status=progress  # manual restore")
        if backup_sha:
            commands.append(f"sha256sum {backup}   # expected {backup_sha}")
    return commands


