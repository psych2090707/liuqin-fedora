def env_int(name: str, default: int = 0) -> int:
    raw = os.environ.get(name, "")
    if not raw:
        return default
    try:
        return int(raw, 10)
    except ValueError as error:
        raise Refused(f"{name} is not an integer: {raw}") from error


# ---------------------------------------------------------------------------
# hashing / IO helpers
# ---------------------------------------------------------------------------


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(CHUNK), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha256_device(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb", buffering=0) as stream:
        while True:
            chunk = stream.read(CHUNK)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def fsync_path(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | (os.O_DIRECTORY if path.is_dir() else 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    payload = json.dumps(data, indent=2, sort_keys=True) + "\n"
    with tmp.open("w") as stream:
        stream.write(payload)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(tmp, path)
    fsync_path(path.parent)


def read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def device_kind(path: Path) -> str:
    try:
        mode = path.stat().st_mode
    except OSError:
        return "missing"
    if stat.S_ISBLK(mode):
        return "block"
    if stat.S_ISREG(mode):
        return "regular"
    return "other"


def device_size(path: Path) -> int:
    kind = device_kind(path)
    if kind == "block":
        try:
            result = subprocess.run(["blockdev", "--getsize64", str(path)],
                                    text=True, capture_output=True, check=False)
            return int(result.stdout.strip() or 0)
        except (OSError, ValueError):
            return 0
    if kind == "regular":
        try:
            return path.stat().st_size
        except OSError:
            return 0
    return 0


def require_test_regular_file(path: Path) -> None:
    if device_kind(path) == "regular" and os.environ.get("LIUQIN_APPLY_ALLOW_REGULAR_FILE") != "1":
        raise Refused(
            f"{path} is a regular file, not a block device; refusing "
            f"(test hook: LIUQIN_APPLY_ALLOW_REGULAR_FILE=1)")


# ---------------------------------------------------------------------------
# boot metadata schema v2 (single producer/consumer implementation)
# ---------------------------------------------------------------------------


_METADATA_MODULE = None


def metadata_module():
    """Load kernel/fedora/liuqin_boot_metadata.py (the single schema impl).

    Both the kernel-install hook and this tool use the same file; a device
    installs it at /usr/lib/liuqin/liuqin_boot_metadata.py.  Tests may point
    LIUQIN_BOOT_METADATA_MODULE at the repo copy explicitly.
    """
    global _METADATA_MODULE
    if _METADATA_MODULE is not None:
        return _METADATA_MODULE
    candidates = []
    override = os.environ.get("LIUQIN_BOOT_METADATA_MODULE")
    if override:
        candidates.append(Path(override))
    here = Path(__file__).resolve().parent
    candidates.extend([
        here / "liuqin_boot_metadata.py",
        here.parent / "lib" / "liuqin" / "liuqin_boot_metadata.py",
        Path(DEFAULT_METADATA_MODULE),
    ])
    for candidate in candidates:
        if candidate.is_file():
            try:
                spec = importlib.util.spec_from_file_location(
                    "liuqin_boot_metadata", candidate)
                module = importlib.util.module_from_spec(spec)
                assert spec and spec.loader
                sys.modules["liuqin_boot_metadata"] = module
                spec.loader.exec_module(module)
            except (OSError, ImportError) as error:
                raise Refused(
                    f"cannot load the boot metadata schema implementation "
                    f"{candidate}: {error}") from error
            _METADATA_MODULE = module
            return module
    raise Refused(
        "boot metadata schema implementation is missing "
        f"(looked for {DEFAULT_METADATA_MODULE}; provided by kernel-liuqin; "
        "override with LIUQIN_BOOT_METADATA_MODULE)")


def load_staged_metadata(path: Path) -> dict:
    metadata = metadata_module().load_boot_metadata(path)
    metadata["metadata_path"] = str(path)
    return metadata


def payload_sections(path: Path):
    """(kernel Image sha256, ramdisk sha256, final DTB sha256) of a boot image
    or whole padded boot partition; None when the bytes are not a v2 image."""
    try:
        sections = metadata_module().boot_image_sections(Path(path))
    except metadata_module().MetadataError:
        return None
    return {"kernel_image_sha256": sections["kernel_image_sha256"],
            "kernel_gzip_sha256": sections["kernel_gzip_sha256"],
            "ramdisk_sha256": sections["ramdisk_sha256"],
            "dtb_sha256": sections["dtb_sha256"],
            "file_bytes": sections["file_bytes"]}


def kernel_build_info_file() -> Path:
    return Path(os.environ.get("LIUQIN_KERNEL_BUILD_INFO", DEFAULT_KERNEL_BUILD_INFO))


def installed_vmlinuz(modules_dir: Path, release: str) -> Path:
    return modules_dir / release / "vmlinuz"


def installed_pair_id(modules_dir: Path, release: str) -> tuple:
    """The installed kernel pair identity: sha256 of the running kernel Image.

    Returns (pair_id, source) where source is "vmlinuz" or "kernel-build-info",
    and validates the two agree when both are available (fail closed).
    """
    vmlinuz = installed_vmlinuz(modules_dir, release)
    if not vmlinuz.is_file():
        raise ValidationFailed(f"installed kernel Image missing: {vmlinuz}")
    vmlinuz_sha = sha256_file(vmlinuz)
    build_info = kernel_build_info_file()
    if build_info.is_file():
        data = read_json(build_info)
        if not isinstance(data, dict):
            raise ValidationFailed(f"cannot parse {build_info}")
        recorded = ((data.get("artifacts") or {}).get("dist/Image") or {}).get("sha256")
        if recorded and recorded != vmlinuz_sha:
            raise ValidationFailed(
                f"installed kernel identity is inconsistent: {build_info} records "
                f"Image {recorded} but {vmlinuz} is {vmlinuz_sha}")
        if recorded:
            return recorded, "kernel-build-info"
    return vmlinuz_sha, "vmlinuz"


def pair_tool() -> Path:
    candidates = []
    override = os.environ.get("LIUQIN_KERNEL_PAIR_TOOL")
    if override:
        candidates.append(Path(override))
    here = Path(__file__).resolve().parent
    candidates.extend([here / "liuqin-kernel-pair", Path(DEFAULT_PAIR_TOOL)])
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise Refused(
        "kernel pair tool is missing (liuqin-kernel-pair; provided by kernel-liuqin; "
        "override with LIUQIN_KERNEL_PAIR_TOOL)")


def run_pair_tool(arguments: list, timeout: int = 900) -> subprocess.CompletedProcess:
    tool = pair_tool()
    env = dict(os.environ)
    return subprocess.run([sys.executable, str(tool), *map(str, arguments)],
                          text=True, capture_output=True, env=env, timeout=timeout)


def pair_find_by_kernel_image(kernel_image_sha: str) -> tuple:
    """(pair_id_or_None, pair_dir_or_None) for an archived kernel pair."""
    if not kernel_image_sha:
        return None, None
    result = run_pair_tool(["find", "--kernel-image-sha", kernel_image_sha, "--json"])
    if result.returncode != 0:
        return None, None
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None, None
    if not data.get("pair_id"):
        return None, None
    return data["pair_id"], data.get("path")


# ---------------------------------------------------------------------------
# Android boot image v2 header
# ---------------------------------------------------------------------------


class BootImage:
    def __init__(self, path: Path, **fields):
        self.path = path
        self.__dict__.update(fields)

    def summary(self) -> dict:
        return {
            "path": str(self.path),
            "file_bytes": self.file_bytes,
            "sha256": self.sha256,
            "header_version": self.header_version,
            "page_size": self.page_size,
            "kernel_size": self.kernel_size,
            "ramdisk_size": self.ramdisk_size,
            "second_size": self.second_size,
            "recovery_dtbo_size": self.recovery_dtbo_size,
            "dtb_size": self.dtb_size,
            "dtb_addr": f"{self.dtb_addr:#x}",
            "dtb_offset": self.dtb_offset,
            "padded_partition_sha256": self.padded_sha256,
        }


def _u32(data: bytes, offset: int) -> int:
    return struct.unpack_from("<I", data, offset)[0]


def _align(value: int, page_size: int) -> int:
    return (value + page_size - 1) // page_size * page_size


def parse_boot_image(path: Path) -> BootImage:
    if not path.is_file():
        raise ValidationFailed(f"staged image not found: {path}")
    size = path.stat().st_size
    if size == 0:
        raise ValidationFailed(f"staged image is empty: {path}")
    with path.open("rb") as stream:
        data = stream.read(BOOT_V2_HEADER_SIZE)
    if len(data) < BOOT_V2_HEADER_SIZE:
        raise ValidationFailed(f"{path}: {size} bytes is smaller than a boot v2 header")
    if data[:8] != BOOT_MAGIC:
        raise ValidationFailed(f"{path}: Android boot magic missing (got {data[:8]!r})")
    page_size = _u32(data, BOOT_FIELD["page_size"])
    header_version = _u32(data, BOOT_FIELD["header_version"])
    header_size = _u32(data, BOOT_FIELD["header_size"])
    kernel_size = _u32(data, BOOT_FIELD["kernel_size"])
    ramdisk_size = _u32(data, BOOT_FIELD["ramdisk_size"])
    second_size = _u32(data, BOOT_FIELD["second_size"])
    recovery_dtbo_size = _u32(data, BOOT_FIELD["recovery_dtbo_size"])
    dtb_size = _u32(data, BOOT_FIELD["dtb_size"])
    dtb_addr = struct.unpack_from("<Q", data, BOOT_FIELD["dtb_addr"])[0]
    if header_version != 2:
        raise ValidationFailed(f"{path}: boot header version {header_version}, expected 2")
    if header_size != BOOT_V2_HEADER_SIZE:
        raise ValidationFailed(f"{path}: header_size {header_size}, expected {BOOT_V2_HEADER_SIZE}")
    if page_size != 4096:
        raise ValidationFailed(f"{path}: page size {page_size}, expected 4096")
    if kernel_size == 0 or ramdisk_size == 0:
        raise ValidationFailed(f"{path}: kernel/ramdisk size is zero")
    if dtb_size == 0:
        raise ValidationFailed(f"{path}: no DTB in the boot image (v2 requires one)")
    dtb_offset = _align(header_size, page_size) + _align(kernel_size, page_size) + \
        _align(ramdisk_size, page_size) + _align(second_size, page_size) + \
        _align(recovery_dtbo_size, page_size)
    if dtb_offset + dtb_size > size:
        raise ValidationFailed(
            f"{path}: DTB section [{dtb_offset}, {dtb_offset + dtb_size}) exceeds the image")
    if size > PARTITION_BYTES:
        raise ValidationFailed(
            f"{path}: image is {size} bytes, larger than the {PARTITION_BYTES}-byte boot partition")
    image = BootImage(
        path=path, file_bytes=size, sha256=sha256_file(path),
        page_size=page_size, header_version=header_version,
        kernel_size=kernel_size, ramdisk_size=ramdisk_size,
        second_size=second_size, recovery_dtbo_size=recovery_dtbo_size,
        dtb_size=dtb_size, dtb_addr=dtb_addr, dtb_offset=dtb_offset,
        padded_sha256="")
    image.padded_sha256 = padded_digest(image)
    return image


def padded_digest(image: BootImage) -> str:
    """sha256 of (image bytes + zero padding to the whole 192 MiB partition)."""
    digest = hashlib.sha256()
    with image.path.open("rb") as stream:
        while True:
            chunk = stream.read(CHUNK)
            if not chunk:
                break
            digest.update(chunk)
    remaining = PARTITION_BYTES - image.file_bytes
    zeros = bytes(CHUNK)
    while remaining > 0:
        block = min(CHUNK, remaining)
        digest.update(zeros[:block])
        remaining -= block
    return digest.hexdigest()


# ---------------------------------------------------------------------------
# staging / identity gate
# ---------------------------------------------------------------------------


def staging_paths(image: Path, staging_dir: Path) -> dict:
    base = image.name[:-4] if image.name.endswith(".img") else image.name
    return {
        "manifest": staging_dir / f"{base}.manifest",
        "build_info": staging_dir / f"{base}.build-info.json",
        "sums": staging_dir / f"{base}.SHA256SUMS",
        "stage_record": staging_dir / f"{base}.stage.json",
    }


def parse_manifest(path: Path) -> dict:
    values = {}
    for line in path.read_text().splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip()
    return values


def root_layout() -> dict:
    override_marker = os.environ.get("LIUQIN_APPLY_ROOT_MARKER")
    override_contract = os.environ.get("LIUQIN_APPLY_ROOT_CONTRACT")
    candidates = []
    if override_marker:
        candidates.append(("override", Path(override_marker),
                           Path(override_contract) if override_contract else None,
                           None, None))
    candidates.extend(ROOT_MARKERS)
    for name, marker, contract, header, content in candidates:
        if not marker.is_file():
            continue
        result = {"profile": name, "marker": str(marker),
                  "contract": str(contract) if contract else None,
                  "marker_content": None, "contract_header": None, "problems": []}
        try:
            result["marker_content"] = marker.read_text()
        except OSError as error:
            result["problems"].append(f"cannot read marker: {error}")
        if content is not None and result["marker_content"] != content:
            result["problems"].append(
                f"marker content {result['marker_content']!r} != expected {content!r}")
        if contract and contract.is_file():
            try:
                lines = contract.read_text().splitlines()
                result["contract_header"] = lines[0] if lines else ""
            except OSError as error:
                result["problems"].append(f"cannot read contract: {error}")
            if header and result["contract_header"] != header:
                result["problems"].append(
                    f"contract header {result['contract_header']!r} != {header!r}")
        else:
            result["problems"].append(f"root contract missing: {contract}")
        return result
    return {"profile": None, "marker": None, "contract": None,
            "problems": ["no /etc/liuqin-fedora-root or /etc/liuqin-native-root marker found"]}


def installed_kernels(modules_dir: Path) -> list:
    if not modules_dir.is_dir():
        return []
    return sorted(entry.name for entry in modules_dir.iterdir() if entry.is_dir())


def identity_gate(image: BootImage, staging_dir: Path, modules_dir: Path,
                  release_file: Path, *, write_mode: bool,
                  allow_dev_dtb_source: bool) -> dict:
    """Apply-time gate: the staged image must belong to the installed rootfs.

    The staged metadata is schema v2 (liuqin_boot_metadata.py) and
    is cross-checked against the real boot.img sections AND against the
    installed kernel payload, so "kernel identity mismatch" is a hard failure
    for a device write instead of a warning.
    """
    paths = staging_paths(image.path, staging_dir)
    gate = {"checks": [], "warnings": [], "manifest": str(paths["manifest"]),
            "build_info": str(paths["build_info"]), "root_layout": None,
            "schema_version": None, "metadata": None, "installed_pair_id": None}

    def check(check_id: str, ok: bool, detail: str = "") -> None:
        gate["checks"].append({"id": check_id, "ok": bool(ok), "detail": detail})

    def warn(message: str) -> None:
        gate["warnings"].append(message)

    if not paths["manifest"].is_file():
        raise Refused(f"staging manifest missing: {paths['manifest']} (run the kernel-install hook first)")
    manifest = parse_manifest(paths["manifest"])
    gate["manifest_values"] = manifest
    if not paths["build_info"].is_file():
        raise Refused(f"staging build-info missing: {paths['build_info']}")
    try:
        metadata = load_staged_metadata(paths["build_info"])
    except Refused:
        raise
    except Exception as error:  # metadata schema errors are validation failures
        raise ValidationFailed(f"cannot load the staged boot metadata: {error}") from error
    gate["metadata"] = metadata
    gate["schema_version"] = metadata["schema_version"]
    legacy = metadata["legacy"]
    if legacy:
        for warning in metadata["warnings"]:
            warn(warning)
        if write_mode:
            raise ValidationFailed(
                "staged boot metadata is legacy schema v1; a device write requires "
                "schema v2. Re-run the kernel-install hook (dnf reinstall kernel-liuqin) "
                "to re-stage the boot image with the schema v2 producer")
    else:
        check("manifest.schema_version",
              manifest.get("schema_version") == str(SUPPORTED_METADATA_SCHEMA),
              f"manifest schema_version={manifest.get('schema_version')!r}")
        check("build_info.schema_version",
              metadata["schema_version"] == SUPPORTED_METADATA_SCHEMA,
              f"build-info schema_version={metadata['schema_version']!r}")

    check("build_info.device_ready", metadata["device_ready"] is True,
          f"device_ready={metadata['device_ready']!r}")
    check("manifest.bootimg_sha256", manifest.get("bootimg_sha256") == image.sha256,
          f"manifest {manifest.get('bootimg_sha256')} vs image {image.sha256}")
    check("build_info.artifact_sha256", metadata["artifact_sha256"] == image.sha256,
          f"build-info {metadata['artifact_sha256']} vs image {image.sha256}")

    # The recorded payload identity must equal the real boot.img sections.
    sections = payload_sections(image.path)
    if sections is None:
        raise ValidationFailed(f"cannot parse the boot image sections: {image.path}")
    gate["payload_sections"] = sections
    check("image.kernel_image_sha256",
          sections["kernel_image_sha256"] == metadata["kernel_image_sha256"],
          f"image kernel {sections['kernel_image_sha256']} vs metadata "
          f"{metadata['kernel_image_sha256']}")
    check("image.ramdisk_sha256",
          sections["ramdisk_sha256"] == metadata["ramdisk_sha256"],
          f"image ramdisk {sections['ramdisk_sha256']} vs metadata {metadata['ramdisk_sha256']}")
    check("image.dtb_sha256",
          sections["dtb_sha256"] == metadata["dtb_sha256"],
          f"image dtb {sections['dtb_sha256']} vs metadata {metadata['dtb_sha256']}")

    if paths["sums"].is_file():
        expected = None
        for line in paths["sums"].read_text().splitlines():
            if line.split() and line.split()[-1] == image.path.name:
                expected = line.split()[0]
        check("staging.sha256sums", expected == image.sha256,
              f"SHA256SUMS {expected} vs image {image.sha256}")
    else:
        warn(f"no {paths['sums'].name}; relying on manifest/build-info hashes")

    if not release_file.is_file():
        raise Refused(f"rootfs kernel identity missing: {release_file}")
    rootfs_release = release_file.read_text().splitlines()[0].strip()
    check("kernel_release.manifest", manifest.get("kernel_release") == rootfs_release,
          f"manifest {manifest.get('kernel_release')!r} vs rootfs {rootfs_release!r}")
    check("kernel_release.build_info", metadata["kernel_release"] == rootfs_release,
          f"build-info {metadata['kernel_release']!r} vs rootfs {rootfs_release!r}")
    kernels = installed_kernels(modules_dir)
    check("modules.single_kernel", len(kernels) == 1, f"{len(kernels)} kernel trees: {kernels}")
    if len(kernels) == 1:
        check("modules.release", kernels[0] == rootfs_release,
              f"modules {kernels[0]!r} vs rootfs {rootfs_release!r}")

    # Kernel pair gate: the installed kernel Image (and its modules tree) must
    # be exactly the kernel payload embedded in the staged boot image.
    pair_id, pair_source = installed_pair_id(modules_dir, rootfs_release)
    gate["installed_pair_id"] = pair_id
    gate["installed_pair_source"] = pair_source
    check("pair.kernel_image", pair_id == metadata["kernel_image_sha256"],
          f"installed Image {pair_id} ({pair_source}) vs staged Image "
          f"{metadata['kernel_image_sha256']}")
    if not legacy:
        check("manifest.kernel_image_sha256",
              manifest.get("kernel_image_sha256") == metadata["kernel_image_sha256"],
              f"manifest {manifest.get('kernel_image_sha256')} vs metadata "
              f"{metadata['kernel_image_sha256']}")
        check("manifest.dtb_sha256", manifest.get("dtb_sha256") == metadata["dtb_sha256"],
              f"manifest {manifest.get('dtb_sha256')} vs metadata {metadata['dtb_sha256']}")
        check("manifest.contract_sha256",
              manifest.get("contract_sha256") == metadata["contract_sha256"],
              f"manifest {manifest.get('contract_sha256')} vs metadata "
              f"{metadata['contract_sha256']}")
    board_dtb = modules_dir / rootfs_release / BOARD_DTB_REL
    if board_dtb.is_file():
        check("pair.board_dtb", sha256_file(board_dtb) == metadata["board_dtb_sha256"],
              f"installed board DTB {sha256_file(board_dtb)} vs metadata "
              f"{metadata['board_dtb_sha256']}")
    else:
        check("pair.board_dtb", False, f"installed board DTB missing: {board_dtb}")
    build_info_file = kernel_build_info_file()
    gate["kernel_build_info"] = str(build_info_file)
    if not build_info_file.is_file():
        if write_mode:
            raise Refused(
                f"kernel build info missing: {build_info_file}; cannot prove the "
                f"installed modules tree belongs to the staged boot payload")
        warn(f"kernel build info missing: {build_info_file} (write mode would refuse)")

    layout = root_layout()
    gate["root_layout"] = layout
    check("rootfs.layout_marker", layout["profile"] is not None,
          json.dumps({k: layout[k] for k in ("profile", "marker")}))
    check("rootfs.layout_contract", not layout["problems"], "; ".join(layout["problems"]))

    dtb_source = metadata["dtb_source"]
    gate["dtb_source"] = dtb_source
    if dtb_source == "stock-rom":
        check("dtb.source", True, "stock-rom (canonical)")
    elif dtb_source == "upstream-artifact":
        if write_mode and not allow_dev_dtb_source:
            raise Refused(
                "staged boot.img uses the offline upstream-artifact DTB; a device write "
                "requires the canonical stock-rom DTB (attended dev override: "
                "--allow-dev-dtb-source)")
        warn("staged boot.img uses the upstream-artifact DTB (dev-only offline substitute)")
    else:
        warn(f"metadata dtb_source is {dtb_source!r}")

    for warning in gate["warnings"]:
        log(f"gate warning: {warning}")
    failures = [item for item in gate["checks"] if not item["ok"]]
    if failures:
        for item in failures:
            log(f"gate FAILED: {item['id']}: {item['detail']}")
        raise ValidationFailed(
            "apply-time gate failed (staged boot payload does not match the installed "
            "rootfs/kernel modules pair, or the staged metadata is inconsistent)")
    return gate


