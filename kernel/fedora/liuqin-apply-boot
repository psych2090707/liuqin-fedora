class Refused(Exception):
    """Precondition not met; nothing was written (exit 2)."""


class ValidationFailed(Exception):
    """Staged image / identity validation failed (exit 1)."""


class WriteFailed(Exception):
    """Write or read-back verification failed (exit 4)."""


class BusyError(Exception):
    """Another instance holds the apply lock (exit 3)."""


class PowerLossSimulated(Exception):
    """Test hook: simulate a power loss in the middle of the write."""


