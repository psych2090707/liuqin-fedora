def cmd_status(args) -> int:
    staging = Path(args.staging_dir)
    state = read_journal(staging)
    device_a = Path(args.device)
    device_b = Path(args.device_b)
    rootfs_release = None
    release_file = Path(args.kernel_release_file)
    if release_file.is_file():
        rootfs_release = release_file.read_text().splitlines()[0].strip()
    layout = root_layout()
    staged = []
    for image in sorted(staging.glob("*.img")):
        if image.name == "boot-padded.img":
            continue
        paths = staging_paths(image, staging)
        entry = {
            "image": str(image),
            "bytes": image.stat().st_size if image.exists() else None,
            "manifest": paths["manifest"].is_file(),
            "build_info": paths["build_info"].is_file(),
            "stage_record": paths["stage_record"].is_file(),
        }
        if paths["build_info"].is_file():
            try:
                metadata = load_staged_metadata(paths["build_info"])
            except (Refused, ValidationFailed):
                entry["metadata_schema_version"] = None
            except Exception as error:  # MetadataError
                entry["metadata_schema_version"] = f"invalid: {error}"
            else:
                entry["metadata_schema_version"] = metadata["schema_version"]
                entry["metadata_device_ready"] = metadata["device_ready"]
                entry["metadata_kernel_release"] = metadata["kernel_release"]
                entry["metadata_kernel_image_sha256"] = metadata["kernel_image_sha256"]
        staged.append(entry)
    backups = sorted(str(path) for path in (staging / "backup").glob("boot_a-*.img"))
    boot_b_backups = sorted(str(path)
                            for path in (staging / "backup").glob("boot_b-*.img"))
    pair_store = {"tool": None, "pairs": [], "installed_pair": None}
    try:
        pair_result = run_pair_tool(["status"], timeout=60)
        if pair_result.returncode == 0:
            pair_store = json.loads(pair_result.stdout)
    except (Refused, OSError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        pair_store = {"error": str(error)}
    report = {
        "tool": TOOL, "version": TOOL_VERSION, "time": now(),
        "staging_dir": str(staging),
        "journal": state,
        "staged_images": staged,
        "backups": backups,
        "boot_b_backups": boot_b_backups,
        "kernel_pairs": pair_store,
        "rootfs_kernel_release": rootfs_release,
        "installed_kernels": installed_kernels(Path(args.modules_dir)),
        "root_layout": layout,
        "devices": {
            "boot_a": {"path": str(device_a), "kind": device_kind(device_a),
                       "size": device_size(device_a) or None},
            "boot_b": {"path": str(device_b), "kind": device_kind(device_b),
                       "size": device_size(device_b) or None},
        },
        "write_gates": {
            "experimental_device_write":
                os.environ.get("LIUQIN_EXPERIMENTAL_DEVICE_WRITE") == "1",
            "root": os.geteuid() == 0,
        },
    }
    if getattr(args, "hashes", False) and device_kind(device_a) in ("block", "regular"):
        sha_a = sha256_device(device_a)
        report["devices"]["boot_a"]["sha256"] = sha_a
        sections = payload_sections(device_a)
        if sections:
            report["devices"]["boot_a"]["kernel_image_sha256"] = \
                sections["kernel_image_sha256"]
        if device_kind(device_b) in ("block", "regular"):
            sha_b = sha256_device(device_b)
            report["devices"]["boot_b"]["sha256"] = sha_b
            report["boot_b_fallback_ok"] = sha_a == sha_b
            recorded = {state.get("fallback_sha256"), state.get("boot_b_sha256")}
            recorded.discard(None)
            report["boot_b_recorded_fallback"] = sha_b in recorded
            report["boot_b_fallback_state"] = (
                "identical to boot_a" if sha_a == sha_b else
                "recorded known-good fallback" if sha_b in recorded else
                "UNVERIFIED (not recorded; apply would refuse without an override)")
        if rootfs_release:
            try:
                pair_id, source = installed_pair_id(Path(args.modules_dir), rootfs_release)
            except ValidationFailed as error:
                report["installed_pair_error"] = str(error)
            else:
                report["installed_kernel_pair"] = pair_id
                report["installed_kernel_pair_source"] = source
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
        return EXIT_OK
    say(f"{TOOL} {TOOL_VERSION} status @ {report['time']}")
    say(f"staging: {staging}")
    phase = state.get("phase")
    say(f"last apply: {phase or 'none'}"
        + (f" (image {state.get('image')}, {state.get('applied_at')})"
           if state.get("image") else ""))
    if phase in ("writing", "rollback_writing", "failed", "failed_restored",
                 "failed_restore_failed", "rollback_failed"):
        say("WARNING: an apply is incomplete; run `liuqin-apply-boot recover --yes-write` "
            "to restore the last verified backup.")
    say(f"staged images: {len(staged)}")
    for item in staged:
        say(f"  {item['image']} ({item['bytes']} B)"
            f" manifest={'yes' if item['manifest'] else 'no'}"
            f" build-info={'yes' if item['build_info'] else 'no'}"
            f" schema={item.get('metadata_schema_version')}")
    say(f"backups: {len(backups)}")
    for path in backups[-BACKUP_RETENTION:]:
        say(f"  {path}")
    say(f"boot_a: {device_a} kind={report['devices']['boot_a']['kind']} "
        f"size={report['devices']['boot_a']['size']} (expected {PARTITION_BYTES})")
    say(f"boot_b: {device_b} kind={report['devices']['boot_b']['kind']} "
        f"size={report['devices']['boot_b']['size']} (expected {PARTITION_BYTES})")
    if "boot_b_fallback_ok" in report:
        say(f"boot_b fallback: {report.get('boot_b_fallback_state')} "
            f"(identical: {'yes' if report['boot_b_fallback_ok'] else 'no'})")
    if report.get("installed_kernel_pair"):
        say(f"installed kernel pair: {report['installed_kernel_pair']} "
            f"({report.get('installed_kernel_pair_source')})")
    pairs = report["kernel_pairs"].get("pairs") or []
    say(f"archived kernel pairs: {len(pairs)}")
    for entry in pairs:
        say(f"  {entry.get('pair_id')}  {entry.get('created_at')}  {entry.get('path')}")
    if boot_b_backups:
        say(f"boot_b backups: {len(boot_b_backups)}")
    say(f"rootfs kernel release: {rootfs_release}")
    say(f"root layout: {layout['profile'] or 'UNKNOWN'} "
        f"({'; '.join(layout['problems']) or 'ok'})")
    say(f"write gates: root={report['write_gates']['root']} "
        f"experimental={report['write_gates']['experimental_device_write']}")
    return EXIT_OK


def cmd_stage(args) -> int:
    staging = Path(args.staging_dir)
    with Lock(staging / ".apply.lock", args.lock_timeout_ms):
        image = parse_boot_image(Path(args.image))
        record_path = staging_paths(image.path, staging)["stage_record"]
        record = {
            "schema": 1, "tool": TOOL, "version": TOOL_VERSION,
            "image": str(image.path), "image_sha256": image.sha256,
            "header": image.summary(), "staged_at": now(),
            "apply_command": f"{TOOL} apply --image {image.path} --yes-write",
            "dry_run_command": f"{TOOL} apply --image {image.path} --dry-run",
            "note": "registration only; nothing was written to any device",
        }
        atomic_write_json(record_path, record)
        say(f"staged: {image.path} ({image.file_bytes} bytes, sha256 {image.sha256})")
        say(f"record: {record_path}")
        say("nothing was written to a device. Next:")
        say(f"  {record['dry_run_command']}    # validate")
        say(f"  {record['apply_command']}      # write boot_a (explicit device write, double-gated)")
    return EXIT_OK


def _check_write_permission() -> None:
    if os.geteuid() != 0 and os.environ.get("LIUQIN_APPLY_TEST_ALLOW_NONROOT_WRITE") != "1":
        raise Refused(
            "device writes require root (test hook: LIUQIN_APPLY_TEST_ALLOW_NONROOT_WRITE=1)")
    if os.environ.get("LIUQIN_EXPERIMENTAL_DEVICE_WRITE") != "1":
        raise Refused(
            "device write is gated: explicitly arm with LIUQIN_EXPERIMENTAL_DEVICE_WRITE=1 "
            "after explicit device authorization")


def cmd_apply(args) -> int:
    staging = Path(args.staging_dir)
    dry_run = not args.yes_write
    image = parse_boot_image(Path(args.image))
    say(f"image: {image.path}")
    say(f"  {image.file_bytes} bytes, sha256 {image.sha256}")
    say(f"  header v{image.header_version}, page {image.page_size}, "
        f"kernel {image.kernel_size} B, ramdisk {image.ramdisk_size} B, "
        f"dtb {image.dtb_size} B")
    say(f"  padded 192 MiB partition payload sha256 {image.padded_sha256}")

    with Lock(staging / ".apply.lock", args.lock_timeout_ms):
        gate = identity_gate(
            image, staging, Path(args.modules_dir), Path(args.kernel_release_file),
            write_mode=not dry_run, allow_dev_dtb_source=args.allow_dev_dtb_source)
        metadata = gate["metadata"]
        say(f"identity gate: OK ({len(gate['checks'])} checks, "
            f"{len(gate['warnings'])} warnings)")
        say(f"kernel pair: staged Image {metadata['kernel_image_sha256']} == "
            f"installed Image {gate['installed_pair_id']} "
            f"({gate.get('installed_pair_source', 'vmlinuz')})")

        state = read_journal(staging)
        devices = check_devices(
            Path(args.device), Path(args.device_b), journal=state,
            allow_missing_boot_b=args.allow_missing_boot_b,
            allow_differing_boot_b=args.allow_differing_boot_b)
        say(f"boot_a: {devices['device_a']} ({devices['size_a']} B, "
            f"sha256 {devices['sha256_a']})")
        say(f"boot_b: {devices['device_b']} {devices['boot_b_state']}")
        for warning in devices["warnings"]:
            log(f"device warning: {warning}")

        # Kernel pair identity of the boot payload currently in boot_a: its
        # embedded kernel Image sha256.  The kernel-install hook's RPM %pre has
        # archived the matching modules tree, so a later rollback can restore
        # boot + modules together (liuqin-kernel-pair).
        previous = payload_sections(Path(args.device))
        previous_pair_id = previous["kernel_image_sha256"] if previous else None
        archived_pair_id = archived_pair_dir = None
        if previous_pair_id:
            archived_pair_id, archived_pair_dir = pair_find_by_kernel_image(previous_pair_id)
            say(f"previous boot_a payload kernel Image: {previous_pair_id}")
            if archived_pair_id:
                say(f"previous kernel pair archived: {archived_pair_id}")
            else:
                log("WARNING: no archived kernel pair matches the current boot_a payload; "
                    "a later rollback of this update would be boot-only (the matching "
                    "kernel modules tree cannot be restored)")

        backup_dir = Path(args.backup_dir) if args.backup_dir else staging / "backup"
        if dry_run:
            say("DRY-RUN: would save the current boot_a to "
                f"{backup_dir}/boot_a-<timestamp>-<sha>.img, then write the padded image to "
                f"{devices['device_a']} and verify the whole partition by sha256.")
            say("DRY-RUN: boot_b and all GPT slot attributes remain untouched. "
                "Nothing was written.")
            say(f"DRY-RUN: boot_b fallback handling: {devices['boot_b_state']}")
            say(f"next: {TOOL} apply --image {image.path} --yes-write   "
                "(requires LIUQIN_EXPERIMENTAL_DEVICE_WRITE=1 and root)")
            return EXIT_OK

        _check_write_permission()
        backup = make_backup(Path(args.device), backup_dir, devices["sha256_a"])
        pruned = prune_backups(backup_dir)
        if pruned:
            log(f"pruned old backups: {', '.join(pruned)}")
        write_journal(staging, phase="backup_done", image=str(image.path),
                      image_sha256=image.sha256, backup=str(backup),
                      backup_sha256=devices["sha256_a"],
                      expected_partition_sha256=image.padded_sha256,
                      device=str(args.device))
        say(f"backup: {backup} (sha256 {devices['sha256_a']}, read back OK)")

        work = staging / ".apply-work"
        padded = write_padded_image(image, work)
        write_journal(staging, phase="writing", started_at=now())
        try:
            write_device(Path(args.device), padded)
            ok, actual = readback_matches(Path(args.device), image.padded_sha256)
        except PowerLossSimulated as error:
            write_journal(staging, phase="writing", last_error=str(error))
            log(f"ABORTED: {error}")
            log("the journal says phase=writing; the last verified backup is:")
            log(f"  {backup}")
            for command in recovery_commands(Path(args.device), backup, devices["sha256_a"]):
                log(f"  {command}")
            return EXIT_ABORTED
        except OSError as error:
            write_journal(staging, phase="failed", last_error=str(error))
            log(f"write failed: {error}")
            restored, restored_sha = restore_backup(
                Path(args.device), backup, devices["sha256_a"])
            if restored:
                write_journal(staging, phase="failed_restored", last_error=str(error),
                              restored_sha256=restored_sha)
                log("boot_a was restored from the verified backup")
            else:
                write_journal(staging, phase="failed_restore_failed", last_error=str(error))
                for command in recovery_commands(Path(args.device), backup,
                                                  devices["sha256_a"]):
                    log(f"  {command}")
            return EXIT_VERIFY
        finally:
            padded.unlink(missing_ok=True)
            try:
                work.rmdir()
            except OSError:
                pass

        if not ok:
            log(f"read-back sha256 mismatch: expected {image.padded_sha256}, got {actual}")
            restored, restored_sha = restore_backup(
                Path(args.device), backup, devices["sha256_a"])
            if not restored:
                write_journal(staging, phase="failed_restore_failed",
                              last_error="read-back mismatch",
                              actual_readback_sha256=actual)
                log("automatic restore FAILED; do not reboot until boot_a is restored")
                for command in recovery_commands(Path(args.device), backup,
                                                  devices["sha256_a"]):
                    log(f"  {command}")
                return EXIT_VERIFY
            write_journal(staging, phase="failed_restored", last_error="read-back mismatch",
                          actual_readback_sha256=actual, restored_sha256=restored_sha)
            log("read-back verification failed; boot_a was restored from the verified backup")
            for command in recovery_commands(Path(args.device), backup, devices["sha256_a"]):
                log(f"  {command}")
            return EXIT_VERIFY

        write_journal(
            staging, phase="applied", applied_at=now(),
            last_backup=str(backup), partition_sha256=actual,
            kernel_release=metadata["kernel_release"],
            kernel_image_sha256=metadata["kernel_image_sha256"],
            boot_b_sha256=devices["sha256_b"],
            fallback_sha256=devices["fallback_sha256"],
            fallback_state=devices["boot_b_state"],
            previous_payload={
                "partition_sha256": devices["sha256_a"],
                "kernel_image_sha256": previous_pair_id,
                "kernel_pair_id": archived_pair_id,
                "kernel_pair_dir": archived_pair_dir,
            })
        say(f"boot_a written and verified (partition sha256 {actual})")
        say(f"backup kept at {backup}")
        say(f"boot_b untouched ({devices['boot_b_state']}).")
        say("GPT slot attributes untouched; no qbootctl/fastboot used.")
        if archived_pair_id:
            say(f"the previous kernel pair is archived ({archived_pair_id}): a rollback "
                "can restore boot + matching modules together")
        else:
            say("NOTE: the previous kernel pair is not archived; a rollback of this "
                "update would be boot-only (modules not restored).")
        say("reboot to use the new boot image. To undo before reboot:")
        say(f"  {TOOL} rollback --yes-write --backup {backup}")
        say("after a successful boot, re-sync the bootloader fallback copy with:")
        say(f"  {TOOL} confirm --yes-write")
        return EXIT_OK


def _choose_backup(args, staging: Path, backup_dir: Path, state: dict):
    if args.backup:
        return Path(args.backup).resolve()
    recorded = state.get("last_backup")
    if recorded and Path(recorded).is_file():
        return Path(recorded).resolve()
    candidates = sorted(backup_dir.glob("boot_a-*.img"), key=lambda path: path.name)
    if candidates:
        return candidates[-1].resolve()
    raise Refused(f"no verified backup available under {backup_dir}")


def _restore_pair(pair_id: str) -> subprocess.CompletedProcess:
    log(f"restoring the archived kernel pair {pair_id} (boot + modules become consistent)")
    result = run_pair_tool(["restore", "--pair-id", pair_id, "--yes-write"])
    for line in (result.stdout or "").splitlines():
        say(f"  {line}")
    if result.returncode != 0:
        for line in (result.stderr or "").splitlines():
            log(f"  pair restore: {line}")
    return result


def _restore_device_from_backup(device: Path, backup: Path, expected_sha: str) -> bool:
    restored, actual = restore_backup(device, backup, expected_sha)
    if restored:
        log(f"{device} was restored from the verified backup")
    else:
        log(f"automatic restore of {device} FAILED; do not reboot")
    return restored


def cmd_rollback(args) -> int:
    """Restore boot_a from a verified backup AND the matching kernel pair.

    A boot.img restore is not a complete system rollback: the kernel Image in
    the backup needs its matching /usr/lib/modules/<kver> tree.  The RPM %pre
    archived that tree (liuqin-kernel-pair) before the upgrade replaced it, so
    this command restores both.  If no archived pair matches the backup's
    kernel Image, the rollback is refused by default; --boot-only accepts a
    boot-only restore with a recorded boundary (never a silent mismatch).
    """
    staging = Path(args.staging_dir)
    dry_run = not args.yes_write
    boot_only = getattr(args, "boot_only", False)
    backup_dir = Path(args.backup_dir) if args.backup_dir else staging / "backup"
    state = read_journal(staging)
    backup = _choose_backup(args, staging, backup_dir, state)
    if not backup.is_file():
        raise Refused(f"backup not found: {backup}")
    if backup.stat().st_size != PARTITION_BYTES:
        raise Refused(
            f"backup is {backup.stat().st_size} bytes, expected {PARTITION_BYTES}: {backup}")
    backup_sha = sha256_file(backup)
    recorded_sha = state.get("backup_sha256")
    if state.get("last_backup") and Path(state["last_backup"]).resolve() == backup and \
            recorded_sha and recorded_sha != backup_sha:
        raise ValidationFailed(
            f"backup sha256 {backup_sha} does not match journal {recorded_sha}")
    device = Path(args.device)
    with Lock(staging / ".apply.lock", args.lock_timeout_ms):
        require_test_regular_file(device)
        if device_kind(device) not in ("block", "regular"):
            raise Refused(f"boot_a device not found: {device}")
        if device_size(device) != PARTITION_BYTES:
            raise Refused(f"unexpected boot_a partition size: {device_size(device)}")
        say(f"backup: {backup} (sha256 {backup_sha})")

        # Which kernel pair does this boot payload belong to?
        sections = payload_sections(backup)
        target_pair_id = sections["kernel_image_sha256"] if sections else None
        release_file = Path(args.kernel_release_file)
        release = None
        if release_file.is_file():
            lines = release_file.read_text().splitlines()
            release = lines[0].strip() if lines else None
        current_pair = None
        current_pair_problem = None
        if release:
            try:
                current_pair, _source = installed_pair_id(Path(args.modules_dir), release)
            except ValidationFailed as error:
                current_pair_problem = str(error)
        pair_restore_id = None
        pair_reason = None
        if target_pair_id is None:
            pair_reason = ("the backup is not a parseable liuqin boot image, so its "
                           "kernel pair identity is unknown")
            if not boot_only:
                raise Refused(
                    f"{pair_reason}; restoring it would not be verifiable. "
                    "Re-run with --boot-only to accept a boot-only rollback (NOT a "
                    "complete system rollback)")
            log(f"WARNING: {pair_reason}; boot-only rollback")
        elif current_pair_problem:
            pair_reason = f"installed kernel pair is inconsistent: {current_pair_problem}"
            if not boot_only:
                raise ValidationFailed(
                    f"{pair_reason}. Fix the installed kernel package first, or use "
                    "--boot-only to accept a boot-only rollback")
            log(f"WARNING: {pair_reason}; boot-only rollback")
        elif current_pair == target_pair_id:
            say(f"kernel pair: backup payload Image {target_pair_id} == installed Image "
                f"{current_pair}; modules already match, no pair restore needed")
            pair_reason = "installed modules pair already matches the backup payload"
        else:
            archived_id, archived_dir = pair_find_by_kernel_image(target_pair_id)
            if not archived_id:
                pair_reason = (
                    f"no archived kernel pair matches the backup's kernel Image "
                    f"{target_pair_id} (store: liuqin-kernel-pair list)")
                if not boot_only:
                    raise Refused(
                        f"{pair_reason}. Restoring only boot.img would leave the boot "
                        "payload and /usr/lib/modules mismatched. Re-run with --boot-only "
                        "to accept a boot-only rollback (NOT a complete system rollback), "
                        "or reinstall the matching kernel RPM")
                log(f"WARNING: {pair_reason}; boot-only rollback")
            else:
                verify = run_pair_tool(["verify", "--pair-id", archived_id])
                if verify.returncode != 0:
                    raise Refused(
                        f"archived kernel pair {archived_id} failed verification; "
                        f"refusing to restore it:\n{verify.stdout}{verify.stderr}")
                pair_restore_id = archived_id
                say(f"kernel pair: backup payload Image {target_pair_id} != installed "
                    f"Image {current_pair}; will restore archived pair {archived_id}")

        if dry_run:
            say(f"DRY-RUN: would restore {backup} to {device} and verify the whole partition.")
            if pair_restore_id:
                say(f"DRY-RUN: would then restore the archived kernel pair "
                    f"{pair_restore_id} (modules tree + identity files), archiving the "
                    "current pair first.")
            elif pair_reason:
                say(f"DRY-RUN: kernel pair handling: {pair_reason}")
            say("DRY-RUN: nothing was written.")
            return EXIT_OK
        _check_write_permission()
        write_journal(staging, phase="rolling_back", rollback_backup=str(backup))
        try:
            write_device(device, backup)
        except PowerLossSimulated as error:
            write_journal(staging, phase="rollback_writing", last_error=str(error))
            log(f"ABORTED: {error}")
            return EXIT_ABORTED
        ok, actual = readback_matches(device, backup_sha)
        if not ok:
            write_journal(staging, phase="rollback_failed",
                          last_error="read-back mismatch", actual_readback_sha256=actual)
            log(f"rollback read-back mismatch: expected {backup_sha}, got {actual}")
            log("do not reboot; retry the rollback or restore manually")
            return EXIT_VERIFY
        say(f"boot_a restored and verified (partition sha256 {actual})")

        if pair_restore_id:
            write_journal(staging, phase="rollback_pair_pending",
                          rollback_pair_id=pair_restore_id,
                          rollback_target_pair=target_pair_id)
            result = _restore_pair(pair_restore_id)
            if result.returncode != 0:
                write_journal(staging, phase="rollback_pair_failed",
                              last_error="kernel pair restore failed")
                log("boot_a is rolled back but the kernel modules pair is NOT restored yet.")
                log("do not reboot; complete it with:")
                log(f"  {TOOL} recover --yes-write   # retries the archived pair restore")
                return EXIT_VERIFY
            installed_now = None
            if release:
                try:
                    installed_now, _source = installed_pair_id(Path(args.modules_dir), release)
                except ValidationFailed as error:
                    write_journal(staging, phase="rollback_pair_failed",
                                  last_error=str(error))
                    log(f"post-restore kernel pair verification failed: {error}")
                    return EXIT_VERIFY
            if installed_now != target_pair_id:
                write_journal(staging, phase="rollback_pair_failed",
                              last_error="installed pair does not match the backup payload")
                log(f"post-restore verification failed: installed pair {installed_now} != "
                    f"backup payload {target_pair_id}")
                return EXIT_VERIFY
            say(f"kernel pair restored and verified: installed Image {installed_now} == "
                f"backup payload Image {target_pair_id}")
        write_journal(staging, phase="rolled_back", rolled_back_at=now(),
                      rolled_back_from=str(backup), partition_sha256=actual,
                      kernel_image_sha256=target_pair_id,
                      pair_restored=bool(pair_restore_id),
                      pair_restore_reason=pair_reason)
        say("reboot to boot the previous image.")
        return EXIT_OK


def cmd_recover(args) -> int:
    staging = Path(args.staging_dir)
    state = read_journal(staging)
    phase = state.get("phase")
    if phase in ("rollback_pair_pending", "rollback_pair_failed"):
        pair_id = state.get("rollback_pair_id")
        if not pair_id:
            raise Refused(
                f"journal phase is {phase} but no rollback_pair_id is recorded; "
                "restore the kernel package and boot image manually")
        if not args.yes_write:
            say(f"DRY-RUN: would retry restoring the archived kernel pair {pair_id}.")
            return EXIT_OK
        _check_write_permission()
        result = _restore_pair(pair_id)
        if result.returncode != 0:
            write_journal(staging, phase="rollback_pair_failed",
                          last_error="pair restore retry failed")
            log("kernel pair restore still failing; do not reboot")
            return EXIT_VERIFY
        write_journal(staging, phase="rolled_back", pair_restored=True,
                      pair_restored_at=now(), rollback_pair_id=pair_id)
        say(f"kernel pair {pair_id} restored; boot and modules match. Reboot when ready.")
        return EXIT_OK
    if phase == "fallback_syncing":
        backup = state.get("fallback_backup")
        expected = state.get("fallback_backup_sha256")
        if not backup or not expected:
            raise Refused(
                "journal phase is fallback_syncing but no boot_b backup is recorded; "
                "inspect boot_b manually")
        if not args.yes_write:
            say(f"DRY-RUN: would restore boot_b from {backup} (sha256 {expected}).")
            return EXIT_OK
        _check_write_permission()
        device_b = Path(args.device_b)
        restored = _restore_device_from_backup(device_b, Path(backup), expected)
        if not restored:
            raise ValidationFailed("could not restore boot_b from its backup")
        write_journal(staging, phase="applied", last_error="fallback_sync_interrupted_restored")
        say("boot_b was restored from its backup; the fallback copy is unchanged.")
        return EXIT_OK
    if phase in ("writing", "rollback_writing", "failed", "failed_restored",
                 "failed_restore_failed", "rollback_failed"):
        log(f"journal phase is {phase}; restoring the last verified backup")
        if not args.backup:
            args.backup = state.get("last_backup") or state.get("rollback_backup") or ""
        return cmd_rollback(args)
    if phase == "applied":
        say("journal phase is applied; nothing to recover. Use `rollback` to revert.")
        return EXIT_OK
    raise Refused(f"no incomplete apply to recover (journal phase: {phase!r})")


def cmd_confirm(args) -> int:
    """Re-sync the bootloader fallback copy (boot_b) with the known-good boot_a.

    Upstream semantics: boot_b is the copy the bootloader falls back to when
    boot_a does not load.  After an update boot_a != boot_b is normal; this
    command makes boot_b track the newest image that has actually booted (run
    it after a successful boot, manually or from a device-layer unit).  It is
    not needed for continuous updates — a differing boot_b that matches the
    journal-recorded fallback is already accepted by `apply`.
    """
    staging = Path(args.staging_dir)
    dry_run = not args.yes_write
    device_a = Path(args.device)
    device_b = Path(args.device_b)
    backup_dir = Path(args.backup_dir) if args.backup_dir else staging / "backup"
    with Lock(staging / ".apply.lock", args.lock_timeout_ms):
        require_test_regular_file(device_a)
        require_test_regular_file(device_b)
        for device, label in ((device_a, "boot_a"), (device_b, "boot_b")):
            if device_kind(device) not in ("block", "regular"):
                raise Refused(f"{label} device not found: {device}")
            if device_size(device) != PARTITION_BYTES:
                raise Refused(f"unexpected {label} partition size: {device_size(device)}")
        state = read_journal(staging)
        sha_a = sha256_device(device_a)
        sections = payload_sections(device_a)
        if sections is None:
            raise Refused(
                "boot_a does not contain a parseable liuqin boot image; refusing to "
                "copy it into boot_b as a fallback")
        recorded = state.get("partition_sha256")
        if recorded is None:
            log("WARNING: the journal has no partition_sha256 for boot_a; treating this "
                "explicit confirm as the operator's attestation that it booted")
        elif recorded != sha_a:
            raise Refused(
                f"boot_a changed since the last apply/rollback (journal {recorded}, "
                f"current {sha_a}); refusing to copy unverified bytes into boot_b")
        release_file = Path(args.kernel_release_file)
        if release_file.is_file():
            lines = release_file.read_text().splitlines()
            release = lines[0].strip() if lines else ""
            if release:
                installed_now, _source = installed_pair_id(Path(args.modules_dir), release)
                if installed_now != sections["kernel_image_sha256"]:
                    raise ValidationFailed(
                        f"boot_a payload Image {sections['kernel_image_sha256']} != "
                        f"installed kernel pair {installed_now}; the running system is "
                        "not a consistent boot+modules pair, refusing to bless it")
        sha_b = sha256_device(device_b)
        if sha_b == sha_a:
            write_journal(staging, phase="fallback_confirmed",
                          fallback_sha256=sha_a, boot_b_sha256=sha_b,
                          confirmed_at=now(), fallback_note="boot_b already equalled boot_a")
            say("boot_b already equals boot_a; the fallback copy is current. Nothing written.")
            return EXIT_OK
        say(f"boot_a: sha256 {sha_a}")
        say(f"boot_b: sha256 {sha_b} (current fallback copy)")
        if dry_run:
            say(f"DRY-RUN: would back up boot_b to {backup_dir}/boot_b-<ts>-<sha>.img, "
                f"then copy the whole boot_a partition into boot_b and verify the "
                "read-back sha256.")
            say("DRY-RUN: nothing was written.")
            return EXIT_OK
        _check_write_permission()
        backup = make_backup(device_b, backup_dir, sha_b, prefix="boot_b")
        pruned = prune_backups(backup_dir, "boot_b")
        if pruned:
            log(f"pruned old boot_b backups: {', '.join(pruned)}")
        write_journal(staging, phase="fallback_syncing",
                      fallback_backup=str(backup),
                      fallback_backup_sha256=sha_b,
                      fallback_target_sha256=sha_a)
        try:
            write_device(device_b, device_a)
        except PowerLossSimulated as error:
            write_journal(staging, phase="fallback_syncing", last_error=str(error))
            log(f"ABORTED: {error}")
            log(f"boot_b may be partially written; its backup is {backup}")
            log(f"  {TOOL} recover --yes-write   # restores boot_b from that backup")
            return EXIT_ABORTED
        except OSError as error:
            log(f"boot_b write failed: {error}")
            _restore_device_from_backup(device_b, backup, sha_b)
            write_journal(staging, phase="applied",
                          last_error=f"fallback_sync_failed: {error}")
            return EXIT_VERIFY
        ok, actual = readback_matches(device_b, sha_a)
        if not ok:
            log(f"boot_b read-back sha256 mismatch: expected {sha_a}, got {actual}")
            _restore_device_from_backup(device_b, backup, sha_b)
            write_journal(staging, phase="applied",
                          last_error="fallback_sync_failed: read-back mismatch")
            return EXIT_VERIFY
        write_journal(staging, phase="fallback_confirmed",
                      fallback_sha256=sha_a, boot_b_sha256=actual,
                      confirmed_at=now(),
                      fallback_image_sha256=state.get("image_sha256"))
        say(f"boot_b re-synced with boot_a (partition sha256 {actual}); the bootloader "
            "fallback copy now holds the known-good image.")
        say(f"boot_b backup kept at {backup}")
        return EXIT_OK


