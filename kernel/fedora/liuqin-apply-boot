def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--staging-dir",
        default=os.environ.get("LIUQIN_BOOT_STAGING_DIR", DEFAULT_STAGING_DIR))
    common.add_argument(
        "--device", default=os.environ.get("LIUQIN_BOOT_DEVICE", DEFAULT_DEVICE_A),
        help="boot_a device (default /dev/disk/by-partlabel/boot_a)")
    common.add_argument(
        "--device-b", default=os.environ.get("LIUQIN_BOOT_DEVICE_B", DEFAULT_DEVICE_B),
        help="boot_b device (fallback invariant check)")
    common.add_argument(
        "--modules-dir", default=os.environ.get("LIUQIN_MODULES_DIR", DEFAULT_MODULES_DIR))
    common.add_argument(
        "--kernel-release-file",
        default=os.environ.get("LIUQIN_KERNEL_RELEASE_FILE", DEFAULT_KERNEL_RELEASE_FILE))
    common.add_argument(
        "--backup-dir", default=os.environ.get("LIUQIN_BOOT_BACKUP_DIR", ""))
    common.add_argument("--lock-timeout-ms", type=int, default=0)
    common.add_argument("--json", action="store_true",
                        help="machine-readable output (status)")

    parser = argparse.ArgumentParser(
        prog=TOOL, description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"{TOOL} {TOOL_VERSION}")
    sub = parser.add_subparsers(dest="command")

    status = sub.add_parser("status", parents=[common],
                            help="show staged images, devices, last apply")
    status.add_argument("--hashes", action="store_true",
                        help="also read boot_a/boot_b and compare (slow)")

    stage = sub.add_parser("stage", parents=[common],
                           help="register/validate a staged boot.img (no write)")
    stage.add_argument("--image", required=True)

    actions = {
        "apply": "apply a staged boot.img to boot_a",
        "rollback": "restore the verified backup AND the matching kernel pair",
        "recover": "restore after an interrupted apply/rollback/confirm",
        "confirm": "re-sync the bootloader fallback copy (boot_b) with a booted boot_a",
    }
    for name, help_text in actions.items():
        action = sub.add_parser(name, parents=[common], help=help_text)
        write_group = action.add_mutually_exclusive_group()
        write_group.add_argument("--yes-write", "--yes-write-device", dest="yes_write",
                                 action="store_true",
                                 help="really write boot_a (double-gated)")
        write_group.add_argument("--dry-run", dest="yes_write", action="store_false",
                                 help="validate only (default)")
        action.set_defaults(yes_write=False)
        if name == "apply":
            action.add_argument("--image", required=True)
            action.add_argument("--allow-differing-boot-b", action="store_true")
            action.add_argument("--allow-missing-boot-b", action="store_true")
            action.add_argument("--allow-dev-dtb-source", action="store_true",
                                help="attended dev only: accept the upstream-artifact DTB")
        if name in ("rollback", "recover"):
            action.add_argument("--backup", default="")
            action.add_argument("--boot-only", action="store_true",
                                help="rollback: accept a boot-only restore when no "
                                     "archived kernel pair matches (NOT a complete "
                                     "system rollback)")
    return parser


def legacy_argv(argv: list) -> list:
    """Support the pre-2.0 `liuqin-apply-boot --image X [...]` form."""
    if not argv:
        return argv
    if argv[0] in ("-h", "--help", "--version"):
        return argv
    if argv[0].startswith("-"):
        return ["apply", *argv]
    return argv


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    argv = legacy_argv(argv)
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command is None:
        parser.print_help()
        return EXIT_REFUSED
    try:
        if args.command == "status":
            return cmd_status(args)
        if args.command == "stage":
            return cmd_stage(args)
        if args.command == "apply":
            return cmd_apply(args)
        if args.command == "rollback":
            return cmd_rollback(args)
        if args.command == "recover":
            return cmd_recover(args)
        if args.command == "confirm":
            return cmd_confirm(args)
        raise Refused(f"unknown command: {args.command}")
    except BusyError as error:
        log(str(error))
        return EXIT_BUSY
    except Refused as error:
        log(f"refused: {error}")
        return EXIT_REFUSED
    except ValidationFailed as error:
        log(f"validation failed: {error}")
        return EXIT_VALIDATION
    except WriteFailed as error:
        log(f"write failed: {error}")
        return EXIT_VERIFY
    except OSError as error:
        log(f"I/O error: {error}")
        return EXIT_VALIDATION


if __name__ == "__main__":
    raise SystemExit(main())
