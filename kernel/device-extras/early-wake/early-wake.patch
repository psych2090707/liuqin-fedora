diff --git a/include/linux/liuqin_early_wake.h b/include/linux/liuqin_early_wake.h
new file mode 100644
--- /dev/null
+++ b/include/linux/liuqin_early_wake.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_LIUQIN_EARLY_WAKE_H
+#define _LINUX_LIUQIN_EARLY_WAKE_H
+
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+/* Task-local instrumentation, not a production driver interface. */
+enum liuqin_ew_phase {
+	EW_CYCLE_BEGIN = 1, EW_CPU_OFF_BEGIN, EW_CPUS_OFF, EW_IRQS_OFF,
+	EW_SYSCORE_SUSPENDED, EW_ENTER_CALL, EW_ENTER_RETURN, EW_ENTER_SKIPPED,
+	EW_SYSCORE_RESUMED, EW_IRQ_ENABLE_BEGIN, EW_IRQ_ENABLE_DONE,
+	EW_CPU_ON_BEGIN, EW_CPUS_ON, EW_RESUME_NOIRQ_BEGIN,
+	EW_DEVICES_RESUMED, EW_CYCLE_END, EW_ERROR,
+};
+
+#if defined(CONFIG_PM_DEBUG) && defined(CONFIG_ARM64)
+extern bool liuqin_ew_recording;
+void liuqin_ew_begin(unsigned int state);
+void liuqin_ew_end(int error);
+void liuqin_ew_mark(enum liuqin_ew_phase phase, u32 a, int b);
+void liuqin_ew_event(u32 type, const u32 data[8]);
+void liuqin_ew_message(u32 action, const void *data, size_t len, int ret);
+
+static inline void liuqin_ew_gic(u32 irqnr)
+{
+	if (unlikely(READ_ONCE(liuqin_ew_recording))) {
+		u32 d[8] = { irqnr };
+
+		liuqin_ew_event(1, d);
+	}
+}
+
+static inline void liuqin_ew_ipcc(u32 hwirq, u32 virq, u32 summary_irq)
+{
+	if (unlikely(READ_ONCE(liuqin_ew_recording))) {
+		u32 d[8] = { hwirq, hwirq >> 16, hwirq & 0xffff,
+			     virq, summary_irq };
+
+		liuqin_ew_event(2, d);
+	}
+}
+
+static inline void liuqin_ew_pmic(u32 action, const void *data,
+				 size_t len, int ret)
+{
+	if (unlikely(READ_ONCE(liuqin_ew_recording)))
+		liuqin_ew_message(action, data, len, ret);
+}
+#else
+static inline void liuqin_ew_begin(unsigned int state) {}
+static inline void liuqin_ew_end(int error) {}
+static inline void liuqin_ew_mark(enum liuqin_ew_phase p, u32 a, int b) {}
+static inline void liuqin_ew_gic(u32 irqnr) {}
+static inline void liuqin_ew_ipcc(u32 hwirq, u32 virq, u32 summary_irq) {}
+static inline void liuqin_ew_pmic(u32 action, const void *data,
+				 size_t len, int ret) {}
+#endif
+#endif
diff --git a/kernel/power/liuqin_early_wake.c b/kernel/power/liuqin_early_wake.c
new file mode 100644
--- /dev/null
+++ b/kernel/power/liuqin_early_wake.c
@@ -0,0 +1,385 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* TN0092: one-shot, passive recorder; no hardware queries except raw counter. */
+#include <clocksource/arm_arch_timer.h>
+#include <linux/build_bug.h>
+#include <linux/buildid.h>
+#include <linux/cpu.h>
+#include <linux/debugfs.h>
+#include <linux/init.h>
+#include <linux/liuqin_early_wake.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/suspend.h>
+#include <linux/uaccess.h>
+#include <linux/unaligned.h>
+
+#define EW_CPUS 8
+#define EW_TYPES 3
+#define EW_PRE 16
+#define EW_POST 32
+#define EW_PHASES 64
+
+enum ew_state { EW_IDLE, EW_ARMED, EW_RECORDING, EW_SEALED };
+
+struct ew_record {
+	u64 seq, ticks;
+	u32 cycle, attempt, phase, type, cpu;
+	u32 d[8];
+};
+
+struct ew_lane {
+	u64 pre_seen, post_seen;
+	struct ew_record pre[EW_PRE], post[EW_POST];
+};
+
+struct ew_buffer {
+	u32 cycle, attempt, phase, nr_phases, rate;
+	u32 phase_dropped, cpu_dropped;
+	bool returned, skipped;
+	u64 seq;
+	u8 build_id[BUILD_ID_SIZE_MAX];
+	struct ew_record phases[EW_PHASES];
+	struct ew_lane lanes[EW_CPUS][EW_TYPES];
+};
+
+static struct ew_buffer ew;
+static enum ew_state ew_state;
+static DEFINE_RAW_SPINLOCK(ew_lock);
+/* Serializes debugfs snapshots and arm/reset, never used by record writers. */
+static DEFINE_MUTEX(ew_control);
+bool liuqin_ew_recording;
+
+static const char * const ew_states[] = { "idle", "armed", "recording", "sealed" };
+static const char * const ew_phases[] = {
+	"NONE", "CYCLE_BEGIN", "CPU_OFF_BEGIN", "CPUS_OFF", "IRQS_OFF",
+	"SYSCORE_SUSPENDED", "ENTER_CALL", "ENTER_RETURN", "ENTER_SKIPPED",
+	"SYSCORE_RESUMED", "IRQ_ENABLE_BEGIN", "IRQ_ENABLE_DONE",
+	"CPU_ON_BEGIN", "CPUS_ON", "RESUME_NOIRQ_BEGIN", "DEVICES_RESUMED",
+	"CYCLE_END", "ERROR",
+};
+
+/* All callers hold ew_lock with local IRQs disabled. No nested recorder calls.
+ * The lock assigns seq/ticks AND commits the whole record, not just an index.
+ * Current configuration has no pseudo-NMIs. This is NOT an NMI-safe recorder.
+ */
+static void ew_fill(struct ew_record *r, u32 type, const u32 d[8], u64 seq)
+{
+	r->seq = seq;
+	r->ticks = arch_timer_read_counter();
+	r->cycle = ew.cycle;
+	r->attempt = ew.attempt;
+	r->phase = ew.phase;
+	r->type = type;
+	r->cpu = raw_smp_processor_id();
+	memcpy(r->d, d, sizeof(r->d));
+}
+
+static void ew_mark_locked(enum liuqin_ew_phase phase, u32 a, int b)
+{
+	u32 d[8] = { a, (u32)b };
+	u64 seq = ++ew.seq;
+
+	if (phase == EW_ENTER_CALL)
+		ew.attempt++;
+	if (phase == EW_ENTER_RETURN)
+		ew.returned = true; /* partition is the FIRST platform return */
+	if (phase == EW_ENTER_SKIPPED)
+		ew.skipped = true;
+	ew.phase = phase;
+	if (ew.nr_phases < EW_PHASES)
+		ew_fill(&ew.phases[ew.nr_phases++], 0, d, seq);
+	else
+		ew.phase_dropped++;
+}
+
+void liuqin_ew_mark(enum liuqin_ew_phase phase, u32 a, int b)
+{
+	unsigned long flags;
+
+	if (!READ_ONCE(liuqin_ew_recording))
+		return;
+	raw_spin_lock_irqsave(&ew_lock, flags);
+	if (ew_state == EW_RECORDING)
+		ew_mark_locked(phase, a, b);
+	raw_spin_unlock_irqrestore(&ew_lock, flags);
+}
+
+void liuqin_ew_begin(unsigned int state)
+{
+	unsigned long flags;
+
+	if (state != PM_SUSPEND_MEM || READ_ONCE(ew_state) != EW_ARMED)
+		return;
+	raw_spin_lock_irqsave(&ew_lock, flags);
+	if (ew_state == EW_ARMED) {
+		ew_state = EW_RECORDING;
+		ew_mark_locked(EW_CYCLE_BEGIN, state, 0);
+		WRITE_ONCE(liuqin_ew_recording, true);
+	}
+	raw_spin_unlock_irqrestore(&ew_lock, flags);
+}
+
+void liuqin_ew_end(int error)
+{
+	unsigned long flags;
+
+	if (!READ_ONCE(liuqin_ew_recording))
+		return;
+	raw_spin_lock_irqsave(&ew_lock, flags);
+	if (ew_state == EW_RECORDING) {
+		/* 100 = bypass before suspend_enter (freezer/device failure/test). */
+		if (!ew.attempt && !ew.skipped)
+			ew_mark_locked(EW_ENTER_SKIPPED, 100, error);
+		ew_mark_locked(EW_CYCLE_END, ew.attempt, error);
+		WRITE_ONCE(liuqin_ew_recording, false);
+		ew_state = EW_SEALED;
+	}
+	raw_spin_unlock_irqrestore(&ew_lock, flags);
+}
+
+void liuqin_ew_event(u32 type, const u32 data[8])
+{
+	struct ew_lane *lane;
+	unsigned long flags;
+	u64 n, seq;
+	u32 cpu;
+
+	raw_spin_lock_irqsave(&ew_lock, flags);
+	if (ew_state != EW_RECORDING)
+		goto out;
+	seq = ++ew.seq;
+	cpu = raw_smp_processor_id();
+	if (cpu >= EW_CPUS) {
+		ew.cpu_dropped++;
+		goto out;
+	}
+	lane = &ew.lanes[cpu][type - 1];
+	if (!ew.returned) {
+		n = lane->pre_seen++;
+		ew_fill(&lane->pre[n % EW_PRE], type, data, seq);
+	} else {
+		n = lane->post_seen++;
+		if (n < EW_POST)
+			ew_fill(&lane->post[n], type, data, seq);
+	}
+out:
+	raw_spin_unlock_irqrestore(&ew_lock, flags);
+}
+
+void liuqin_ew_message(u32 action, const void *data, size_t len, int ret)
+{
+	u32 d[8] = { action, 0, 0, 0, len, 0, (u32)ret, 0 };
+	u32 code;
+
+	/* No payload copied. flags bit0=header valid, bit1=known notification. */
+	if (len >= 12) {
+		d[1] = get_unaligned_le32(data);
+		d[2] = get_unaligned_le32((const u8 *)data + 4);
+		d[3] = get_unaligned_le32((const u8 *)data + 8);
+		d[7] = 1;
+		if (action == 0 && len == 16 && d[1] == 32778 &&
+		    d[2] == 2 && d[3] == 7) {
+			code = get_unaligned_le32((const u8 *)data + 12);
+			switch (code) {
+			case 0x30: case 0x32: case 0x34: case 0x50:
+			case 0x80: case 0x81:
+				d[5] = code;
+				d[7] |= 2;
+			}
+		}
+	}
+	liuqin_ew_event(3, d);
+}
+
+static ssize_t ew_arm_write(struct file *file, const char __user *buf,
+			    size_t len, loff_t *pos)
+{
+	unsigned long flags;
+	u32 cycle;
+	int cpu, value, ret;
+
+	ret = kstrtoint_from_user(buf, len, 10, &value);
+	if (ret)
+		return ret;
+	if (value != 0 && value != 1)
+		return -EINVAL;
+	mutex_lock(&ew_control);
+	raw_spin_lock_irqsave(&ew_lock, flags);
+	if (ew_state == EW_RECORDING || (value && ew_state == EW_ARMED)) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	if (!value) {
+		if (ew_state == EW_ARMED)
+			ew_state = EW_IDLE;
+		goto unlock;
+	}
+	for_each_possible_cpu(cpu) {
+		if (cpu >= EW_CPUS) {
+			ret = -E2BIG;
+			goto unlock;
+		}
+	}
+	/* No writer can enter while idle/sealed. Keep the large clear OUTSIDE
+	 * the IRQ-off section. ew_control excludes readers/resetters. */
+	cycle = ew.cycle + 1;
+	raw_spin_unlock_irqrestore(&ew_lock, flags);
+	memset(&ew, 0, sizeof(ew));
+	ew.cycle = cycle;
+	ew.rate = arch_timer_get_rate();
+	memcpy(ew.build_id, vmlinux_build_id, sizeof(ew.build_id));
+	raw_spin_lock_irqsave(&ew_lock, flags);
+	ew_state = EW_ARMED;
+unlock:
+	raw_spin_unlock_irqrestore(&ew_lock, flags);
+	mutex_unlock(&ew_control);
+	return ret ? ret : len;
+}
+
+static const struct file_operations ew_arm_fops = {
+	.owner = THIS_MODULE,
+	.open = nonseekable_open,
+	.write = ew_arm_write,
+};
+
+static int ew_status_show(struct seq_file *s, void *unused)
+{
+	unsigned long flags;
+	u64 pre[EW_CPUS][EW_TYPES], post[EW_CPUS][EW_TYPES];
+	u32 state, cycle, attempt, phase_dropped, cpu_dropped, rate, phases;
+	u8 build_id[BUILD_ID_SIZE_MAX];
+	int c, t;
+
+	mutex_lock(&ew_control);
+	raw_spin_lock_irqsave(&ew_lock, flags);
+	state = ew_state;
+	cycle = ew.cycle;
+	attempt = ew.attempt;
+	rate = ew.rate;
+	phases = ew.nr_phases;
+	phase_dropped = ew.phase_dropped;
+	cpu_dropped = ew.cpu_dropped;
+	memcpy(build_id, ew.build_id, sizeof(build_id));
+	for (c = 0; c < EW_CPUS; c++)
+		for (t = 0; t < EW_TYPES; t++) {
+			pre[c][t] = ew.lanes[c][t].pre_seen;
+			post[c][t] = ew.lanes[c][t].post_seen;
+		}
+	raw_spin_unlock_irqrestore(&ew_lock, flags);
+	mutex_unlock(&ew_control);
+	seq_printf(s, "version=1\nstate=%s\ncycle=%u\nattempt=%u\nrate_hz=%u\n",
+		   ew_states[state], cycle, attempt, rate);
+	seq_printf(s, "build_id=%20phN\n", build_id);
+	seq_printf(s, "buffer_bytes=%zu\nphase_count=%u\nphase_dropped=%u\ncpu_dropped=%u\n",
+		   sizeof(ew), phases, phase_dropped, cpu_dropped);
+	seq_puts(s, "partition=first_enter_return\nclock=arch_timer_raw\nclock_valid=uncalibrated\n");
+	for (c = 0; c < EW_CPUS; c++)
+		for (t = 0; t < EW_TYPES; t++)
+			seq_printf(s, "cpu%d_type%d_pre_seen=%llu\ncpu%d_type%d_pre_overwritten=%llu\ncpu%d_type%d_post_seen=%llu\ncpu%d_type%d_post_dropped=%llu\n",
+				c, t + 1, pre[c][t], c, t + 1,
+				pre[c][t] > EW_PRE ? pre[c][t] - EW_PRE : 0,
+				c, t + 1, post[c][t], c, t + 1,
+				post[c][t] > EW_POST ? post[c][t] - EW_POST : 0);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ew_status);
+
+static void ew_emit(struct seq_file *s, const struct ew_record *r, const char *zone)
+{
+	int i;
+
+	seq_printf(s, "{\"kind\":\"%s\",\"zone\":\"%s\",\"seq\":%llu,\"ticks\":%llu,\"cycle\":%u,\"attempt\":%u,\"phase\":\"%s\",\"type\":%u,\"cpu\":%u,\"data\":[",
+		   r->type ? "event" : "phase", zone, r->seq, r->ticks,
+		   r->cycle, r->attempt, ew_phases[r->phase], r->type, r->cpu);
+	for (i = 0; i < 8; i++)
+		seq_printf(s, "%s%u", i ? "," : "", r->d[i]);
+	seq_puts(s, "]}\n");
+}
+
+static int ew_events_show(struct seq_file *s, void *unused)
+{
+	const struct ew_buffer *b = s->private;
+	const struct ew_lane *lane;
+	u64 n, start;
+	int c, t, i;
+
+	seq_printf(s, "{\"kind\":\"header\",\"version\":1,\"state\":\"sealed\",\"cycle\":%u,\"attempt\":%u,\"rate_hz\":%u,\"buffer_bytes\":%zu,\"build_id\":\"%20phN\",\"partition\":\"first_enter_return\",\"clock_valid\":\"uncalibrated\"}\n",
+		   b->cycle, b->attempt, b->rate, sizeof(*b), b->build_id);
+	for (i = 0; i < b->nr_phases; i++)
+		ew_emit(s, &b->phases[i], "phase");
+	for (c = 0; c < EW_CPUS; c++)
+		for (t = 0; t < EW_TYPES; t++) {
+			lane = &b->lanes[c][t];
+			start = lane->pre_seen > EW_PRE ? lane->pre_seen - EW_PRE : 0;
+			for (n = start; n < lane->pre_seen; n++)
+				ew_emit(s, &lane->pre[n % EW_PRE], "pre");
+			for (n = 0; n < min_t(u64, lane->post_seen, EW_POST); n++)
+				ew_emit(s, &lane->post[n], "post");
+		}
+	seq_printf(s, "{\"kind\":\"footer\",\"last_seq\":%llu,\"phase_count\":%u,\"phase_dropped\":%u,\"cpu_dropped\":%u}\n",
+		   b->seq, b->nr_phases, b->phase_dropped, b->cpu_dropped);
+	return 0;
+}
+
+static int ew_events_open(struct inode *inode, struct file *file)
+{
+	struct ew_buffer *copy;
+	unsigned long flags;
+	int ret;
+
+	mutex_lock(&ew_control);
+	raw_spin_lock_irqsave(&ew_lock, flags);
+	ret = ew_state == EW_SEALED ? 0 : -EBUSY;
+	raw_spin_unlock_irqrestore(&ew_lock, flags);
+	if (ret)
+		goto out;
+	/* Sealed buffer cannot change while ew_control prevents re-arm. */
+	copy = kvmalloc(sizeof(*copy), GFP_KERNEL);
+	if (!copy) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	memcpy(copy, &ew, sizeof(*copy));
+	ret = single_open(file, ew_events_show, copy);
+	if (ret)
+		kvfree(copy);
+out:
+	mutex_unlock(&ew_control);
+	return ret;
+}
+
+static int ew_events_release(struct inode *inode, struct file *file)
+{
+	struct seq_file *s = file->private_data;
+
+	kvfree(s->private);
+	return single_release(inode, file);
+}
+
+static const struct file_operations ew_events_fops = {
+	.owner = THIS_MODULE,
+	.open = ew_events_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = ew_events_release,
+};
+
+static int __init ew_init(void)
+{
+	struct dentry *dir;
+
+	BUILD_BUG_ON(sizeof(ew) > 128 * 1024);
+	BUILD_BUG_ON(IS_ENABLED(CONFIG_ARM64_PSEUDO_NMI));
+	BUILD_BUG_ON(!IS_ENABLED(CONFIG_VMCORE_INFO));
+	dir = debugfs_create_dir("liuqin_early_wake", NULL);
+	if (IS_ERR(dir))
+		return PTR_ERR(dir);
+	debugfs_create_file("arm", 0200, dir, NULL, &ew_arm_fops);
+	debugfs_create_file("status", 0400, dir, NULL, &ew_status_fops);
+	debugfs_create_file("events", 0400, dir, NULL, &ew_events_fops);
+	return 0;
+}
+late_initcall(ew_init);
diff --git a/kernel/power/Makefile b/kernel/power/Makefile
--- a/kernel/power/Makefile
+++ b/kernel/power/Makefile
@@ -22,3 +22,7 @@
 obj-$(CONFIG_MAGIC_SYSRQ)	+= poweroff.o
 
 obj-$(CONFIG_ENERGY_MODEL)	+= energy_model.o
