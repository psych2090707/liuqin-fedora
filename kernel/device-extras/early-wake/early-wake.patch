diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -32,6 +32,8 @@
 #include <linux/moduleparam.h>
 #include <linux/fs.h>
 
+#include <linux/liuqin_early_wake.h>
+
 #include "power.h"
 
 const char * const pm_labels[] = {
@@ -413,29 +415,36 @@
 static int suspend_enter(suspend_state_t state, bool *wakeup)
 {
 	int error;
+	u32 ew_skip = 1;
+	bool ew_entered = false;
 
 	error = platform_suspend_prepare(state);
 	if (error)
 		goto Platform_finish;
 
+	ew_skip = 2;
 	error = dpm_suspend_late(PMSG_SUSPEND);
 	if (error) {
 		pr_err("late suspend of devices failed\n");
 		goto Platform_finish;
 	}
+	ew_skip = 3;
 	error = platform_suspend_prepare_late(state);
 	if (error)
 		goto Devices_early_resume;
 
+	ew_skip = 4;
 	error = dpm_suspend_noirq(PMSG_SUSPEND);
 	if (error) {
 		pr_err("noirq suspend of devices failed\n");
 		goto Platform_early_resume;
 	}
+	ew_skip = 5;
 	error = platform_suspend_prepare_noirq(state);
 	if (error)
 		goto Platform_wake;
 
+	ew_skip = 6;
 	if (suspend_test(TEST_PLATFORM))
 		goto Platform_wake;
 
@@ -444,39 +453,61 @@
 		goto Platform_wake;
 	}
 
+	ew_skip = 7;
+	liuqin_ew_mark(EW_CPU_OFF_BEGIN, state, 0);
 	error = pm_sleep_disable_secondary_cpus();
+	if (error)
+		liuqin_ew_mark(EW_ERROR, 7, error);
+	else
+		liuqin_ew_mark(EW_CPUS_OFF, state, 0);
+	ew_skip = 8;
 	if (error || suspend_test(TEST_CPUS))
 		goto Enable_cpus;
 
 	arch_suspend_disable_irqs();
+	liuqin_ew_mark(EW_IRQS_OFF, state, 0);
 	BUG_ON(!irqs_disabled());
 
 	system_state = SYSTEM_SUSPEND;
 
+	ew_skip = 9;
 	error = syscore_suspend();
 	if (!error) {
+		liuqin_ew_mark(EW_SYSCORE_SUSPENDED, state, 0);
+		ew_skip = 10;
 		*wakeup = pm_wakeup_pending();
 		if (!(suspend_test(TEST_CORE) || *wakeup)) {
 			trace_suspend_resume(TPS("machine_suspend"),
 				state, true);
+			ew_entered = true;
+			liuqin_ew_mark(EW_ENTER_CALL, state, 0);
 			error = suspend_ops->enter(state);
+			liuqin_ew_mark(EW_ENTER_RETURN, state, error);
 			trace_suspend_resume(TPS("machine_suspend"),
 				state, false);
 		} else if (*wakeup) {
 			error = -EBUSY;
+		} else {
+			ew_skip = 11;
 		}
 		syscore_resume();
+		liuqin_ew_mark(EW_SYSCORE_RESUMED, state, 0);
 	}
 
 	system_state = SYSTEM_RUNNING;
 
+	liuqin_ew_mark(EW_IRQ_ENABLE_BEGIN, state, 0);
 	arch_suspend_enable_irqs();
+	liuqin_ew_mark(EW_IRQ_ENABLE_DONE, state, 0);
 	BUG_ON(irqs_disabled());
 
  Enable_cpus:
+	liuqin_ew_mark(EW_CPU_ON_BEGIN, state, 0);
 	pm_sleep_enable_secondary_cpus();
+	liuqin_ew_mark(EW_CPUS_ON, state, 0);
 
  Platform_wake:
+	liuqin_ew_mark(EW_RESUME_NOIRQ_BEGIN, state, 0);
 	platform_resume_noirq(state);
 	dpm_resume_noirq(PMSG_RESUME);
 
