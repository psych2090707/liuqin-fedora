# AFK channel (TN0048) — KRDP (RDP server) configuration.
#
# Read by krdpserver via KConfig (~/.config/krdpserverrc overrides this
# system-wide /etc/xdg file).  See the upstream CLI recipe in
# /usr/share/doc/krdp/README.md, which this mirrors:
#   * Certificate/CertificateKey: pre-generated by the installer (openssl is
#     installed from the offline repo) so the client can pin/ignore one stable
#     certificate instead of a fresh self-signed one on every start.
#   * SystemUserEnabled: authenticate RDP clients against the tablet's system
#     users (PAM), i.e. the existing dev user `user` / `147147`.  No extra
#     credential store, no KWallet unlock needed.
#
# Port stays at the default 3389.  krdpserver listens on 0.0.0.0 and the only
# interface that exists on this tablet is usb0 (no Wi-Fi firmware), so the
# listener is reachable only through the USB cable; docs/maintenance/afk-channel.md
# documents the optional nftables restriction as well.
[General]
Certificate=/home/user/.local/share/krdpserver/krdp.crt
CertificateKey=/home/user/.local/share/krdpserver/krdp.key
SystemUserEnabled=true
