# liuqin tablet defaults for the retained KDE profile.
# Screen off after 600 seconds on every power source. PowerDevil is the
# sole power-button owner: 128 toggles display, 64 turns the display off.
# Automatic suspend stays disabled until device suspend/resume is accepted.

[AC][Display]
TurnOffDisplayWhenIdle=true
TurnOffDisplayIdleTimeoutSec=600
TurnOffDisplayIdleTimeoutWhenLockedSec=600

[AC][SuspendAndShutdown]
PowerButtonAction=128
LidAction=64
AutoSuspendAction=0

[Battery][Display]
TurnOffDisplayWhenIdle=true
TurnOffDisplayIdleTimeoutSec=600
TurnOffDisplayIdleTimeoutWhenLockedSec=600

[Battery][SuspendAndShutdown]
PowerButtonAction=128
LidAction=64
AutoSuspendAction=0

[LowBattery][Display]
TurnOffDisplayWhenIdle=true
TurnOffDisplayIdleTimeoutSec=600
TurnOffDisplayIdleTimeoutWhenLockedSec=600

[LowBattery][SuspendAndShutdown]
PowerButtonAction=128
LidAction=64
AutoSuspendAction=0
