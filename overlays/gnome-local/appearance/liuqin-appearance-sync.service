[Unit]
Description=Make GNOME's light style an explicit desktop appearance preference
PartOf=graphical-session.target
After=graphical-session-pre.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/local/libexec/liuqin-appearance-sync
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
