# IMPORTANT — FIRST-BOOT PRESET TRAP
# Fedora's first boot runs `systemctl preset-all`.  99-default-disable.preset
# contains "disable *", so `systemctl enable` in the image is NOT enough by
# itself.  This unit stays enabled only because it is listed in
# /etc/systemd/system-preset/90-liuqin-power.preset.  If you rename or add a
# liuqin power service, update that preset.  See overlays/gnome-local/README.md.
[Unit]
Description=liuqin lid policy (blank/suspend on lid close, wake on open)
After=upower.service systemd-logind.service
Wants=upower.service

[Service]
# TN0097: the service runs as the desktop user so it may connect to the user
# session bus (D-Bus rejects a root EXTERNAL connection). The user is in the
# input group, which is needed for the non-exclusive input watch.
User=laplus
Group=laplus
SupplementaryGroups=input
Type=simple
ExecStart=/usr/local/libexec/liuqin-lid-policy
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
