/* SPDX-License-Identifier: MIT
 * The lid service runs as the desktop user outside the graphical session.
 * polkit therefore treats its suspend request as non-interactive and requires
 * authentication. Allow only the suspend action for this single-user device;
 * do not grant a general polkit bypass.
 */
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.login1.suspend" &&
        subject.user == "user") {
        return polkit.Result.YES;
    }
});
