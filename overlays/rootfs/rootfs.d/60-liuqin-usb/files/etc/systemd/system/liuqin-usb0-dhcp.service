[Unit]
Description=liuqin USB NCM DHCP server (192.168.7.10-19)
Documentation=file:/etc/liuqin/usb0-dnsmasq.conf
ConditionPathExists=/sys/class/net/usb0
After=network-pre.target liuqin-usb0-link.service
Wants=liuqin-usb0-link.service

[Service]
Type=simple
StateDirectory=liuqin-usb0
StateDirectoryMode=0755
ExecStartPre=/usr/bin/install -d -o dnsmasq -g dnsmasq -m 0755 /var/lib/liuqin-usb0
ExecStart=/usr/sbin/dnsmasq --conf-file=/etc/liuqin/usb0-dnsmasq.conf --keep-in-foreground
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=no
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/liuqin-usb0

[Install]
WantedBy=multi-user.target
