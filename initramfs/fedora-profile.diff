+# FEDORA (ADR-0004 D2): contract v2 is a topology contract.
+#
+# v1 hash-pinned project-owned files, including user-editable configuration
+# (/etc/hostname, locale, vconsole, fstab, selinux config, environment.d,
+# chrony, plasmalogin config, skel dotfiles) and the payload of the project's
+# device RPMs.  That turned a normal `dnf upgrade` or hostname change into a
+# rescue boot.  v2 keeps only what the boot really needs to be fail-closed:
+# the root role marker and the Fedora KDE user-space handoff (PID1, login
+# manager, Plasma session programs, kernel identity interface).  Content
+# hashes of those distribution files are deliberately NOT checked here.
+#
+# These helpers do lexical path resolution inside the target root (absolute
+# symlink targets are interpreted inside the root, not on the initramfs host).
+storage_fedora_normalize_path() { # <absolute path> -> normalized in-root path
+	sfnp_in=${1#/}
+	sfnp_out=
+	while [ -n "$sfnp_in" ]; do
+		sfnp_comp=${sfnp_in%%/*}
+		case $sfnp_in in
+		*/*) sfnp_in=${sfnp_in#*/} ;;
+		*) sfnp_in= ;;
+		esac
+		case $sfnp_comp in
+		''|.) continue ;;
+		..) sfnp_out=${sfnp_out%/*} ;;
+		*) sfnp_out=$sfnp_out/$sfnp_comp ;;
+		esac
+	done
+	[ -n "$sfnp_out" ] || sfnp_out=/
+	printf '%s' "$sfnp_out"
+}
+
+storage_fedora_resolve_path() { # <root> <absolute in-root path> -> resolved path
+	sfrp_root=$1
+	sfrp_path=$(storage_fedora_normalize_path "$2") || return 1
+	sfrp_hops=0
+	while [ "$sfrp_hops" -lt 16 ]; do
+		if [ -L "$sfrp_root$sfrp_path" ]; then
+			sfrp_target=$("$BB" readlink "$sfrp_root$sfrp_path" 2>/dev/null || true)
+			[ -n "$sfrp_target" ] || return 1
+			case $sfrp_target in
+			/*)
+				sfrp_path=$(storage_fedora_normalize_path "$sfrp_target") || return 1
+				;;
+			*)
+				sfrp_parent=${sfrp_path%/*}
+				sfrp_path=$(storage_fedora_normalize_path "$sfrp_parent/$sfrp_target") ||
+					return 1
+				;;
+			esac
+			sfrp_hops=$((sfrp_hops + 1))
+			continue
+		fi
+		[ -e "$sfrp_root$sfrp_path" ] || return 1
+		printf '%s' "$sfrp_path"
+		return 0
+	done
+	return 1
+}
+
+storage_fedora_owned_regular() { # <in-root path> -> 0 when regular + root-owned
+	[ -f "$storage_checked_root$1" ] && [ ! -L "$storage_checked_root$1" ] ||
+		return 1
+	[ "$("$BB" stat -c '%u %g' "$storage_checked_root$1" 2>/dev/null || true)" = "0 0" ] ||
+		return 1
+	return 0
+}
+
+storage_fedora_executable() { # <in-root path> -> 0 when regular+root-owned+exec bit
+	storage_fedora_owned_regular "$1" || return 1
+	sfe_mode=$("$BB" stat -c '%a' "$storage_checked_root$1" 2>/dev/null || true)
+	case $sfe_mode in ''|*[!0-7]*) return 1 ;; esac
+	[ "$((0$sfe_mode & 0111))" -ne 0 ]
+}
