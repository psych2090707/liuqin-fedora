+# The login manager may be enabled through the systemd display-manager alias
+# (Fedora KDE 44: /etc/systemd/system/display-manager.service -> plasmalogin) or
+# through a graphical/multi-user .wants symlink.  Both forms are accepted, but
+# either way the unit must resolve to an existing regular file (ADR-0004 D2-B).
+storage_fedora_login_manager_ok() {
+	sfdm_unit=$1
+	for sfdm_candidate in \
+		/etc/systemd/system/display-manager.service \
+		/etc/systemd/system/multi-user.target.wants/$sfdm_unit \
+		/etc/systemd/system/graphical.target.wants/$sfdm_unit; do
+		[ -L "$storage_checked_root$sfdm_candidate" ] || continue
+		sfdm_resolved=$(storage_fedora_resolve_path "$storage_checked_root" \
+			"$sfdm_candidate") || continue
+		[ "${sfdm_resolved##*/}" = "$sfdm_unit" ] || continue
+		[ -f "$storage_checked_root$sfdm_resolved" ] &&
+			[ ! -L "$storage_checked_root$sfdm_resolved" ] &&
+			[ "$("$BB" stat -c '%u %g' "$storage_checked_root$sfdm_resolved" \
+				2>/dev/null || true)" = "0 0" ] && return 0
+	done
+	return 1
+}
+
+# Optional migration envelope: both payloads remain complete v2 contracts. The
+# marker and contracts live in INITRAMFS, never in the writable root. Select by
+# one actual enabled manager, not by an arbitrary user setting or a missing-file
+# fallback. Legacy images without the marker retain the original KDE behavior.
+storage_fedora_select_contract() {
+	sfsc_dir=${storage_fedora_contract%/*}
+	sfsc_marker=$sfsc_dir/liuqin-fedora-desktop-transition
+	if [ ! -e "$sfsc_marker" ] && [ ! -L "$sfsc_marker" ]; then
+		return 0
+	fi
+	[ -f "$sfsc_marker" ] && [ ! -L "$sfsc_marker" ] &&
+		[ "$("$BB" cat "$sfsc_marker")" = gnome-v1 ] ||
+		storage_fedora_reject "invalid desktop transition marker" || return 1
+	for sfsc_contract in "$sfsc_dir/liuqin-fedora-root.contract" \
+		"$sfsc_dir/liuqin-fedora-root.gnome.contract"; do
+		[ -f "$sfsc_contract" ] && [ ! -L "$sfsc_contract" ] ||
+			storage_fedora_reject "transition contract missing: $sfsc_contract" || return 1
+	done
+	sfsc_alias=/etc/systemd/system/display-manager.service
+	if [ -e "$storage_checked_root$sfsc_alias" ] ||
+		[ -L "$storage_checked_root$sfsc_alias" ]; then
+		[ -L "$storage_checked_root$sfsc_alias" ] || return 1
+		sfsc_resolved=$(storage_fedora_resolve_path "$storage_checked_root" "$sfsc_alias") || return 1
+		case ${sfsc_resolved##*/} in
+		gdm.service|plasmalogin.service) ;;
+		*) storage_fedora_reject "unreviewed display-manager alias"; return 1 ;;
+		esac
+	fi
+	sfsc_kde=0
+	sfsc_gnome=0
+	storage_fedora_login_manager_ok plasmalogin.service && sfsc_kde=1
+	storage_fedora_login_manager_ok gdm.service && sfsc_gnome=1
+	case $sfsc_kde:$sfsc_gnome in
+	1:0) storage_fedora_contract=$sfsc_dir/liuqin-fedora-root.contract ;;
+	0:1) storage_fedora_contract=$sfsc_dir/liuqin-fedora-root.gnome.contract ;;
+	*) storage_fedora_reject "transition requires exactly one enabled login manager"; return 1 ;;
+	esac
+	log "Fedora desktop admission: $storage_fedora_contract"
+}
+
+# Fedora profile (project fork, see the FEDORA FORK NOTICE at the top):
+# the persistent root is a Fedora KDE ARM64 filesystem living directly on
+# LIUQIN_ROOT.  The contract is topology-only (v2); hash pinning of RPM-owned
+# or user-editable files was removed on purpose (ADR-0004 D2).
+storage_fedora_root_ok() {
+	storage_checked_root=$1
+	storage_fedora_select_contract || return 1
+	[ -f "$storage_fedora_contract" ] && [ ! -L "$storage_fedora_contract" ] ||
+		storage_fedora_reject "contract missing from the initramfs" || return 1
+	storage_fedora_contract_size=$("$BB" stat -c '%s' "$storage_fedora_contract" 2>/dev/null || true)
+	case $storage_fedora_contract_size in ''|*[!0-9]*) return 1 ;; esac
+	[ "$storage_fedora_contract_size" -ge 256 ] &&
+		[ "$storage_fedora_contract_size" -le 16384 ] || return 1
+	storage_fedora_lines=0
+	storage_fedora_entries=0
+	storage_fedora_header_seen=false
+	storage_fedora_marker_seen=false
+	storage_fedora_display_manager_seen=false
+	storage_fedora_kernel_release=
+	while IFS= read -r storage_fedora_line; do
+		storage_fedora_lines=$((storage_fedora_lines + 1))
+		case $storage_fedora_line in
+		''|'#'*) continue ;;
+		esac
+		if [ "$storage_fedora_header_seen" = false ]; then
+			[ "$storage_fedora_line" = LIUQIN_FEDORA_ROOT_CONTRACT_V2 ] ||
+				storage_fedora_reject \
+					"contract header is not LIUQIN_FEDORA_ROOT_CONTRACT_V2" || return 1
+			storage_fedora_header_seen=true
+			continue
+		fi
+		set -f
+		# shellcheck disable=SC2086
+		set -- $storage_fedora_line
+		set +f
+		storage_fedora_kind=$1
+		storage_fedora_entries=$((storage_fedora_entries + 1))
+		case $storage_fedora_kind in
+		marker)
+			[ "$#" = 4 ] || storage_fedora_reject "malformed marker entry" || return 1
+			[ "$2" = /etc/liuqin-fedora-root ] ||
+				storage_fedora_reject "marker path is not /etc/liuqin-fedora-root" || return 1
+			storage_fedora_file=$storage_checked_root$2
+			[ -f "$storage_fedora_file" ] && [ ! -L "$storage_fedora_file" ] ||
+				storage_fedora_reject "marker missing or a symlink" || return 1
+			storage_fedora_marker_mode=${3#0}
+			[ "$("$BB" stat -c '%a %u %g' "$storage_fedora_file" 2>/dev/null || true)" = \
+				"$storage_fedora_marker_mode 0 0" ] ||
+				storage_fedora_reject "marker metadata is not $3 0 0" || return 1
+			[ "$("$BB" sha256sum "$storage_fedora_file" | "$BB" cut -d' ' -f1)" = "$4" ] ||
+				storage_fedora_reject "marker content mismatch" || return 1
+			storage_fedora_marker_seen=true
+			;;
+		file)
+			[ "$#" = 2 ] || storage_fedora_reject "malformed file entry" || return 1
+			storage_fedora_owned_regular "$2" ||
+				storage_fedora_reject "not a root-owned regular file: $2" || return 1
+			case $2 in
+			/usr/share/liuqin/kernel.release)
+				storage_fedora_kernel_release=$2
+				;;
+			esac
+			;;
+		exec)
+			[ "$#" = 2 ] || storage_fedora_reject "malformed exec entry" || return 1
+			storage_fedora_executable "$2" ||
+				storage_fedora_reject "not an executable root-owned regular file: $2" || return 1
+			;;
+		resolve)
+			[ "$#" = 3 ] || storage_fedora_reject "malformed resolve entry" || return 1
+			storage_fedora_resolved=$(storage_fedora_resolve_path \
+				"$storage_checked_root" "$2") ||
+				storage_fedora_reject "unresolvable symlink: $2" || return 1
+			[ "${storage_fedora_resolved##*/}" = "$3" ] ||
+				storage_fedora_reject "$2 resolves to $storage_fedora_resolved" || return 1
+			storage_fedora_owned_regular "$storage_fedora_resolved" ||
+				storage_fedora_reject "$2 resolves to a non-root-owned file" || return 1
+			;;
+		display-manager)
+			[ "$#" = 2 ] || storage_fedora_reject "malformed display-manager entry" || return 1
+			storage_fedora_login_manager_ok "$2" ||
+				storage_fedora_reject "login manager $2 does not resolve to an existing unit" ||
+				return 1
+			storage_fedora_display_manager_seen=true
+			;;
+		*)
+			storage_fedora_reject "unknown contract entry: $storage_fedora_kind" || return 1
+			;;
+		esac
+	done <"$storage_fedora_contract"
+	[ "$storage_fedora_header_seen" = true ] || return 1
+	[ "$storage_fedora_marker_seen" = true ] || return 1
+	[ "$storage_fedora_display_manager_seen" = true ] || return 1
+	[ "$storage_fedora_lines" -ge 8 ] && [ "$storage_fedora_lines" -le 128 ] || return 1
+	[ "$storage_fedora_entries" -ge 8 ] || return 1
+	# Kernel identity interface (warn-only, see the fork notice): the modules
+	# tree for the identity the rootfs reports should exist, but being one
+	# update behind must not send the tablet to recovery (ADR-0004 D2-B/D5).
+	storage_fedora_root_release=$("$BB" cat \
+		"$storage_checked_root$storage_fedora_kernel_release" 2>/dev/null || true)
+	storage_fedora_running_release=$("$BB" cat /proc/sys/kernel/osrelease 2>/dev/null || true)
+	if [ -z "$storage_fedora_running_release" ] ||
+		[ "$storage_fedora_running_release" != "$storage_fedora_root_release" ]; then
+		log "warning: kernel.release ($storage_fedora_root_release) does not match the running kernel ($storage_fedora_running_release); boot image and rootfs may be one update apart"
+	else
+		log "kernel identity matches the running kernel: $storage_fedora_running_release"
+	fi
+	[ -z "$storage_fedora_root_release" ] ||
+		[ -d "$storage_checked_root/usr/lib/modules/$storage_fedora_root_release" ] ||
+		log "warning: /usr/lib/modules/$storage_fedora_root_release is missing in the rootfs (boot image may be newer than the module tree)"
+	"$BB" chroot "$storage_checked_root" /usr/lib/systemd/systemd --version >/dev/null 2>&1 ||
+		storage_fedora_reject "systemd will not execute under chroot" || return 1
+	return 0
+}
