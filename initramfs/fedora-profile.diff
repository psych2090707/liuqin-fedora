+# FEDORA: only an early-exit readiness hint, never a storage admission gate.
+# liuqin exposes six UFS LUNs. Wait for all of them and the essential partition
+# names, then require a stable canonical node inventory on consecutive scans.
+# Unexpected layouts retain the original ten-second polling path. All RO,
+# identity, root contract and pre/post-RW snapshot checks below remain intact.
+storage_boot_nodes_ready() {
+	for storage_ready_lun in sda sdb sdc sdd sde sdf; do
+		storage_path_is_block "$storage_dev_root/$storage_ready_lun" || return 1
+	done
+	storage_ready_names=
+	for storage_ready_event in "$storage_sys_block"/sd*/uevent; do
+		storage_ready_name=$(storage_uevent_value PARTNAME "$storage_ready_event" 2>/dev/null || true)
+		case $storage_ready_name in
+		boot_a|boot_b|persist|linux_root|userdata)
+			storage_ready_names="$storage_ready_names $storage_ready_name" ;;
+		esac
+	done
+	for storage_ready_required in boot_a boot_b persist; do
+		case " $storage_ready_names " in
+		*" $storage_ready_required "*) ;;
+		*) return 1 ;;
+		esac
+	done
+	case " $storage_ready_names " in
+	*' linux_root '*|*' userdata '*) return 0 ;;
+	esac
+	return 1
+}
